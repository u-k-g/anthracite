+void SidebarController::updatePlan(const QString& explanation, const QVariantList& steps)
+{
+    QStringList lines;
+    if (!explanation.trimmed().isEmpty()) {
+        lines.append(explanation.trimmed());
+        lines.append(QString());
+    }
+    for (const auto& value : steps) {
+        const QVariantMap step = value.toMap();
+        const QString status = step.value(QStringLiteral("status")).toString();
+        const QString marker = status == QLatin1String("completed") ? QStringLiteral("●")
+            : status == QLatin1String("inProgress")                 ? QStringLiteral("◐")
+                                                                    : QStringLiteral("○");
+        lines.append(
+            QStringLiteral("%1 %2").arg(marker, step.value(QStringLiteral("step")).toString())
+        );
+    }
+    conversation.upsertPlan(lines.join(QLatin1Char('\n')));
+}
