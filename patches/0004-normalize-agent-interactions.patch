+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+use serde_json::{Value, json};
+use std::io::{self, Write};
+
+pub const VERSION: u64 = 1;
+
+pub fn message_type(message: &Value) -> &str {
+    message.get("type").and_then(Value::as_str).unwrap_or("")
+}
+
+pub fn payload(message: &Value) -> &Value {
+    message.get("payload").unwrap_or(&Value::Null)
+}
+
+pub fn emit(message_type: &str, payload: Value) {
+    let stdout = io::stdout();
+    let mut output = stdout.lock();
+    let value = json!({
+        "protocolVersion": VERSION,
+        "type": message_type,
+        "payload": payload
+    });
+    if serde_json::to_writer(&mut output, &value).is_ok() {
+        let _ = output.write_all(b"\n");
+        let _ = output.flush();
+    }
+}
+
+pub fn emit_error(message: impl Into<String>) {
+    emit(
+        "runtime.error",
+        json!({"class": "provider_error", "message": message.into()}),
+    );
+}
+
+pub fn emit_warning(message: impl Into<String>) {
+    emit("runtime.warning", json!({"message": message.into()}));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reads_versioned_host_messages() {
+        let message = json!({
+            "protocolVersion": VERSION,
+            "type": "turn.start",
+            "payload": {"prompt": "Make a box"}
+        });
+        assert_eq!(message_type(&message), "turn.start");
+        assert_eq!(
+            payload(&message).get("prompt").and_then(Value::as_str),
+            Some("Make a box")
+        );
+    }
+}
