+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+use super::ProviderAdapter;
+use crate::process::{IoEvent, LineProcess};
+use crate::protocol;
+use serde_json::{Map, Value, json};
+use std::collections::HashMap;
+use std::sync::mpsc;
+
+const INITIALIZE_ID: u64 = 1;
+const THREAD_START_ID: u64 = 2;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum PendingKind {
+    CommandApproval,
+    FileChangeApproval,
+    PermissionApproval,
+    UserInput,
+}
+
+struct PendingRequest {
+    server_id: Value,
+    kind: PendingKind,
+    params: Value,
+}
+
+pub struct CodexAdapter {
+    process: LineProcess,
+    cwd: String,
+    next_request_id: u64,
+    next_interaction_id: u64,
+    thread_id: Option<String>,
+    turn_id: Option<String>,
+    pending: HashMap<String, PendingRequest>,
+}
+
+impl CodexAdapter {
+    pub fn start(binary: &str, cwd: &str, sender: &mpsc::Sender<IoEvent>) -> Result<Self, String> {
+        let process = LineProcess::start(binary, &["app-server"], cwd, sender)?;
+        let adapter = Self {
+            process,
+            cwd: cwd.to_owned(),
+            next_request_id: 3,
+            next_interaction_id: 1,
+            thread_id: None,
+            turn_id: None,
+            pending: HashMap::new(),
+        };
+        adapter.process.send(&json!({
+            "id": INITIALIZE_ID,
+            "method": "initialize",
+            "params": {
+                "clientInfo": {
+                    "name": "anthracite_freecad",
+                    "title": "Anthracite for FreeCAD",
+                    "version": env!("CARGO_PKG_VERSION")
+                },
+                "capabilities": {
+                    "experimentalApi": true
+                }
+            }
+        }))?;
+        Ok(adapter)
+    }
+
+    fn send(&self, value: &Value) -> Result<(), String> {
+        self.process.send(value)
+    }
+
+    fn request(&mut self, method: &str, params: Value) -> Result<u64, String> {
+        let id = self.next_request_id;
+        self.next_request_id += 1;
+        self.send(&json!({"id": id, "method": method, "params": params}))?;
+        Ok(id)
+    }
+
+    fn start_thread(&self) -> Result<(), String> {
+        self.send(&json!({
+            "id": THREAD_START_ID,
+            "method": "thread/start",
+            "params": {
+                "cwd": self.cwd,
+                "serviceName": "anthracite_freecad",
+                "developerInstructions": concat!(
+                    "You are operating inside FreeCAD through Anthracite. ",
+                    "Use the freecad tool for CAD inspection and every CAD mutation. ",
+                    "The tool accepts ordinary FreeCAD Python with App, Gui, doc, and cad available. ",
+                    "Prefer parametric, named objects and constraints. Inspect before editing. ",
+                    "A tool call is one undoable transaction: failures roll back automatically. ",
+                    "Read the returned observation, fix errors, and verify the finished model."
+                ),
+                "dynamicTools": [{
+                    "type": "function",
+                    "name": "freecad",
+                    "description": concat!(
+                        "Execute ordinary Python inside the active FreeCAD GUI. ",
+                        "App/FreeCAD, Gui, doc, and a small cad inspection helper are prebound. ",
+                        "The complete source runs as one transaction, recomputes and validates, ",
+                        "then returns result/stdout plus created, changed, and deleted objects."
+                    ),
+                    "inputSchema": {
+                        "type": "object",
+                        "properties": {
+                            "code": {
+                                "type": "string",
+                                "description": "Complete ordinary FreeCAD Python source."
+                            }
+                        },
+                        "required": ["code"],
+                        "additionalProperties": false
+                    }
+                }]
+            }
+        }))
+    }
+
+    fn response_id(message: &Value) -> Option<u64> {
+        message.get("id").and_then(Value::as_u64)
+    }
+
+    fn next_pending_id(&mut self) -> String {
+        let result = format!("codex-request-{}", self.next_interaction_id);
+        self.next_interaction_id += 1;
+        result
+    }
+
+    fn open_approval(&mut self, server_id: Value, kind: PendingKind, params: Value) {
+        let request_id = self.next_pending_id();
+        let (request_kind, title, detail, allow_session) = match kind {
+            PendingKind::CommandApproval => (
+                "command_execution_approval",
+                "Run command",
+                params
+                    .get("command")
+                    .or_else(|| params.get("reason"))
+                    .and_then(Value::as_str)
+                    .unwrap_or("Codex requested permission to run a command."),
+                true,
+            ),
+            PendingKind::FileChangeApproval => (
+                "file_change_approval",
+                "Change files",
+                params
+                    .get("reason")
+                    .and_then(Value::as_str)
+                    .unwrap_or("Codex requested permission to change files."),
+                true,
+            ),
+            PendingKind::PermissionApproval => (
+                "permission_approval",
+                "Grant additional access",
+                params
+                    .get("reason")
+                    .and_then(Value::as_str)
+                    .unwrap_or("Codex requested additional permissions."),
+                true,
+            ),
+            PendingKind::UserInput => unreachable!(),
+        };
+
+        protocol::emit(
+            "request.opened",
+            json!({
+                "requestId": request_id,
+                "requestKind": request_kind,
+                "title": title,
+                "detail": detail,
+                "allowSession": allow_session,
+                "providerArgs": params
+            }),
+        );
+        self.pending.insert(
+            request_id,
+            PendingRequest {
+                server_id,
+                kind,
+                params,
+            },
+        );
+    }
+
+    fn open_user_input(&mut self, server_id: Value, params: Value) {
+        let request_id = self.next_pending_id();
+        protocol::emit(
+            "user_input.requested",
+            json!({
+                "requestId": request_id,
+                "questions": params.get("questions").cloned().unwrap_or_else(|| json!([])),
+                "autoResolutionMs": params.get("autoResolutionMs").cloned().unwrap_or(Value::Null)
+            }),
+        );
+        self.pending.insert(
+            request_id,
+            PendingRequest {
+                server_id,
+                kind: PendingKind::UserInput,
+                params,
+            },
+        );
+    }
+
+    fn handle_server_request(&mut self, message: &Value) -> Result<(), String> {
+        let method = message.get("method").and_then(Value::as_str).unwrap_or("");
+        let server_id = message.get("id").cloned().unwrap_or(Value::Null);
+        let params = message.get("params").cloned().unwrap_or_else(|| json!({}));
+        match method {
+            "item/tool/call" => {
+                let tool = params.get("tool").and_then(Value::as_str).unwrap_or("");
+                let code = params
+                    .pointer("/arguments/code")
+                    .and_then(Value::as_str)
+                    .unwrap_or("");
+                if tool != "freecad" || code.is_empty() {
+                    self.send(&json!({
+                        "id": server_id,
+                        "result": {
+                            "contentItems": [{
+                                "type": "inputText",
+                                "text": "The FreeCAD tool requires a non-empty code string."
+                            }],
+                            "success": false
+                        }
+                    }))?;
+                    return Ok(());
+                }
+                protocol::emit(
+                    "tool.call",
+                    json!({
+                        "requestId": server_id,
+                        "tool": "freecad",
+                        "arguments": {"code": code}
+                    }),
+                );
+            }
+            "item/commandExecution/requestApproval" => {
+                self.open_approval(server_id, PendingKind::CommandApproval, params);
+            }
+            "item/fileChange/requestApproval" => {
+                self.open_approval(server_id, PendingKind::FileChangeApproval, params);
+            }
+            "item/permissions/requestApproval" => {
+                self.open_approval(server_id, PendingKind::PermissionApproval, params);
+            }
+            "item/tool/requestUserInput" => {
+                self.open_user_input(server_id, params);
+            }
+            _ => {
+                self.send(&json!({
+                    "id": server_id,
+                    "error": {
+                        "code": -32601,
+                        "message": format!("Anthracite does not handle server request {method}.")
+                    }
+                }))?;
+                protocol::emit_warning(format!(
+                    "Provider requested unsupported interaction: {method}"
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    fn item_description(item: &Value) -> Option<(&'static str, String, Option<String>)> {
+        match item.get("type").and_then(Value::as_str) {
+            Some("dynamicToolCall") => Some((
+                "dynamic_tool_call",
+                format!(
+                    "Calling {}",
+                    item.get("tool").and_then(Value::as_str).unwrap_or("tool")
+                ),
+                None,
+            )),
+            Some("commandExecution") => Some((
+                "command_execution",
+                "Running command".to_string(),
+                item.get("command")
+                    .and_then(Value::as_str)
+                    .map(str::to_owned),
+            )),
+            Some("fileChange") => Some((
+                "file_change",
+                "Changing files".to_string(),
+                item.get("path").and_then(Value::as_str).map(str::to_owned),
+            )),
+            Some("mcpToolCall") => Some((
+                "mcp_tool_call",
+                format!(
+                    "Calling {}",
+                    item.get("tool")
+                        .and_then(Value::as_str)
+                        .unwrap_or("MCP tool")
+                ),
+                item.get("server")
+                    .and_then(Value::as_str)
+                    .map(str::to_owned),
+            )),
+            _ => None,
+        }
+    }
+
+    fn handle_notification(&mut self, message: &Value) {
+        let method = message.get("method").and_then(Value::as_str).unwrap_or("");
+        let params = message.get("params").unwrap_or(&Value::Null);
+        match method {
+            "turn/started" => {
+                self.turn_id = params
+                    .pointer("/turn/id")
+                    .and_then(Value::as_str)
+                    .map(str::to_owned);
+                protocol::emit(
+                    "turn.started",
+                    json!({"turnId": self.turn_id, "provider": "codex"}),
+                );
+            }
+            "item/agentMessage/delta" => {
+                if let Some(delta) = params.get("delta").and_then(Value::as_str) {
+                    protocol::emit(
+                        "content.delta",
+                        json!({"streamKind": "assistant_text", "text": delta}),
+                    );
+                }
+            }
+            "item/started" | "item/completed" => {
+                let item = params.get("item").unwrap_or(&Value::Null);
+                if let Some((kind, title, detail)) = Self::item_description(item) {
+                    protocol::emit(
+                        if method == "item/started" {
+                            "item.started"
+                        } else {
+                            "item.completed"
+                        },
+                        json!({
+                            "itemId": item.get("id"),
+                            "kind": kind,
+                            "title": title,
+                            "detail": detail
+                        }),
+                    );
+                }
+            }
+            "turn/plan/updated" => {
+                protocol::emit(
+                    "plan.updated",
+                    json!({
+                        "explanation": params.get("explanation"),
+                        "steps": params.get("plan").cloned().unwrap_or_else(|| json!([]))
+                    }),
+                );
+            }
+            "thread/tokenUsage/updated" => {
+                protocol::emit(
+                    "usage.updated",
+                    params
+                        .get("tokenUsage")
+                        .cloned()
+                        .unwrap_or_else(|| json!({})),
+                );
+            }
+            "turn/completed" => {
+                let status = params
+                    .pointer("/turn/status")
+                    .and_then(Value::as_str)
+                    .unwrap_or("completed");
+                let error = params
+                    .pointer("/turn/error/message")
+                    .and_then(Value::as_str);
+                self.turn_id = None;
+                protocol::emit("turn.completed", json!({"status": status, "error": error}));
+            }
+            "error" => {
+                let text = params
+                    .pointer("/error/message")
+                    .or_else(|| params.get("message"))
+                    .and_then(Value::as_str)
+                    .unwrap_or("Codex reported an unknown error.");
+                protocol::emit_error(text);
+            }
+            _ => {}
+        }
+    }
+
+    fn handle_response(&mut self, message: &Value) -> Result<(), String> {
+        if let Some(error) = message.pointer("/error/message").and_then(Value::as_str) {
+            return Err(format!("Codex protocol error: {error}"));
+        }
+        match Self::response_id(message) {
+            Some(INITIALIZE_ID) => {
+                self.send(&json!({"method": "initialized"}))?;
+                self.start_thread()?;
+            }
+            Some(THREAD_START_ID) => {
+                self.thread_id = message
+                    .pointer("/result/thread/id")
+                    .and_then(Value::as_str)
+                    .map(str::to_owned);
+                if let Some(thread_id) = &self.thread_id {
+                    protocol::emit(
+                        "runtime.ready",
+                        json!({
+                            "provider": "codex",
+                            "threadId": thread_id,
+                            "capabilities": {
+                                "approvals": true,
+                                "userInput": true,
+                                "plans": true,
+                                "usage": true,
+                                "modelOverrides": false
+                            }
+                        }),
+                    );
+                } else {
+                    return Err(
+                        "Codex thread/start response did not include a thread id.".to_string()
+                    );
+                }
+            }
+            Some(_) => {
+                if let Some(turn_id) = message
+                    .pointer("/result/turn/id")
+                    .and_then(Value::as_str)
+                    .map(str::to_owned)
+                {
+                    self.turn_id = Some(turn_id);
+                }
+            }
+            None => return Err("Codex returned an unrecognized protocol message.".to_string()),
+        }
+        Ok(())
+    }
+
+    fn codex_decision(decision: &str) -> Result<&'static str, String> {
+        match decision {
+            "approve" => Ok("accept"),
+            "approve_session" => Ok("acceptForSession"),
+            "decline" => Ok("decline"),
+            "cancel" => Ok("cancel"),
+            _ => Err(format!("Unknown approval decision: {decision}")),
+        }
+    }
+
+    fn approval_result(pending: &PendingRequest, decision: &str) -> Result<Value, String> {
+        match pending.kind {
+            PendingKind::CommandApproval | PendingKind::FileChangeApproval => {
+                Ok(json!({"decision": Self::codex_decision(decision)?}))
+            }
+            PendingKind::PermissionApproval => {
+                let permissions = if matches!(decision, "approve" | "approve_session") {
+                    pending
+                        .params
+                        .get("permissions")
+                        .cloned()
+                        .unwrap_or_else(|| json!({}))
+                } else {
+                    json!({})
+                };
+                Ok(json!({
+                    "permissions": permissions,
+                    "scope": if decision == "approve_session" { "session" } else { "turn" }
+                }))
+            }
+            PendingKind::UserInput => {
+                Err("The pending interaction requires user-input answers.".to_string())
+            }
+        }
+    }
+
+    fn user_input_response(answers: &Value) -> Value {
+        let mut result = Map::new();
+        if let Some(values) = answers.as_object() {
+            for (question_id, answer) in values {
+                let answers = match answer {
+                    Value::Array(items) => items.clone(),
+                    Value::String(text) => vec![Value::String(text.clone())],
+                    _ => vec![Value::String(answer.to_string())],
+                };
+                result.insert(question_id.clone(), json!({"answers": answers}));
+            }
+        }
+        Value::Object(result)
+    }
+}
+
+impl ProviderAdapter for CodexAdapter {
+    fn start_turn(&mut self, prompt: &str) -> Result<(), String> {
+        let thread_id = self
+            .thread_id
+            .clone()
+            .ok_or_else(|| "Codex thread is not ready.".to_string())?;
+        self.request(
+            "turn/start",
+            json!({
+                "threadId": thread_id,
+                "input": [{
+                    "type": "text",
+                    "text": prompt,
+                    "textElements": []
+                }]
+            }),
+        )?;
+        protocol::emit("session.state", json!({"state": "running"}));
+        Ok(())
+    }
+
+    fn return_tool_result(
+        &mut self,
+        request_id: Value,
+        result: &str,
+        success: bool,
+    ) -> Result<(), String> {
+        self.send(&json!({
+            "id": request_id,
+            "result": {
+                "contentItems": [{"type": "inputText", "text": result}],
+                "success": success
+            }
+        }))
+    }
+
+    fn resolve_request(&mut self, request_id: &str, decision: &str) -> Result<(), String> {
+        let pending = self
+            .pending
+            .remove(request_id)
+            .ok_or_else(|| format!("Unknown pending provider request: {request_id}"))?;
+        let result = match Self::approval_result(&pending, decision) {
+            Ok(result) => result,
+            Err(error) => {
+                self.pending.insert(request_id.to_owned(), pending);
+                return Err(error);
+            }
+        };
+        self.send(&json!({"id": pending.server_id, "result": result}))?;
+        protocol::emit(
+            "request.resolved",
+            json!({"requestId": request_id, "decision": decision}),
+        );
+        Ok(())
+    }
+
+    fn resolve_user_input(&mut self, request_id: &str, answers: &Value) -> Result<(), String> {
+        let pending = self
+            .pending
+            .remove(request_id)
+            .ok_or_else(|| format!("Unknown pending user-input request: {request_id}"))?;
+        if pending.kind != PendingKind::UserInput {
+            self.pending.insert(request_id.to_owned(), pending);
+            return Err("The pending interaction is an approval request.".to_string());
+        }
+        let provider_answers = Self::user_input_response(answers);
+        self.send(&json!({
+            "id": pending.server_id,
+            "result": {"answers": provider_answers}
+        }))?;
+        protocol::emit(
+            "user_input.resolved",
+            json!({"requestId": request_id, "answers": answers}),
+        );
+        Ok(())
+    }
+
+    fn interrupt(&mut self) -> Result<(), String> {
+        if let (Some(thread_id), Some(turn_id)) = (self.thread_id.clone(), self.turn_id.clone()) {
+            self.request(
+                "turn/interrupt",
+                json!({"threadId": thread_id, "turnId": turn_id}),
+            )?;
+        }
+        Ok(())
+    }
+
+    fn handle_message(&mut self, message: Value) -> Result<(), String> {
+        if message.get("method").is_some() && message.get("id").is_some() {
+            return self.handle_server_request(&message);
+        }
+        if message.get("method").is_some() {
+            self.handle_notification(&message);
+            return Ok(());
+        }
+        self.handle_response(&message)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn normalizes_user_input_answers() {
+        assert_eq!(
+            CodexAdapter::user_input_response(&json!({
+                "target": "Part Design",
+                "features": ["Pocket", "Fillet"]
+            })),
+            json!({
+                "target": {"answers": ["Part Design"]},
+                "features": {"answers": ["Pocket", "Fillet"]}
+            })
+        );
+    }
+
+    #[test]
+    fn maps_generic_approval_decisions() {
+        assert_eq!(CodexAdapter::codex_decision("approve").unwrap(), "accept");
+        assert_eq!(
+            CodexAdapter::codex_decision("approve_session").unwrap(),
+            "acceptForSession"
+        );
+        assert_eq!(CodexAdapter::codex_decision("decline").unwrap(), "decline");
+        assert!(CodexAdapter::codex_decision("always").is_err());
+    }
+
+    #[test]
+    fn classifies_codex_activity_without_leaking_provider_shapes() {
+        assert_eq!(
+            CodexAdapter::item_description(&json!({
+                "type": "commandExecution",
+                "command": "git status"
+            })),
+            Some((
+                "command_execution",
+                "Running command".to_string(),
+                Some("git status".to_string())
+            ))
+        );
+    }
+
+    #[test]
+    fn builds_provider_specific_approval_responses_behind_the_adapter() {
+        let command = PendingRequest {
+            server_id: json!(12),
+            kind: PendingKind::CommandApproval,
+            params: json!({}),
+        };
+        assert_eq!(
+            CodexAdapter::approval_result(&command, "approve_session").unwrap(),
+            json!({"decision": "acceptForSession"})
+        );
+
+        let permissions = PendingRequest {
+            server_id: json!(13),
+            kind: PendingKind::PermissionApproval,
+            params: json!({
+                "permissions": {"network": {"enabled": true}}
+            }),
+        };
+        assert_eq!(
+            CodexAdapter::approval_result(&permissions, "approve").unwrap(),
+            json!({
+                "permissions": {"network": {"enabled": true}},
+                "scope": "turn"
+            })
+        );
+        assert_eq!(
+            CodexAdapter::approval_result(&permissions, "decline").unwrap(),
+            json!({"permissions": {}, "scope": "turn"})
+        );
+    }
+}
