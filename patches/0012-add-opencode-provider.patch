+              QStringLiteral("/opt/homebrew/bin/codex"),
+              QStringLiteral("/usr/local/bin/codex"),
+          };
+    for (const QString& candidate : candidates) {
+        if (QFileInfo(candidate).isExecutable()) {
+            return candidate;
+        }
+    }
+
