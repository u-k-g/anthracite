+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn normalizes_only_connected_opencode_models() {
+        let models = normalize_models(&json!({
+            "connected": ["openai"],
+            "default": {"openai": "gpt-5"},
+            "all": [
+                {
+                    "id": "openai",
+                    "name": "OpenAI",
+                    "models": {
+                        "gpt-5": {
+                            "name": "GPT-5",
+                            "family": "gpt",
+                            "variants": {"high": {}}
+                        }
+                    }
+                },
+                {
+                    "id": "other",
+                    "name": "Other",
+                    "models": {"hidden": {"name": "Hidden"}}
+                }
+            ]
+        }));
+        assert_eq!(models.len(), 2);
+        assert_eq!(models[0]["model"], "");
+        assert_eq!(models[0]["isDefault"], true);
+        assert_eq!(models[1]["model"], "openai/gpt-5");
+        assert_eq!(models[1]["isDefault"], false);
+        assert_eq!(models[1]["efforts"][0]["id"], "high");
+    }
+
