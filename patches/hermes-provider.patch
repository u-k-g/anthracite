+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn maps_permission_decisions_onto_acp_options() {
+        let options = vec![
+            json!({"optionId": "allow_once", "kind": "allow_once", "name": "Allow once"}),
+            json!({"optionId": "allow_session", "kind": "allow_always", "name": "Allow for session"}),
+            json!({"optionId": "deny", "kind": "reject_once", "name": "Deny"}),
+        ];
+        assert_eq!(
+            HermesAdapter::option_id_for("approve", &options).unwrap(),
+            Some("allow_once".to_owned())
+        );
+        assert_eq!(
+            HermesAdapter::option_id_for("approve_session", &options).unwrap(),
+            Some("allow_session".to_owned())
+        );
+        assert_eq!(
+            HermesAdapter::option_id_for("decline", &options).unwrap(),
+            Some("deny".to_owned())
+        );
+        assert_eq!(
+            HermesAdapter::option_id_for("cancel", &options).unwrap(),
+            None
+        );
+    }
+
+    #[test]
+    fn normalizes_hermes_model_catalog() {
+        let adapter_json = json!({
+            "availableModels": [
+                {"modelId": "openrouter:x-ai/grok-4.6", "name": "Grok 4.6", "description": "Default"}
+            ],
+            "currentModelId": "openrouter:x-ai/grok-4.6"
+        });
+        let slug = adapter_json["availableModels"][0]["modelId"]
+            .as_str()
+            .unwrap();
+        assert_eq!(slug, "openrouter:x-ai/grok-4.6");
+        assert_eq!(adapter_json["currentModelId"], "openrouter:x-ai/grok-4.6");
+    }
+}
