+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+use super::ProviderAdapter;
+use crate::process::{ChildProcess, IoEvent, McpBridge};
+use crate::protocol::Emitter;
+use crate::store::Store;
+use base64::{Engine as _, engine::general_purpose::STANDARD};
+use serde_json::{Value, json};
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader};
+use std::net::TcpListener;
+use std::sync::mpsc;
+use std::thread;
+use std::time::{Duration, Instant};
+
+struct PendingTool {
+    jsonrpc_id: Value,
+    response: mpsc::Sender<Value>,
+}
+
+pub struct OpenCodeAdapter {
+    _process: ChildProcess,
+    base_url: String,
+    server_password: String,
+    session_id: String,
+    active_turn: bool,
+    next_tool_id: u64,
+    pending_tools: HashMap<String, PendingTool>,
+    pending_questions: HashMap<String, Vec<String>>,
+    message_roles: HashMap<String, String>,
+    part_kinds: HashMap<String, String>,
+    emitted_text: HashMap<String, String>,
+    emitter: Emitter,
+}
+
+impl OpenCodeAdapter {
+    pub fn start(
+        binary: &str,
+        cwd: &str,
+        sender: &mpsc::Sender<IoEvent>,
+        store: Store,
+    ) -> Result<Self, String> {
+        let port = available_port()?;
+        let port_text = port.to_string();
+        let server_password = uuid::Uuid::new_v4().to_string();
+        let process = ChildProcess::start(
+            binary,
+            &["serve", "--hostname", "127.0.0.1", "--port", &port_text],
+            cwd,
+            &[("OPENCODE_SERVER_PASSWORD", server_password.as_str())],
+            sender,
+        )?;
+        let base_url = format!("http://127.0.0.1:{port}");
+        wait_until_ready(&base_url, &server_password)?;
+
+        let bridge = McpBridge::start(sender)?;
+        let executable = std::env::current_exe()
+            .map_err(|error| format!("Could not locate the Anthracite runtime: {error}"))?;
+        let mut command = vec![executable.to_string_lossy().to_string()];
+        command.extend(bridge.proxy_arguments());
+        post_json(
+            &base_url,
+            "/mcp",
+            &json!({
+                "name": "anthracite",
+                "config": {
+                    "type": "local",
+                    "command": command,
+                    "cwd": cwd,
+                    "enabled": true,
+                    "timeout": 120000
+                }
+            }),
+            &server_password,
+        )?;
+
+        let emitter = Emitter::new(store);
+        let resume_id = emitter.provider_thread_id()?;
+        let session = match resume_id {
+            Some(id) => match get_json(&base_url, &format!("/session/{id}"), &server_password) {
+                Ok(session) if session.get("id").and_then(Value::as_str) == Some(id.as_str()) => {
+                    session
+                }
+                Ok(_) | Err(_) => create_session(&base_url, &server_password)?,
+            },
+            None => create_session(&base_url, &server_password)?,
+        };
+        let session_id = session
+            .get("id")
+            .and_then(Value::as_str)
+            .ok_or_else(|| "OpenCode session response did not include an id.".to_string())?
+            .to_string();
+        emitter.set_provider_thread_id(&session_id);
+
+        spawn_event_reader(&base_url, &server_password, sender);
+        let catalog = get_json(&base_url, "/provider", &server_password)?;
+        emitter.emit(
+            "model.catalog",
+            json!({
+                "provider": "opencode",
+                "models": normalize_models(&catalog)
+            }),
+        );
+        emitter.emit(
+            "runtime.ready",
+            json!({
+                "provider": "opencode",
+                "threadId": session_id,
+                "capabilities": {
+                    "approvals": true,
+                    "userInput": true,
+                    "plans": false,
+                    "usage": true,
+                    "modelOverrides": true
+                }
+            }),
+        );
+
+        Ok(Self {
+            _process: process,
+            base_url,
+            server_password,
+            session_id,
+            active_turn: false,
+            next_tool_id: 1,
+            pending_tools: HashMap::new(),
+            pending_questions: HashMap::new(),
+            message_roles: HashMap::new(),
+            part_kinds: HashMap::new(),
+            emitted_text: HashMap::new(),
+            emitter,
+        })
+    }
+
+    fn session_matches(&self, event: &Value) -> bool {
+        event
+            .pointer("/properties/sessionID")
+            .and_then(Value::as_str)
+            == Some(self.session_id.as_str())
+    }
+
+    fn tool_description() -> &'static str {
+        concat!(
+            "Execute ordinary Python inside the active FreeCAD GUI. ",
+            "App/FreeCAD, Gui, doc, and a small cad inspection helper are prebound. ",
+            "cad.selection() describes selected objects, faces, and edges. ",
+            "The complete source runs as one transaction, recomputes and validates, ",
+            "then returns result/stdout plus created, changed, and deleted objects. ",
+            "Call cad.render() to attach a viewport image for visual verification."
+        )
+    }
+
+    fn developer_instructions() -> &'static str {
+        concat!(
+            "You are operating inside FreeCAD through Anthracite. ",
+            "Use the anthracite_freecad MCP tool for CAD inspection and every CAD mutation. ",
+            "It accepts ordinary FreeCAD Python with App, Gui, doc, and cad available. ",
+            "Prefer parametric, named objects and constraints. Inspect before editing. ",
+            "Use cad.selection() for selected faces and edges. Treat subelement names as ",
+            "momentary references and re-inspect after topology-changing edits. ",
+            "A tool call is one undoable transaction: failures roll back automatically. ",
+            "Read the returned observation, fix errors, and verify the finished model. ",
+            "Use cad.render() when a viewport image would materially improve verification."
+        )
+    }
+
+    fn mcp_result(result: &str, success: bool, images: &Value) -> Value {
+        let mut content = vec![json!({"type": "text", "text": result})];
+        content.extend(
+            images
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(Value::as_str)
+                .filter_map(|image| image.strip_prefix("data:image/"))
+                .filter_map(|rest| {
+                    let (format, data) = rest.split_once(";base64,")?;
+                    Some(json!({
+                        "type": "image",
+                        "data": data,
+                        "mimeType": format!("image/{format}")
+                    }))
+                }),
+        );
+        json!({"content": content, "isError": !success})
+    }
+
+    fn emit_part_text(&mut self, part: &Value, kind: &str) {
+        let part_id = part.get("id").and_then(Value::as_str).unwrap_or("");
+        let text = part.get("text").and_then(Value::as_str).unwrap_or("");
+        if part_id.is_empty() || text.is_empty() {
+            return;
+        }
+        let previous = self
+            .emitted_text
+            .get(part_id)
+            .map(String::as_str)
+            .unwrap_or("");
+        let delta = if let Some(suffix) = text.strip_prefix(previous) {
+            suffix
+        } else if previous.starts_with(text) {
+            ""
+        } else {
+            text
+        };
+        self.emitted_text
+            .insert(part_id.to_string(), text.to_string());
+        if !delta.is_empty() {
+            self.emitter.emit(
+                "content.delta",
+                json!({
+                    "streamKind": if kind == "reasoning" {
+                        "reasoning_text"
+                    } else {
+                        "assistant_text"
+                    },
+                    "text": delta
+                }),
+            );
+        }
+    }
+
+    fn handle_part(&mut self, part: &Value) {
+        let part_id = part.get("id").and_then(Value::as_str).unwrap_or("");
+        let message_id = part.get("messageID").and_then(Value::as_str).unwrap_or("");
+        let kind = part.get("type").and_then(Value::as_str).unwrap_or("");
+        if !part_id.is_empty() {
+            self.part_kinds
+                .insert(part_id.to_string(), kind.to_string());
+        }
+        if self.message_roles.get(message_id).map(String::as_str) != Some("assistant") {
+            return;
+        }
+        match part.get("type").and_then(Value::as_str) {
+            Some("text" | "reasoning") => self.emit_part_text(part, kind),
+            Some("tool") => {
+                let state = part
+                    .pointer("/state/status")
+                    .and_then(Value::as_str)
+                    .unwrap_or("");
+                let message_type = match state {
+                    "pending" => "item.started",
+                    "completed" | "error" => "item.completed",
+                    _ => "item.updated",
+                };
+                self.emitter.emit(
+                    message_type,
+                    json!({
+                        "itemId": part.get("callID"),
+                        "kind": "mcp_tool_call",
+                        "title": part.get("tool").and_then(Value::as_str).unwrap_or("Tool"),
+                        "detail": part.pointer("/state/title").or_else(|| part.pointer("/state/error"))
+                    }),
+                );
+            }
+            Some("step-finish") => {
+                let tokens = part.get("tokens").unwrap_or(&Value::Null);
+                self.emitter.emit(
+                    "usage.updated",
+                    json!({
+                        "usedTokens": tokens.get("total")
+                            .or_else(|| tokens.get("input")),
+                        "inputTokens": tokens.get("input"),
+                        "outputTokens": tokens.get("output"),
+                        "reasoningOutputTokens": tokens.get("reasoning")
+                    }),
+                );
+            }
+            _ => {}
+        }
+    }
+
+    fn error_text(error: &Value) -> String {
+        error
+            .pointer("/data/message")
+            .or_else(|| error.get("message"))
+            .and_then(Value::as_str)
+            .unwrap_or("OpenCode reported an unknown error.")
+            .to_string()
+    }
+}
+
+impl ProviderAdapter for OpenCodeAdapter {
+    fn start_turn(&mut self, prompt: &str, model: &str, effort: &str) -> Result<(), String> {
+        if self.active_turn {
+            return Err("OpenCode is already running a turn.".to_string());
+        }
+        let mut body = json!({
+            "system": Self::developer_instructions(),
+            "parts": [{"type": "text", "text": prompt}]
+        });
+        if !model.is_empty() {
+            let (provider_id, model_id) = model
+                .split_once('/')
+                .ok_or_else(|| "OpenCode models must use provider/model format.".to_string())?;
+            body["model"] = json!({"providerID": provider_id, "modelID": model_id});
+        }
+        if !effort.is_empty() {
+            body["variant"] = json!(effort);
+        }
+        post_json(
+            &self.base_url,
+            &format!("/session/{}/prompt_async", self.session_id),
+            &body,
+            &self.server_password,
+        )?;
+        self.active_turn = true;
+        self.emitter
+            .record("content.user", &json!({"text": prompt}));
+        self.emitter.emit(
+            "turn.started",
+            json!({"turnId": self.session_id, "provider": "opencode"}),
+        );
+        self.emitter
+            .emit("session.state", json!({"state": "running"}));
+        Ok(())
+    }
+
+    fn return_tool_result(
+        &mut self,
+        request_id: Value,
+        result: &str,
+        success: bool,
+        images: &Value,
+    ) -> Result<(), String> {
+        let request_id = request_id
+            .as_str()
+            .ok_or_else(|| "OpenCode tool request id was not a string.".to_string())?;
+        let pending = self
+            .pending_tools
+            .remove(request_id)
+            .ok_or_else(|| format!("Unknown OpenCode tool request: {request_id}"))?;
+        self.emitter.record(
+            "tool.result",
+            &json!({
+                "requestId": request_id,
+                "result": result,
+                "success": success,
+                "imageCount": images.as_array().map_or(0, Vec::len)
+            }),
+        );
+        pending
+            .response
+            .send(json!({
+                "jsonrpc": "2.0",
+                "id": pending.jsonrpc_id,
+                "result": Self::mcp_result(result, success, images)
+            }))
+            .map_err(|_| "OpenCode MCP connection closed before the tool completed.".to_string())
+    }
+
+    fn resolve_request(&mut self, request_id: &str, decision: &str) -> Result<(), String> {
+        let reply = match decision {
+            "approve" => "once",
+            "approve_session" => "always",
+            "decline" | "cancel" => "reject",
+            _ => return Err(format!("Unknown approval decision: {decision}")),
+        };
+        post_json(
+            &self.base_url,
+            &format!("/permission/{request_id}/reply"),
+            &json!({"reply": reply}),
+            &self.server_password,
+        )?;
+        self.emitter.emit(
+            "request.resolved",
+            json!({"requestId": request_id, "decision": decision}),
+        );
+        Ok(())
+    }
+
+    fn resolve_user_input(&mut self, request_id: &str, answers: &Value) -> Result<(), String> {
+        let question_ids = self
+            .pending_questions
+            .remove(request_id)
+            .ok_or_else(|| format!("Unknown OpenCode user-input request: {request_id}"))?;
+        let answers = question_ids
+            .iter()
+            .map(|id| match answers.get(id) {
+                Some(Value::Array(values)) => values.clone(),
+                Some(Value::String(value)) => vec![json!(value)],
+                Some(value) => vec![json!(value.to_string())],
+                None => Vec::new(),
+            })
+            .collect::<Vec<_>>();
+        post_json(
+            &self.base_url,
+            &format!("/question/{request_id}/reply"),
+            &json!({"answers": answers}),
+            &self.server_password,
+        )?;
+        self.emitter.emit(
+            "user_input.resolved",
+            json!({"requestId": request_id, "answers": answers}),
+        );
+        Ok(())
+    }
+
