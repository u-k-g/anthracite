+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+mod codex;
+mod opencode;
+
+use crate::process::IoEvent;
+use crate::store::Store;
+use serde_json::Value;
+use std::sync::mpsc;
+
+pub trait ProviderAdapter {
+    fn start_turn(&mut self, prompt: &str, model: &str, effort: &str) -> Result<(), String>;
+    fn return_tool_result(
+        &mut self,
+        request_id: Value,
+        result: &str,
+        success: bool,
+        images: &Value,
+    ) -> Result<(), String>;
+    fn resolve_request(&mut self, request_id: &str, decision: &str) -> Result<(), String>;
+    fn resolve_user_input(&mut self, request_id: &str, answers: &Value) -> Result<(), String>;
+    fn save_draft(&mut self, body: &str, save_id: &Value);
+    fn save_model_selection(&mut self, model: &str, effort: &str);
+    fn interrupt(&mut self) -> Result<(), String>;
+    fn handle_message(&mut self, message: Value) -> Result<(), String>;
+    fn handle_mcp_message(
+        &mut self,
+        _message: Value,
+        response: Option<mpsc::Sender<Value>>,
+    ) -> Result<(), String> {
+        if let Some(response) = response {
+            let _ = response.send(serde_json::json!({
+                "jsonrpc": "2.0",
+                "id": Value::Null,
+                "error": {"code": -32601, "message": "Provider does not expose MCP."}
+            }));
+        }
+        Ok(())
+    }
+}
+
+pub fn start(
+    kind: &str,
+    binary: &str,
+    cwd: &str,
+    sender: &mpsc::Sender<IoEvent>,
+    store: Store,
+) -> Result<Box<dyn ProviderAdapter>, String> {
+    match kind {
+        "codex" => Ok(Box::new(codex::CodexAdapter::start(
+            binary, cwd, sender, store,
+        )?)),
+        "opencode" => Ok(Box::new(opencode::OpenCodeAdapter::start(
+            binary, cwd, sender, store,
+        )?)),
+        _ => Err(format!("Unsupported provider adapter: {kind}")),
+    }
+}
