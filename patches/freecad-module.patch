diff --git a/src/Mod/Anthracite/CMakeLists.txt b/src/Mod/Anthracite/CMakeLists.txt
new file mode 100644
index 0000000000..c7ce83d47d
--- /dev/null
+++ b/src/Mod/Anthracite/CMakeLists.txt
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+
+set(Anthracite_Scripts
+    AnthraciteExecutor.py
+    Init.py
+    TestAnthracite.py
+)
+
+if(BUILD_GUI)
+    list(APPEND Anthracite_Scripts
+        InitGui.py
+        TestAnthraciteGui.py
+    )
+    add_subdirectory(Gui)
+endif()
+
+add_custom_target(AnthraciteScripts ALL
+    SOURCES ${Anthracite_Scripts}
+)
+
+fc_target_copy_resource(
+    AnthraciteScripts
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${CMAKE_BINARY_DIR}/Mod/Anthracite
+    ${Anthracite_Scripts}
+)
+
+install(
+    FILES ${Anthracite_Scripts}
+    DESTINATION Mod/Anthracite
+)
