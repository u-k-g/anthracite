+    #[test]
+    fn persists_trajectory_without_writing_to_the_freecad_document() {
+        let directory = tempfile::tempdir().unwrap();
+        let document_path = directory.path().join("model.FCStd");
+        std::fs::write(&document_path, b"upstream-compatible-freecad-data").unwrap();
+        let database_path = directory.path().join("anthracite.db");
+        let document = json!({
+            "path": document_path,
+            "displayName": "model.FCStd",
+            "sessionKey": "not-used-for-saved-documents"
+        });
+
+        let store = Store::open(
+            database_path.to_str().unwrap(),
+            &document,
+            "codex",
+            None,
+            false,
+        )
+        .unwrap();
+        let first_thread = store.local_thread_id().to_owned();
+        store
+            .record("content.user", &json!({"text": "Make a bracket"}))
+            .unwrap();
+        store
+            .record(
+                "content.delta",
+                &json!({"streamKind": "assistant_text", "text": "Done"}),
+            )
+            .unwrap();
+        drop(store);
+
+        let reopened = Store::open(
+            database_path.to_str().unwrap(),
+            &document,
+            "codex",
+            None,
+            false,
+        )
+        .unwrap();
+        assert_eq!(reopened.local_thread_id(), first_thread);
+        assert_eq!(reopened.history().unwrap().len(), 2);
+        assert_eq!(
+            std::fs::read(document_path).unwrap(),
+            b"upstream-compatible-freecad-data"
+        );
+    }
