+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+use serde_json::{Value, json};
+use std::io::{self, Write};
+
+use crate::store::Store;
+
+pub const VERSION: u64 = 1;
+
+pub fn message_type(message: &Value) -> &str {
+    message.get("type").and_then(Value::as_str).unwrap_or("")
+}
+
+pub fn payload(message: &Value) -> &Value {
+    message.get("payload").unwrap_or(&Value::Null)
+}
+
+pub fn emit_raw(message_type: &str, payload: Value) {
+    let stdout = io::stdout();
+    let mut output = stdout.lock();
+    let value = json!({
+        "protocolVersion": VERSION,
+        "type": message_type,
+        "payload": payload
+    });
+    if serde_json::to_writer(&mut output, &value).is_ok() {
+        let _ = output.write_all(b"\n");
+        let _ = output.flush();
+    }
+}
+
+pub fn emit_error(message: impl Into<String>) {
+    emit_raw(
+        "runtime.error",
+        json!({"class": "provider_error", "message": message.into()}),
+    );
+}
+
+pub fn emit_warning(message: impl Into<String>) {
+    emit_raw("runtime.warning", json!({"message": message.into()}));
+}
+
+pub struct Emitter {
+    store: Store,
+}
+
+impl Emitter {
+    pub fn new(store: Store) -> Self {
+        let emitter = Self { store };
+        emit_raw("thread.local.ready", emitter.store.summary());
+        emitter.emit_thread_list();
+        match emitter.store.history() {
+            Ok(events) => emit_raw("history.snapshot", json!({"events": events})),
+            Err(error) => emit_warning(format!("Could not load conversation history: {error}")),
+        }
+        match emitter.store.draft() {
+            Ok(body) => emit_raw("draft.loaded", json!({"body": body})),
+            Err(error) => emit_warning(format!("Could not load composer draft: {error}")),
+        }
+        match emitter.store.model_selection() {
+            Ok(selection) => emit_raw("model.selection", selection),
+            Err(error) => emit_warning(format!("Could not load model selection: {error}")),
+        }
+        emitter
+    }
+
+    pub fn emit(&self, message_type: &str, payload: Value) {
+        if let Err(error) = self.store.record(message_type, &payload) {
+            emit_warning(format!("Could not persist runtime event: {error}"));
+        }
+        emit_raw(message_type, payload);
+    }
+
+    pub fn record(&self, message_type: &str, payload: &Value) {
+        if let Err(error) = self.store.record(message_type, payload) {
+            emit_warning(format!("Could not persist runtime event: {error}"));
+        }
+        if message_type == "content.user" {
+            self.emit_thread_list();
+        }
+    }
+
+    pub fn provider_thread_id(&self) -> Result<Option<String>, String> {
+        self.store.provider_thread_id()
+    }
+
+    pub fn set_provider_thread_id(&self, provider_thread_id: &str) {
+        if let Err(error) = self.store.set_provider_thread_id(provider_thread_id) {
+            emit_warning(format!("Could not persist provider thread id: {error}"));
+        }
+    }
+
+    pub fn save_draft(&self, body: &str, save_id: &Value) {
+        match self.store.save_draft(body) {
+            Ok(()) => emit_raw("draft.saved", json!({"saveId": save_id})),
+            Err(error) => emit_warning(format!("Could not persist composer draft: {error}")),
+        }
+    }
+
+    pub fn save_model_selection(&self, model: &str, effort: &str) {
+        match self.store.save_model_selection(model, effort) {
+            Ok(()) => emit_raw("model.selection", json!({"model": model, "effort": effort})),
+            Err(error) => emit_warning(format!("Could not persist model selection: {error}")),
+        }
+    }
+
+    fn emit_thread_list(&self) {
+        match self.store.threads() {
+            Ok(threads) => emit_raw(
+                "thread.list",
+                json!({
+                    "currentThreadId": self.store.local_thread_id(),
+                    "threads": threads
+                }),
+            ),
+            Err(error) => emit_warning(format!("Could not list conversations: {error}")),
+        }
+    }
+}
