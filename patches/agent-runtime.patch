+        )
+        .unwrap();
+        let unsaved_thread = unsaved.local_thread_id().to_owned();
+        drop(unsaved);
+
+        let document_path = directory.path().join("saved.FCStd");
+        std::fs::write(&document_path, b"saved-freecad-data").unwrap();
+        let saved = Store::open(
+            database_path.to_str().unwrap(),
+            &json!({
+                "path": document_path,
+                "sessionKey": "same-session",
+                "displayName": "saved.FCStd"
+            }),
+            "codex",
+            None,
+            false,
+        )
+        .unwrap();
+
+        assert_eq!(saved.local_thread_id(), unsaved_thread);
+
+        let moved_path = directory.path().join("saved-as.FCStd");
+        std::fs::write(&moved_path, b"saved-freecad-data").unwrap();
+        let saved_as = Store::open(
+            database_path.to_str().unwrap(),
+            &json!({
+                "path": moved_path,
+                "sessionKey": "same-session",
+                "displayName": "saved-as.FCStd"
+            }),
+            "codex",
+            None,
+            false,
+        )
+        .unwrap();
+        assert_eq!(saved_as.local_thread_id(), unsaved_thread);
+    }
+
+    #[test]
+    fn creates_selects_and_lists_document_threads_with_separate_drafts() {
+        let directory = tempfile::tempdir().unwrap();
+        let database_path = directory.path().join("anthracite.db");
+        let document = json!({"sessionKey": "threaded-document", "displayName": "Untitled"});
+        let first = Store::open(
+            database_path.to_str().unwrap(),
+            &document,
+            "codex",
+            None,
+            false,
+        )
+        .unwrap();
+        let first_thread = first.local_thread_id().to_owned();
+        first
+            .record("content.user", &json!({"text": "First conversation"}))
+            .unwrap();
+        first.save_draft("first draft").unwrap();
+        first.save_model_selection("gpt-first", "high").unwrap();
+        drop(first);
+
+        let second = Store::open(
+            database_path.to_str().unwrap(),
+            &document,
+            "codex",
+            None,
+            true,
+        )
+        .unwrap();
+        let second_thread = second.local_thread_id().to_owned();
+        assert_ne!(second_thread, first_thread);
+        second.save_draft("second draft").unwrap();
+        assert_eq!(second.threads().unwrap().len(), 2);
+        drop(second);
+
+        let selected = Store::open(
+            database_path.to_str().unwrap(),
+            &document,
+            "codex",
+            Some(&first_thread),
+            false,
+        )
+        .unwrap();
+        assert_eq!(selected.local_thread_id(), first_thread);
+        assert_eq!(selected.draft().unwrap(), "first draft");
+        assert_eq!(
+            selected.model_selection().unwrap(),
+            json!({"model": "gpt-first", "effort": "high"})
+        );
+        assert!(
+            second_thread.starts_with("thread-"),
+            "thread IDs remain opaque and provider-independent"
+        );
+    }
+}
