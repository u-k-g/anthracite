+
+fn now_ms() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(i64::MAX)
+}
+
+fn new_id(prefix: &str) -> String {
+    format!("{prefix}-{}", Uuid::new_v4())
+}
+
+fn canonical_path(path: &str) -> Option<String> {
+    if path.is_empty() {
+        return None;
+    }
+    let path = Path::new(path);
+    path.canonicalize()
+        .ok()
+        .or_else(|| Some(path.to_path_buf()))
+        .map(|path| path.to_string_lossy().into_owned())
+}
+
+fn fingerprint(path: &str) -> Option<String> {
+    let mut file = File::open(path).ok()?;
+    let mut digest = Sha256::new();
+    let mut buffer = [0_u8; 64 * 1024];
+    loop {
+        let count = file.read(&mut buffer).ok()?;
+        if count == 0 {
+            break;
+        }
+        digest.update(&buffer[..count]);
+    }
+    Some(format!("{:x}", digest.finalize()))
+}
+
+pub struct Store {
+    runtime: Runtime,
+    connection: Connection,
+    document_id: String,
+    thread_id: String,
+    provider: String,
+}
+
+impl Store {
+    pub fn open(
+        database_path: &str,
+        document: &Value,
+        provider: &str,
+        requested_thread_id: Option<&str>,
+        create_thread: bool,
+    ) -> Result<Self, String> {
+        let path = PathBuf::from(database_path);
+        if let Some(parent) = path.parent() {
+            std::fs::create_dir_all(parent).map_err(|error| {
+                format!(
+                    "Could not create Anthracite data directory {}: {error}",
+                    parent.display()
+                )
+            })?;
+        }
+
+        let runtime = RuntimeBuilder::new_current_thread()
+            .build()
+            .map_err(|error| format!("Could not start Turso runtime: {error}"))?;
+        let database = runtime
+            .block_on(Builder::new_local(database_path).build())
+            .map_err(|error| format!("Could not open Anthracite Turso database: {error}"))?;
+        let connection = database
+            .connect()
+            .map_err(|error| format!("Could not connect to Anthracite Turso database: {error}"))?;
+        runtime
+            .block_on(connection.execute_batch(MIGRATION))
+            .map_err(|error| format!("Could not migrate Anthracite Turso database: {error}"))?;
+
+        let mut store = Self {
+            runtime,
+            connection,
+            document_id: String::new(),
+            thread_id: String::new(),
+            provider: provider.to_owned(),
+        };
+        store.document_id = store.resolve_document(document)?;
+        store.thread_id = store.resolve_thread(requested_thread_id, create_thread)?;
+        Ok(store)
+    }
+
+    fn query_string(
+        &self,
+        sql: &str,
+        parameters: impl turso::IntoParams,
+    ) -> Result<Option<String>, String> {
+        self.runtime
+            .block_on(async {
+                let mut rows = self.connection.query(sql, parameters).await?;
+                Ok::<_, turso::Error>(match rows.next().await? {
+                    Some(row) => Some(row.get::<String>(0)?),
+                    None => None,
+                })
+            })
+            .map_err(|error| error.to_string())
+    }
+
+    fn resolve_document(&self, document: &Value) -> Result<String, String> {
+        let raw_path = document.get("path").and_then(Value::as_str).unwrap_or("");
+        let path = canonical_path(raw_path);
+        let session_key = document
+            .get("sessionKey")
+            .and_then(Value::as_str)
+            .filter(|value| !value.is_empty())
+            .map(str::to_owned);
+        let display_name = document
+            .get("displayName")
+            .and_then(Value::as_str)
+            .filter(|value| !value.is_empty())
+            .unwrap_or("Unsaved FreeCAD document");
+        let file_fingerprint = path.as_deref().and_then(fingerprint);
+        let session_document_id = match &session_key {
+            Some(session_key) => self.query_string(
+                "SELECT id FROM documents WHERE session_key = ?1 LIMIT 1",
+                params![session_key.as_str()],
+            )?,
+            None => None,
+        };
+
+        if let Some(path) = &path
+            && let Some(id) = self.query_string(
+                "SELECT id FROM documents WHERE canonical_path = ?1 LIMIT 1",
+                params![path.as_str()],
+            )?
+        {
+            if let Some(session_document_id) = &session_document_id
+                && session_document_id != &id
+            {
+                self.runtime
+                    .block_on(self.connection.execute(
+                        "UPDATE documents SET session_key = NULL WHERE id = ?1",
+                        params![session_document_id.as_str()],
+                    ))
+                    .map_err(|error| error.to_string())?;
+            }
+            self.runtime
+                .block_on(self.connection.execute(
+                    "UPDATE documents
+                     SET session_key = ?1, fingerprint = ?2,
+                         display_name = ?3, updated_at_ms = ?4
+                     WHERE id = ?5",
+                    params![
+                        session_key,
+                        file_fingerprint,
+                        display_name,
+                        now_ms(),
+                        id.clone()
+                    ],
+                ))
+                .map_err(|error| error.to_string())?;
+            return Ok(id);
+        }
+
+        if let Some(id) = session_document_id {
+            if let Some(path) = &path {
+                self.runtime
+                    .block_on(self.connection.execute(
+                        "UPDATE documents
+                         SET canonical_path = ?1, fingerprint = ?2,
+                             display_name = ?3, updated_at_ms = ?4
+                         WHERE id = ?5",
+                        params![
+                            path.as_str(),
+                            file_fingerprint,
+                            display_name,
+                            now_ms(),
+                            id.clone()
+                        ],
+                    ))
+                    .map_err(|error| error.to_string())?;
+            }
+            return Ok(id);
+        }
+
+        if let (Some(path), Some(file_fingerprint)) = (&path, &file_fingerprint) {
+            let matches = self
+                .runtime
+                .block_on(async {
+                    let mut rows = self
+                        .connection
+                        .query(
+                            "SELECT id, canonical_path
+                             FROM documents
+                             WHERE fingerprint = ?1
+                             LIMIT 2",
+                            params![file_fingerprint.as_str()],
+                        )
+                        .await?;
+                    let mut matches = Vec::new();
+                    while let Some(row) = rows.next().await? {
+                        matches.push((row.get::<String>(0)?, row.get::<String>(1)?));
+                    }
+                    Ok::<_, turso::Error>(matches)
+                })
+                .map_err(|error| error.to_string())?;
+            if matches.len() == 1 && !Path::new(&matches[0].1).exists() {
+                let id = matches[0].0.clone();
+                self.runtime
+                    .block_on(self.connection.execute(
+                        "UPDATE documents
+                         SET canonical_path = ?1, session_key = ?2,
+                             display_name = ?3, updated_at_ms = ?4
+                         WHERE id = ?5",
+                        params![
+                            path.as_str(),
+                            session_key,
+                            display_name,
+                            now_ms(),
+                            id.clone()
+                        ],
+                    ))
+                    .map_err(|error| error.to_string())?;
+                return Ok(id);
+            }
+        }
+
+        let id = new_id("document");
+        let timestamp = now_ms();
+        self.runtime
+            .block_on(self.connection.execute(
+                "INSERT INTO documents(
+                    id, canonical_path, session_key, fingerprint, display_name,
+                    created_at_ms, updated_at_ms
+                 ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)",
+                params![
+                    id.clone(),
+                    path,
+                    session_key,
+                    file_fingerprint,
+                    display_name,
+                    timestamp,
+                    timestamp
+                ],
+            ))
+            .map_err(|error| error.to_string())?;
+        Ok(id)
+    }
+
+    fn resolve_thread(
+        &self,
+        requested_thread_id: Option<&str>,
+        create_thread: bool,
+    ) -> Result<String, String> {
+        if !create_thread {
+            if let Some(requested_thread_id) = requested_thread_id.filter(|value| !value.is_empty())
+            {
+                return self
+                    .query_string(
+                        "SELECT id
+                         FROM threads
+                         WHERE id = ?1 AND document_id = ?2
+                           AND provider = ?3 AND archived = 0
+                         LIMIT 1",
+                        params![
+                            requested_thread_id,
+                            self.document_id.clone(),
+                            self.provider.clone()
+                        ],
+                    )?
+                    .ok_or_else(|| {
+                        "The selected conversation does not belong to this document.".to_string()
+                    });
+            }
+
+            if let Some(id) = self.query_string(
+                "SELECT id
+                 FROM threads
+                 WHERE document_id = ?1 AND provider = ?2 AND archived = 0
+                 ORDER BY updated_at_ms DESC
+                 LIMIT 1",
+                params![self.document_id.clone(), self.provider.clone()],
+            )? {
+                return Ok(id);
+            }
+        }
+
+        let id = new_id("thread");
+        let timestamp = now_ms();
+        self.runtime
+            .block_on(self.connection.execute(
+                "INSERT INTO threads(
+                    id, document_id, provider, title, created_at_ms, updated_at_ms
+                 ) VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
+                params![
+                    id.clone(),
+                    self.document_id.clone(),
+                    self.provider.clone(),
+                    "New conversation",
+                    timestamp,
+                    timestamp
+                ],
+            ))
+            .map_err(|error| error.to_string())?;
+        Ok(id)
+    }
+
+    pub fn local_thread_id(&self) -> &str {
+        &self.thread_id
+    }
+
+    pub fn threads(&self) -> Result<Vec<Value>, String> {
+        self.runtime
+            .block_on(async {
+                let mut rows = self
+                    .connection
+                    .query(
+                        "SELECT id, title, updated_at_ms
+                         FROM threads
+                         WHERE document_id = ?1 AND provider = ?2 AND archived = 0
+                         ORDER BY updated_at_ms DESC",
+                        params![self.document_id.clone(), self.provider.clone()],
+                    )
+                    .await?;
+                let mut threads = Vec::new();
+                while let Some(row) = rows.next().await? {
+                    let id = row.get::<String>(0)?;
+                    threads.push(json!({
+                        "id": id,
+                        "title": row.get::<String>(1)?,
+                        "updatedAtMs": row.get::<i64>(2)?,
+                        "current": id == self.thread_id
+                    }));
+                }
+                Ok::<_, turso::Error>(threads)
+            })
+            .map_err(|error| error.to_string())
+    }
+
+    pub fn provider_thread_id(&self) -> Result<Option<String>, String> {
+        self.query_string(
+            "SELECT provider_thread_id
+             FROM threads
+             WHERE id = ?1 AND provider_thread_id IS NOT NULL",
+            params![self.thread_id.clone()],
+        )
+    }
+
+    pub fn set_provider_thread_id(&self, provider_thread_id: &str) -> Result<(), String> {
+        self.runtime
+            .block_on(self.connection.execute(
+                "UPDATE threads
+                 SET provider_thread_id = ?1, updated_at_ms = ?2
+                 WHERE id = ?3",
+                params![provider_thread_id, now_ms(), self.thread_id.clone()],
+            ))
+            .map_err(|error| error.to_string())?;
+        Ok(())
+    }
+
+    pub fn draft(&self) -> Result<String, String> {
+        Ok(self
+            .query_string(
+                "SELECT body FROM drafts WHERE thread_id = ?1 LIMIT 1",
+                params![self.thread_id.clone()],
+            )?
+            .unwrap_or_default())
+    }
+
+    pub fn save_draft(&self, body: &str) -> Result<(), String> {
+        if body.is_empty() {
+            self.runtime
+                .block_on(self.connection.execute(
+                    "DELETE FROM drafts WHERE thread_id = ?1",
+                    params![self.thread_id.clone()],
+                ))
+                .map_err(|error| error.to_string())?;
+        } else {
+            self.runtime
+                .block_on(self.connection.execute(
+                    "INSERT INTO drafts(thread_id, body, updated_at_ms)
+                     VALUES (?1, ?2, ?3)
+                     ON CONFLICT(thread_id) DO UPDATE SET
+                         body = excluded.body,
+                         updated_at_ms = excluded.updated_at_ms",
+                    params![self.thread_id.clone(), body, now_ms()],
+                ))
+                .map_err(|error| error.to_string())?;
+        }
+        Ok(())
+    }
+
+    pub fn model_selection(&self) -> Result<Value, String> {
+        self.runtime
+            .block_on(async {
+                let mut rows = self
+                    .connection
+                    .query(
+                        "SELECT model, effort
+                         FROM thread_settings
+                         WHERE thread_id = ?1
+                         LIMIT 1",
+                        params![self.thread_id.clone()],
+                    )
+                    .await?;
+                Ok::<_, turso::Error>(match rows.next().await? {
+                    Some(row) => json!({
+                        "model": row.get::<String>(0)?,
+                        "effort": row.get::<String>(1)?
+                    }),
+                    None => json!({"model": "", "effort": ""}),
+                })
+            })
+            .map_err(|error| error.to_string())
+    }
+
+    pub fn save_model_selection(&self, model: &str, effort: &str) -> Result<(), String> {
+        self.runtime
+            .block_on(self.connection.execute(
+                "INSERT INTO thread_settings(thread_id, model, effort, updated_at_ms)
+                 VALUES (?1, ?2, ?3, ?4)
+                 ON CONFLICT(thread_id) DO UPDATE SET
+                     model = excluded.model,
+                     effort = excluded.effort,
+                     updated_at_ms = excluded.updated_at_ms",
+                params![self.thread_id.clone(), model, effort, now_ms()],
+            ))
+            .map_err(|error| error.to_string())?;
+        Ok(())
+    }
+
+    pub fn record(&self, event_type: &str, payload: &Value) -> Result<(), String> {
+        let turn_id = payload
+            .get("turnId")
+            .and_then(Value::as_str)
+            .map(str::to_owned);
+        self.runtime
+            .block_on(self.connection.execute(
+                "INSERT INTO events(
+                    thread_id, turn_id, event_type, payload_json, created_at_ms
+                 ) VALUES (?1, ?2, ?3, ?4, ?5)",
+                params![
+                    self.thread_id.clone(),
+                    turn_id,
+                    event_type,
+                    payload.to_string(),
+                    now_ms()
+                ],
+            ))
+            .map_err(|error| error.to_string())?;
+        if event_type == "content.user"
+            && let Some(text) = payload.get("text").and_then(Value::as_str)
+        {
+            let title = text.chars().take(80).collect::<String>();
+            self.runtime
+                .block_on(self.connection.execute(
+                    "UPDATE threads
+                     SET title = ?1
+                     WHERE id = ?2 AND title = 'New conversation'",
+                    params![title, self.thread_id.clone()],
+                ))
+                .map_err(|error| error.to_string())?;
+        }
+        self.runtime
+            .block_on(self.connection.execute(
+                "UPDATE threads SET updated_at_ms = ?1 WHERE id = ?2",
+                params![now_ms(), self.thread_id.clone()],
+            ))
+            .map_err(|error| error.to_string())?;
+        Ok(())
+    }
+
+    pub fn history(&self) -> Result<Vec<Value>, String> {
+        let mut events = self
+            .runtime
+            .block_on(async {
+                let mut rows = self
+                    .connection
+                    .query(
+                        "SELECT event_type, payload_json
+                         FROM events
+                         WHERE thread_id = ?1
+                           AND event_type IN (
+                               'content.user',
+                               'content.delta',
+                               'item.started',
+                               'plan.updated',
+                               'runtime.warning'
+                           )
+                         ORDER BY id DESC
+                         LIMIT 500",
+                        params![self.thread_id.clone()],
+                    )
+                    .await?;
+                let mut events = Vec::new();
+                while let Some(row) = rows.next().await? {
+                    let event_type = row.get::<String>(0)?;
+                    let payload = row.get::<String>(1)?;
+                    events.push(json!({
+                        "type": event_type,
+                        "payload": serde_json::from_str::<Value>(&payload).unwrap_or(Value::Null)
+                    }));
+                }
+                Ok::<_, turso::Error>(events)
+            })
+            .map_err(|error| error.to_string())?;
+        events.reverse();
+        Ok(events)
+    }
+
+    pub fn summary(&self) -> Value {
+        json!({
+            "localThreadId": self.local_thread_id(),
+            "documentId": self.document_id,
+            "provider": self.provider
+        })
+    }
+}
