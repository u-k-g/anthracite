+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn persists_trajectory_without_writing_to_the_freecad_document() {
+        let directory = tempfile::tempdir().unwrap();
+        let document_path = directory.path().join("model.FCStd");
+        std::fs::write(&document_path, b"upstream-compatible-freecad-data").unwrap();
+        let database_path = directory.path().join("anthracite.db");
+        let document = json!({
+            "path": document_path,
+            "displayName": "model.FCStd",
+            "sessionKey": "not-used-for-saved-documents"
+        });
+
+        let store = Store::open(database_path.to_str().unwrap(), &document, "codex").unwrap();
+        let first_thread = store.local_thread_id().to_owned();
+        store
+            .record("content.user", &json!({"text": "Make a bracket"}))
+            .unwrap();
+        store
+            .record(
+                "content.delta",
+                &json!({"streamKind": "assistant_text", "text": "Done"}),
+            )
+            .unwrap();
+        drop(store);
+
+        let reopened = Store::open(database_path.to_str().unwrap(), &document, "codex").unwrap();
+        assert_eq!(reopened.local_thread_id(), first_thread);
+        assert_eq!(reopened.history().unwrap().len(), 2);
+        assert_eq!(
+            std::fs::read(document_path).unwrap(),
+            b"upstream-compatible-freecad-data"
+        );
+    }
+
+    #[test]
+    fn keeps_unsaved_documents_separate_by_external_session_key() {
+        let directory = tempfile::tempdir().unwrap();
+        let database_path = directory.path().join("anthracite.db");
+        let first = Store::open(
+            database_path.to_str().unwrap(),
+            &json!({"sessionKey": "unsaved-one", "displayName": "Untitled"}),
+            "codex",
+        )
+        .unwrap();
+        let first_thread = first.local_thread_id().to_owned();
+        drop(first);
+
+        let second = Store::open(
+            database_path.to_str().unwrap(),
+            &json!({"sessionKey": "unsaved-two", "displayName": "Untitled"}),
+            "codex",
+        )
+        .unwrap();
+        assert_ne!(second.local_thread_id(), first_thread);
+    }
+
+    #[test]
+    fn saved_documents_do_not_reuse_unsaved_session_keys() {
+        let directory = tempfile::tempdir().unwrap();
+        let database_path = directory.path().join("anthracite.db");
+        let unsaved = Store::open(
+            database_path.to_str().unwrap(),
+            &json!({"sessionKey": "same-session", "displayName": "Untitled"}),
+            "codex",
+        )
+        .unwrap();
+        let unsaved_thread = unsaved.local_thread_id().to_owned();
+        drop(unsaved);
+
+        let document_path = directory.path().join("saved.FCStd");
+        std::fs::write(&document_path, b"saved-freecad-data").unwrap();
+        let saved = Store::open(
+            database_path.to_str().unwrap(),
+            &json!({
+                "path": document_path,
+                "sessionKey": "same-session",
+                "displayName": "saved.FCStd"
+            }),
+            "codex",
+        )
+        .unwrap();
+
+        assert_ne!(saved.local_thread_id(), unsaved_thread);
+    }
+}
