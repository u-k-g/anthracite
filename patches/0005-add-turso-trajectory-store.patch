@@ -0,0 +1,503 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::fs::File;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+use tokio::runtime::{Builder as RuntimeBuilder, Runtime};
+use turso::{Builder, Connection, params};
+use uuid::Uuid;
+
+const MIGRATION: &str = r#"
+CREATE TABLE IF NOT EXISTS anthracite_schema (
+    version INTEGER NOT NULL
+);
+INSERT INTO anthracite_schema(version)
+SELECT 1
+WHERE NOT EXISTS (SELECT 1 FROM anthracite_schema);
+
+CREATE TABLE IF NOT EXISTS documents (
+    id TEXT PRIMARY KEY,
+    canonical_path TEXT,
+    session_key TEXT,
+    fingerprint TEXT,
+    display_name TEXT NOT NULL,
+    created_at_ms INTEGER NOT NULL,
+    updated_at_ms INTEGER NOT NULL
+);
+CREATE UNIQUE INDEX IF NOT EXISTS documents_canonical_path
+    ON documents(canonical_path);
+CREATE UNIQUE INDEX IF NOT EXISTS documents_session_key
+    ON documents(session_key);
+CREATE INDEX IF NOT EXISTS documents_fingerprint
+    ON documents(fingerprint);
+
+CREATE TABLE IF NOT EXISTS threads (
+    id TEXT PRIMARY KEY,
+    document_id TEXT NOT NULL,
+    provider TEXT NOT NULL,
+    provider_thread_id TEXT,
+    title TEXT NOT NULL,
+    archived INTEGER NOT NULL DEFAULT 0,
+    created_at_ms INTEGER NOT NULL,
+    updated_at_ms INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS threads_document_updated
+    ON threads(document_id, provider, archived, updated_at_ms);
+
+CREATE TABLE IF NOT EXISTS events (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    thread_id TEXT NOT NULL,
+    turn_id TEXT,
+    event_type TEXT NOT NULL,
+    payload_json TEXT NOT NULL,
+    created_at_ms INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS events_thread_id
+    ON events(thread_id, id);
+
+CREATE TABLE IF NOT EXISTS drafts (
+    thread_id TEXT PRIMARY KEY,
+    body TEXT NOT NULL,
+    updated_at_ms INTEGER NOT NULL
+);
+"#;
+
+fn now_ms() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(i64::MAX)
+}
+
+fn new_id(prefix: &str) -> String {
+    format!("{prefix}-{}", Uuid::new_v4())
+}
+
+fn canonical_path(path: &str) -> Option<String> {
+    if path.is_empty() {
+        return None;
+    }
+    let path = Path::new(path);
+    path.canonicalize()
+        .ok()
+        .or_else(|| Some(path.to_path_buf()))
+        .map(|path| path.to_string_lossy().into_owned())
+}
+
+fn fingerprint(path: &str) -> Option<String> {
+    let mut file = File::open(path).ok()?;
+    let mut digest = Sha256::new();
+    let mut buffer = [0_u8; 64 * 1024];
+    loop {
+        let count = file.read(&mut buffer).ok()?;
+        if count == 0 {
+            break;
+        }
+        digest.update(&buffer[..count]);
+    }
+    Some(format!("{:x}", digest.finalize()))
+}
+
+pub struct Store {
+    runtime: Runtime,
+    connection: Connection,
+    document_id: String,
+    thread_id: String,
+    provider: String,
+}
+
+impl Store {
+    pub fn open(database_path: &str, document: &Value, provider: &str) -> Result<Self, String> {
+        let path = PathBuf::from(database_path);
+        if let Some(parent) = path.parent() {
+            std::fs::create_dir_all(parent).map_err(|error| {
+                format!(
+                    "Could not create Anthracite data directory {}: {error}",
+                    parent.display()
+                )
+            })?;
+        }
+
+        let runtime = RuntimeBuilder::new_current_thread()
+            .build()
+            .map_err(|error| format!("Could not start Turso runtime: {error}"))?;
+        let database = runtime
+            .block_on(Builder::new_local(database_path).build())
+            .map_err(|error| format!("Could not open Anthracite Turso database: {error}"))?;
+        let connection = database
+            .connect()
+            .map_err(|error| format!("Could not connect to Anthracite Turso database: {error}"))?;
+        runtime
+            .block_on(connection.execute_batch(MIGRATION))
+            .map_err(|error| format!("Could not migrate Anthracite Turso database: {error}"))?;
+
+        let mut store = Self {
+            runtime,
+            connection,
+            document_id: String::new(),
+            thread_id: String::new(),
+            provider: provider.to_owned(),
+        };
+        store.document_id = store.resolve_document(document)?;
+        store.thread_id = store.resolve_thread()?;
+        Ok(store)
+    }
+
+    fn query_string(
+        &self,
+        sql: &str,
+        parameters: impl turso::IntoParams,
+    ) -> Result<Option<String>, String> {
+        self.runtime
+            .block_on(async {
+                let mut rows = self.connection.query(sql, parameters).await?;
+                Ok::<_, turso::Error>(match rows.next().await? {
+                    Some(row) => Some(row.get::<String>(0)?),
+                    None => None,
+                })
+            })
+            .map_err(|error| error.to_string())
+    }
+
+    fn resolve_document(&self, document: &Value) -> Result<String, String> {
+        let raw_path = document.get("path").and_then(Value::as_str).unwrap_or("");
+        let path = canonical_path(raw_path);
+        let session_key = if path.is_none() {
+            document
+                .get("sessionKey")
+                .and_then(Value::as_str)
+                .filter(|value| !value.is_empty())
+                .map(str::to_owned)
+        } else {
+            None
+        };
+        let display_name = document
+            .get("displayName")
+            .and_then(Value::as_str)
+            .filter(|value| !value.is_empty())
+            .unwrap_or("Unsaved FreeCAD document");
+        let file_fingerprint = path.as_deref().and_then(fingerprint);
+
+        if let Some(path) = &path
+            && let Some(id) = self.query_string(
+                "SELECT id FROM documents WHERE canonical_path = ?1 LIMIT 1",
+                params![path.as_str()],
+            )?
+        {
+            self.runtime
+                .block_on(self.connection.execute(
+                    "UPDATE documents
+                     SET fingerprint = ?1, display_name = ?2, updated_at_ms = ?3
+                     WHERE id = ?4",
+                    params![file_fingerprint, display_name, now_ms(), id.clone()],
+                ))
+                .map_err(|error| error.to_string())?;
+            return Ok(id);
+        }
+
+        if path.is_none()
+            && let Some(session_key) = &session_key
+            && let Some(id) = self.query_string(
+                "SELECT id FROM documents WHERE session_key = ?1 LIMIT 1",
+                params![session_key.as_str()],
+            )?
+        {
+            return Ok(id);
+        }
+
+        if let (Some(path), Some(file_fingerprint)) = (&path, &file_fingerprint) {
+            let matches = self
+                .runtime
+                .block_on(async {
+                    let mut rows = self
+                        .connection
+                        .query(
+                            "SELECT id, canonical_path
+                             FROM documents
+                             WHERE fingerprint = ?1
+                             LIMIT 2",
+                            params![file_fingerprint.as_str()],
+                        )
+                        .await?;
+                    let mut matches = Vec::new();
+                    while let Some(row) = rows.next().await? {
+                        matches.push((row.get::<String>(0)?, row.get::<String>(1)?));
+                    }
+                    Ok::<_, turso::Error>(matches)
+                })
+                .map_err(|error| error.to_string())?;
+            if matches.len() == 1 && !Path::new(&matches[0].1).exists() {
+                let id = matches[0].0.clone();
+                self.runtime
+                    .block_on(self.connection.execute(
+                        "UPDATE documents
+                         SET canonical_path = ?1, display_name = ?2, updated_at_ms = ?3
+                         WHERE id = ?4",
+                        params![path.as_str(), display_name, now_ms(), id.clone()],
+                    ))
+                    .map_err(|error| error.to_string())?;
+                return Ok(id);
+            }
+        }
+
+        let id = new_id("document");
+        let timestamp = now_ms();
+        self.runtime
+            .block_on(self.connection.execute(
+                "INSERT INTO documents(
+                    id, canonical_path, session_key, fingerprint, display_name,
+                    created_at_ms, updated_at_ms
+                 ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)",
+                params![
+                    id.clone(),
+                    path,
+                    session_key,
+                    file_fingerprint,
+                    display_name,
+                    timestamp,
+                    timestamp
+                ],
+            ))
+            .map_err(|error| error.to_string())?;
+        Ok(id)
+    }
+
+    fn resolve_thread(&self) -> Result<String, String> {
+        if let Some(id) = self.query_string(
+            "SELECT id
+             FROM threads
+             WHERE document_id = ?1 AND provider = ?2 AND archived = 0
+             ORDER BY updated_at_ms DESC
+             LIMIT 1",
+            params![self.document_id.clone(), self.provider.clone()],
+        )? {
+            return Ok(id);
+        }
+
+        let id = new_id("thread");
+        let timestamp = now_ms();
+        self.runtime
+            .block_on(self.connection.execute(
+                "INSERT INTO threads(
+                    id, document_id, provider, title, created_at_ms, updated_at_ms
+                 ) VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
+                params![
+                    id.clone(),
+                    self.document_id.clone(),
+                    self.provider.clone(),
+                    "New conversation",
+                    timestamp,
+                    timestamp
+                ],
+            ))
+            .map_err(|error| error.to_string())?;
+        Ok(id)
+    }
+
+    pub fn local_thread_id(&self) -> &str {
+        &self.thread_id
+    }
+
+    pub fn provider_thread_id(&self) -> Result<Option<String>, String> {
+        self.query_string(
+            "SELECT provider_thread_id
+             FROM threads
+             WHERE id = ?1 AND provider_thread_id IS NOT NULL",
+            params![self.thread_id.clone()],
+        )
+    }
+
+    pub fn set_provider_thread_id(&self, provider_thread_id: &str) -> Result<(), String> {
+        self.runtime
+            .block_on(self.connection.execute(
+                "UPDATE threads
+                 SET provider_thread_id = ?1, updated_at_ms = ?2
+                 WHERE id = ?3",
+                params![provider_thread_id, now_ms(), self.thread_id.clone()],
+            ))
+            .map_err(|error| error.to_string())?;
+        Ok(())
+    }
+
+    pub fn record(&self, event_type: &str, payload: &Value) -> Result<(), String> {
+        let turn_id = payload
+            .get("turnId")
+            .and_then(Value::as_str)
+            .map(str::to_owned);
+        self.runtime
+            .block_on(self.connection.execute(
+                "INSERT INTO events(
+                    thread_id, turn_id, event_type, payload_json, created_at_ms
+                 ) VALUES (?1, ?2, ?3, ?4, ?5)",
+                params![
+                    self.thread_id.clone(),
+                    turn_id,
+                    event_type,
+                    payload.to_string(),
+                    now_ms()
+                ],
+            ))
+            .map_err(|error| error.to_string())?;
+        if event_type == "content.user"
+            && let Some(text) = payload.get("text").and_then(Value::as_str)
+        {
+            let title = text.chars().take(80).collect::<String>();
+            self.runtime
+                .block_on(self.connection.execute(
+                    "UPDATE threads
+                     SET title = ?1
+                     WHERE id = ?2 AND title = 'New conversation'",
+                    params![title, self.thread_id.clone()],
+                ))
+                .map_err(|error| error.to_string())?;
+        }
+        self.runtime
+            .block_on(self.connection.execute(
+                "UPDATE threads SET updated_at_ms = ?1 WHERE id = ?2",
+                params![now_ms(), self.thread_id.clone()],
+            ))
+            .map_err(|error| error.to_string())?;
+        Ok(())
+    }
+
+    pub fn history(&self) -> Result<Vec<Value>, String> {
+        let mut events = self
+            .runtime
+            .block_on(async {
+                let mut rows = self
+                    .connection
+                    .query(
+                        "SELECT event_type, payload_json
+                         FROM events
+                         WHERE thread_id = ?1
+                           AND event_type IN (
+                               'content.user',
+                               'content.delta',
+                               'item.started',
+                               'plan.updated',
+                               'runtime.warning'
+                           )
+                         ORDER BY id DESC
+                         LIMIT 500",
+                        params![self.thread_id.clone()],
+                    )
+                    .await?;
+                let mut events = Vec::new();
+                while let Some(row) = rows.next().await? {
+                    let event_type = row.get::<String>(0)?;
+                    let payload = row.get::<String>(1)?;
+                    events.push(json!({
+                        "type": event_type,
+                        "payload": serde_json::from_str::<Value>(&payload).unwrap_or(Value::Null)
+                    }));
+                }
+                Ok::<_, turso::Error>(events)
+            })
+            .map_err(|error| error.to_string())?;
+        events.reverse();
+        Ok(events)
+    }
+
+    pub fn summary(&self) -> Value {
+        json!({
+            "localThreadId": self.local_thread_id(),
+            "documentId": self.document_id,
+            "provider": self.provider
+        })
+    }
+}
