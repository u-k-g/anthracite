+
+QJsonObject AgentBridge::documentContext()
+{
+    const auto* document = App::GetApplication().getActiveDocument();
+    if (!document) {
+        if (unsavedDocumentKey.isEmpty()) {
+            unsavedDocumentKey = QUuid::createUuid().toString(QUuid::WithoutBraces);
+        }
+        return {
+            {"displayName", tr("Unsaved FreeCAD document")},
+            {"sessionKey", unsavedDocumentKey},
+        };
+    }
+
+    const QString name = QString::fromUtf8(document->getName());
+    if (name != unsavedDocumentName || unsavedDocumentKey.isEmpty()) {
+        unsavedDocumentName = name;
+        unsavedDocumentKey = QUuid::createUuid().toString(QUuid::WithoutBraces);
+    }
+
+    const QString fileName = QString::fromStdString(document->getFileName());
+    return {
+        {"path", fileName},
+        {"displayName", fileName.isEmpty() ? name : QFileInfo(fileName).fileName()},
+        {"sessionKey", unsavedDocumentKey},
+    };
+}
