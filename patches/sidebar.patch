+    currentDraft.clear();
+    composerTokens.clear();
+    renderComposer();
+    Q_EMIT attachmentsChanged();
+    Q_EMIT draftChanged();
+    Q_EMIT draftEdited(currentDraft);
+    Q_EMIT busyChanged();
+}
+
+void SidebarController::loadAttachments(const QVariantList& attachments)
+{
+    ++composerGeneration;
+    currentAttachments = attachments;
+    composerTokens.clear();
+    for (auto& item : currentAttachments) {
+        auto token = item.toMap();
+        if (token.value("type").toString() != QLatin1String("cad")) continue;
+        if (token.value("id").toString().isEmpty()) token.insert("id", QUuid::createUuid().toString(QUuid::WithoutBraces));
+        if (token.value("token").toString().isEmpty()) token.insert("token", QStringLiteral("@[%1]").arg(token.value("name").toString()));
+        composerTokens.insert(token.value("id").toString(), token);
+        item = token;
+    }
+    renderComposer();
+    Q_EMIT attachmentsChanged();
+}
+
+void SidebarController::addAttachment(const QVariantMap& attachment)
+{
+    if (currentAttachments.size() >= 8) {
+        appendActivity(tr("At most 8 attachments per message. Remove one first."));
+        return;
+    }
+    qsizetype size = attachment.value("dataUrl").toString().size();
+    for (const auto& item : currentAttachments) {
+        size += item.toMap().value("dataUrl").toString().size();
+    }
+    if (size > 24 * 1024 * 1024) {
+        appendActivity(tr("Images exceed the 24 MiB message limit."));
+        return;
+    }
+    if (attachment.value("type").toString() == QLatin1String("cad")) {
+        insertPick(attachment);
+        return;
+    }
+    currentAttachments.append(attachment);
+    Q_EMIT attachmentsChanged();
+    Q_EMIT draftEdited(currentDraft);
+}
+
+void SidebarController::removeAttachment(int index)
+{
+    if (index < 0 || index >= currentAttachments.size() || turnBusy) return;
+    const auto removed = currentAttachments.takeAt(index).toMap();
+    if (removed.value("type").toString() == QLatin1String("cad")) {
+        setDraft(QString(currentDraft).replace(removed.value("token").toString(), QString()));
+        Q_EMIT draftChanged();
+    }
+    Q_EMIT attachmentsChanged();
+    Q_EMIT draftEdited(currentDraft);
+}
