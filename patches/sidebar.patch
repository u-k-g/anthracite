+bool SidebarController::reducedMotion() const
+{
+    const auto preferences = App::GetApplication().GetParameterGroupByPath(
+        "User parameter:BaseApp/Preferences/Mod/Anthracite");
+    if (preferences->GetBool("ReduceMotion", false)) return true;
+#ifdef Q_OS_MACOS
+    if (anthraciteSystemReducedMotion()) return true;
+#endif
+    return qApp->style()->styleHint(QStyle::SH_Widget_Animation_Duration) == 0;
+}
