+set(AnthraciteRuntime_TARGET_DIR ${CMAKE_CURRENT_BINARY_DIR}/runtime-target)
+set(AnthraciteRuntime_BUILD_BINARY
+    ${AnthraciteRuntime_TARGET_DIR}/release/anthracite-runtime${CMAKE_EXECUTABLE_SUFFIX}
+)
+set(AnthraciteRuntime_BINARY
+    ${CMAKE_BINARY_DIR}/Mod/Anthracite/anthracite-runtime${CMAKE_EXECUTABLE_SUFFIX}
+)
+
+add_custom_command(
+    OUTPUT ${AnthraciteRuntime_BINARY}
+    COMMAND
+        ${CARGO_EXECUTABLE} build
+        --locked
+        --release
+        --manifest-path ${AnthraciteRuntime_SOURCE_DIR}/Cargo.toml
+        --target-dir ${AnthraciteRuntime_TARGET_DIR}
+    COMMAND
+        ${CMAKE_COMMAND} -E copy_if_different
+        ${AnthraciteRuntime_BUILD_BINARY}
+        ${AnthraciteRuntime_BINARY}
+    DEPENDS
+        ${AnthraciteRuntime_SOURCE_DIR}/Cargo.lock
+        ${AnthraciteRuntime_SOURCE_DIR}/Cargo.toml
+        ${AnthraciteRuntime_SOURCE_DIR}/src/main.rs
+        ${AnthraciteRuntime_SOURCE_DIR}/src/composer.rs
+        ${AnthraciteRuntime_SOURCE_DIR}/src/process.rs
+        ${AnthraciteRuntime_SOURCE_DIR}/src/protocol.rs
+        ${AnthraciteRuntime_SOURCE_DIR}/src/store.rs
+        ${AnthraciteRuntime_SOURCE_DIR}/src/timeline.rs
+        ${AnthraciteRuntime_SOURCE_DIR}/src/providers/mod.rs
+        ${AnthraciteRuntime_SOURCE_DIR}/src/providers/codex.rs
+        ${AnthraciteRuntime_SOURCE_DIR}/src/providers/opencode.rs
+    COMMENT "Building Anthracite agent runtime"
+    VERBATIM
+)
+
+add_custom_target(AnthraciteRuntime ALL DEPENDS ${AnthraciteRuntime_BINARY})
+
+# Content-address the resource path, not a URL query (Qt's disk-cache key strips
+# queries). Fixed RCC timestamps must never reuse a previous component definition.
+set(AnthraciteQml_FINGERPRINT "")
+foreach(component Main TranscriptView TranscriptText ActivityEntry AgentSettings StatusBar Hint UserNotifications ConsoleNavigation)
+    set(qml_file ${CMAKE_CURRENT_SOURCE_DIR}/Resources/qml/${component}.qml)
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${qml_file})
+    file(SHA256 ${qml_file} qml_hash)
+    string(APPEND AnthraciteQml_FINGERPRINT ${qml_hash})
+endforeach()
+string(SHA256 AnthraciteQml_VERSION ${AnthraciteQml_FINGERPRINT})
+set(AnthraciteIcon_RESOURCES "")
+foreach(icon hexagon color-picker plus nav-arrow-down nav-arrow-left nav-arrow-right arrow-down check xmark terminal)
+    string(APPEND AnthraciteIcon_RESOURCES "<file alias=\"${icon}.svg\">${CMAKE_CURRENT_SOURCE_DIR}/Resources/icons/${icon}.svg</file>\n")
+endforeach()
+configure_file(Resources/Anthracite.qrc ${CMAKE_CURRENT_BINARY_DIR}/Anthracite.qrc @ONLY)
+qt_add_resources(AnthraciteGui_QRC ${CMAKE_CURRENT_BINARY_DIR}/Anthracite.qrc)
+
+set(AnthraciteGui_SRCS
+    ${AnthraciteGui_QRC}
+    AgentBridge.cpp
+    AgentBridge.h
+    AppAnthraciteGui.cpp
+    Command.cpp
+    Chrome.cpp
+    Chrome.h
+    ConversationModel.cpp
+    Composer.cpp
+    ConversationModel.h
+    Sidebar.cpp
+    Sidebar.h
+)
+
+add_library(AnthraciteGui SHARED ${AnthraciteGui_SRCS})
+if(APPLE)
+    # Keep Objective-C++ local; enabling another project-wide language from a
+    # module changes how upstream's unrelated .mm sources are generated.
+    set_source_files_properties(MotionMac.mm PROPERTIES LANGUAGE CXX COMPILE_FLAGS "-x objective-c++")
+    target_sources(AnthraciteGui PRIVATE MotionMac.mm)
+    target_link_libraries(AnthraciteGui PRIVATE "-framework AppKit")
+endif()
+target_compile_definitions(AnthraciteGui PRIVATE ANTHRACITE_QML_VERSION="${AnthraciteQml_VERSION}")
+add_dependencies(AnthraciteGui AnthraciteRuntime)
+
+target_include_directories(
+    AnthraciteGui
+    PRIVATE
+    ${CMAKE_BINARY_DIR}
+    ${CMAKE_SOURCE_DIR}/src
+    ${CMAKE_BINARY_DIR}/src
+    ${CMAKE_CURRENT_BINARY_DIR}
+)
+
+target_link_libraries(
+    AnthraciteGui
+    PRIVATE
+    FreeCADGui
+    Qt${FREECAD_QT_MAJOR_VERSION}::Qml
+    Qt${FREECAD_QT_MAJOR_VERSION}::Quick
+    Qt${FREECAD_QT_MAJOR_VERSION}::QuickWidgets
+    Qt${FREECAD_QT_MAJOR_VERSION}::Concurrent
+)
+
+if(FREECAD_WARN_ERROR)
+    target_compile_warn_error(AnthraciteGui)
+endif()
+
+SET_BIN_DIR(AnthraciteGui AnthraciteGui /Mod/Anthracite)
+SET_PYTHON_PREFIX_SUFFIX(AnthraciteGui)
+
+install(TARGETS AnthraciteGui DESTINATION ${CMAKE_INSTALL_LIBDIR})
+install(PROGRAMS ${AnthraciteRuntime_BINARY} DESTINATION Mod/Anthracite)
+install(FILES Resources/qml/Main.qml DESTINATION Mod/Anthracite/qml)
