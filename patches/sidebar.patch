+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "Sidebar.h"
+
+#include "AgentBridge.h"
+
+#include <QDockWidget>
+#include <QQmlContext>
+#include <QQuickWidget>
+#include <QUrl>
