+void AgentBridge::processFinished(int exitCode, QProcess::ExitStatus exitStatus)
+{
+    runtimeReady = false;
+    if (!stopping && sidebar->busy()) {
+        const QString reason = exitStatus == QProcess::CrashExit
+            ? tr("Agent runtime crashed.")
+            : tr("Agent runtime exited with code %1.").arg(exitCode);
+        fail(reason);
+    }
