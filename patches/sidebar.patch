+void SidebarController::setPicking(bool active)
+{
+    if (pickActive == active) return;
+    pickActive = active;
+    if (active) {
+        QApplication::setOverrideCursor(Qt::CrossCursor);
+        qApp->installEventFilter(this);
+    } else {
+        qApp->removeEventFilter(this);
+        QApplication::restoreOverrideCursor();
+    }
+    Q_EMIT pickingChanged();
+}
+
+bool SidebarController::eventFilter(QObject* watched, QEvent* event)
+{
+    if (pickActive && ((event->type() == QEvent::KeyPress && static_cast<QKeyEvent*>(event)->key() == Qt::Key_Escape)
+        || (event->type() == QEvent::MouseButtonPress && static_cast<QMouseEvent*>(event)->button() == Qt::RightButton))) {
+        setPicking(false);
+        return true;
+    }
+    return QObject::eventFilter(watched, event);
+}
