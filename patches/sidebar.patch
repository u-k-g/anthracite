+// Adapt FreeCAD's native user-message stream to QML; ReportOutput owns console logs.
+class UserNotifications final: public QStringListModel, public Base::ILogger {
+public:
+    explicit UserNotifications(QObject* parent) : QStringListModel(parent) {
+        setObjectName(QStringLiteral("AnthraciteUserNotifications"));
+        bNotification = true;
+        Base::Console().attachObserver(this);
+    }
+    ~UserNotifications() override { Base::Console().detachObserver(this); }
+    const char* name() override { return "AnthraciteUserNotifications"; }
+    void sendLog(const std::string& notifier, const std::string& message,
+                 Base::LogStyle level, Base::IntendedRecipient recipient,
+                 Base::ContentType content) override {
+        if (recipient != Base::IntendedRecipient::User && content != Base::ContentType::Translated)
+            return;
+        QString text = content == Base::ContentType::Translated
+            ? QString::fromStdString(message)
+            : QCoreApplication::translate("Notifications", message.c_str());
+        if (text.trimmed().isEmpty()) return;
+        const QString severity = level == Base::LogStyle::Error || level == Base::LogStyle::Critical
+            ? tr("Error") : level == Base::LogStyle::Warning ? tr("Warning") : tr("Notification");
+        const QString entry = QStringLiteral("%1 · %2 · %3\n%4")
+            .arg(QDateTime::currentDateTime().toString(QStringLiteral("HH:mm:ss")), severity,
+                 QString::fromStdString(notifier), text.trimmed());
+        QMetaObject::invokeMethod(this, [this, entry]() {
+            const int row = rowCount();
+            insertRow(row);
+            setData(index(row), entry);
+        }, Qt::QueuedConnection);
+    }
+};
+
+class HiddenTitleBar: public QWidget {
+public:
+    using QWidget::QWidget;
+    QSize sizeHint() const override { return {0, 0}; }
+    QSize minimumSizeHint() const override { return {0, 0}; }
+};
