+class Chrome: public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(QString latestMessage READ latestMessage NOTIFY changed)
+    Q_PROPERTY(QString coordinates READ coordinates NOTIFY changed)
+    Q_PROPERTY(QString coordinateSource READ coordinateSource NOTIFY changed)
+    Q_PROPERTY(bool chatVisible READ chatVisible NOTIFY changed)
