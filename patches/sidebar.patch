+    Q_PROPERTY(QString textColor READ textColor NOTIFY changed)
+    Q_PROPERTY(QString backgroundColor READ backgroundColor NOTIFY changed)
+    Q_PROPERTY(QString midColor READ midColor NOTIFY changed)
+public:
+    explicit Chrome(QObject* parent = nullptr);
+    QString latestMessage() const { return latest; }
+    QString coordinates() const { return position; }
+    QString coordinateSource() const { return source; }
+    // QML's SystemPalette does not follow the applied application palette reliably
+    // once the module owns no other QQuickWidget, so expose the theme roles directly.
+    QString accentColor() const;
+    QString textColor() const;
+    QString backgroundColor() const;
+    QString midColor() const;
+    Q_INVOKABLE void toggleConsole();
+Q_SIGNALS:
+    void changed();
+protected:
+    bool eventFilter(QObject* watched, QEvent* event) override;
+private:
+    void updatePosition();
+    QString latest;
+    QString position;
+    QString source;
+};
+void installChrome();
+}
