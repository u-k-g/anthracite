+QString SidebarController::operationObservation(const QVariantMap& operation) const
+{
+    QStringList parts;
+    const QString stdoutText = operation.value("stdout").toString().trimmed();
+    if (!stdoutText.isEmpty()) parts.append(stdoutText);
+    const QString stderrText = operation.value("stderr").toString().trimmed();
+    if (!stderrText.isEmpty()) parts.append(stderrText);
+    const QVariant error = operation.value("error");
+    if (error.isValid() && !error.isNull()) {
+        const QString message = error.toMap().value("message").toString();
+        parts.append(message.isEmpty() ? error.toString() : message);
+    }
+    if (operation.value("conflict").toBool()) {
+        parts.append(tr("Document changed; inspect before editing."));
+    }
+    if (operation.value("requiresInspection").toBool()) {
+        parts.append(tr("Result requires inspection before trusting it."));
+    }
+    return parts.join(QStringLiteral("\n\n"));
+}
+
+void SidebarController::pushOperation(const QVariantMap& operation, const QVariantList& images)
+{
+    const QString id = operation.value("id").toString();
+    if (id.isEmpty()) return;
+
+    const QString status = operation.value("status").toString();
+    const QString label = operation.value("label").toString();
+    const QString document = operation.value("document").toString();
+    QString summary = status.isEmpty() ? tr("Operation") : status;
+    if (!label.isEmpty()) summary += QStringLiteral(" · ") + label;
+    if (!document.isEmpty()) summary += QStringLiteral(" · ") + document;
+    const QVariant revisionBefore = operation.value("revisionBefore");
+    const QVariant revisionAfter = operation.value("revisionAfter");
+    if (!revisionBefore.isNull() || !revisionAfter.isNull()) {
+        summary += QStringLiteral(" · r%1→r%2").arg(revisionBefore.toInt()).arg(revisionAfter.toInt());
+    }
+    const int duration = operation.value("durationMs").toInt();
+    if (duration > 0) summary += QStringLiteral(" · %1 ms").arg(duration);
+
+    QVariantList entries;
+    const QString code = operation.value("code").toString();
+    if (!code.trimmed().isEmpty()) {
+        entries.append(QVariantMap {
+            {QStringLiteral("kind"), QStringLiteral("text")},
+            {QStringLiteral("title"), tr("Code")},
+            {QStringLiteral("content"), code},
+        });
+    }
+    const QString observation = operationObservation(operation);
+    if (!observation.isEmpty()) {
+        entries.append(QVariantMap {
+            {QStringLiteral("kind"), QStringLiteral("text")},
+            {QStringLiteral("title"), tr("Observation")},
+            {QStringLiteral("content"), observation},
+        });
+    }
+    for (const auto& image : images) {
+        const QString dataUrl = image.toString();
+        if (dataUrl.isEmpty()) continue;
+        entries.append(QVariantMap {
+            {QStringLiteral("kind"), QStringLiteral("image")},
+            {QStringLiteral("title"), tr("After")},
+            {QStringLiteral("body"), dataUrl},
+        });
+    }
+
+    const QVariantMap row {
+        {QStringLiteral("id"), id},
+        {QStringLiteral("author"), summary},
+        {QStringLiteral("body"), QString()},
+        {QStringLiteral("kind"), QStringLiteral("work")},
+        {QStringLiteral("title"), summary},
+        {QStringLiteral("entries"), entries},
+        {QStringLiteral("entryCount"), entries.size()},
+    };
+    if (conversation.indexOfId(id) >= 0) {
+        conversation.apply({{QStringLiteral("op"), QStringLiteral("update")}, {QStringLiteral("row"), row}});
+    }
+    else {
+        conversation.apply({{QStringLiteral("op"), QStringLiteral("append")}, {QStringLiteral("row"), row}});
+    }
+}
