+void AgentBridge::submit(const QString& prompt)
+{
+    queuedAttachments = QJsonArray::fromVariantList(sidebar->attachments());
+    const auto gil = PyGILState_Ensure();
+    PyObject* module = PyImport_ImportModule("AnthraciteExecutor");
+    const auto encoded = QJsonDocument(queuedAttachments).toJson(QJsonDocument::Compact);
+    PyObject* checked = module ? PyObject_CallMethod(module, "validate_picks_json", "s", encoded.constData()) : nullptr;
+    const QString error = checked ? QString() : pythonError();
+    Py_XDECREF(checked);
+    Py_XDECREF(module);
+    PyGILState_Release(gil);
+    if (!error.isEmpty()) {
+        queuedPrompt.clear();
+        queuedAttachments = {};
+        awaitingSubmission = false;
+        sidebar->failTurn(error + tr(" Remove the stale reference and pick again."));
+        return;
+    }
+    queuedPrompt = prompt;
+    stopping = false;
+
+    if (runtimeReady) {
+        QJsonObject payload {{"prompt", queuedPrompt}, {"attachments", queuedAttachments}};
+        if (!selectedModel.isEmpty()) {
+            payload.insert(QStringLiteral("model"), selectedModel);
+        }
+        if (!selectedEffort.isEmpty()) {
+            payload.insert(QStringLiteral("effort"), selectedEffort);
+        }
+        send(QStringLiteral("turn.start"), payload);
+        awaitingSubmission = true;
+        queuedPrompt.clear();
+        return;
+    }
+
+    ensureRuntime();
+}
+
+void AgentBridge::stop()
+{
+    stopping = true;
+    if (!awaitingSubmission && (!queuedPrompt.isEmpty() || !queuedAttachments.isEmpty())) {
+        queuedPrompt.clear();
+        queuedAttachments = {};
+        sidebar->completeTurn();
+        return;
+    }
+    send(QStringLiteral("turn.interrupt"));
+}
