+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+import QtQuick 2.15
+import QtQuick.Controls 2.15
+import QtQuick.Layouts 1.15
+
+Pane {
+    id: root
+
+    padding: 0
+
+    SystemPalette {
+        id: systemPalette
+        colorGroup: SystemPalette.Active
+    }
+
+    background: Rectangle {
+        color: systemPalette.window
+    }
+
+    ColumnLayout {
+        anchors.fill: parent
+        spacing: 0
+
+        Rectangle {
+            Layout.fillWidth: true
+            Layout.preferredHeight: 78
+            color: systemPalette.window
+
+            ColumnLayout {
+                anchors.fill: parent
+                anchors.leftMargin: 14
+                anchors.rightMargin: 14
+                anchors.topMargin: 8
+                anchors.bottomMargin: 8
+                spacing: 4
+
+                RowLayout {
+                    Layout.fillWidth: true
+
+                    Label {
+                        text: qsTr("Anthracite")
+                        font.pixelSize: 16
+                        font.weight: Font.DemiBold
+                        color: systemPalette.windowText
+                    }
+
+                    Item {
+                        Layout.fillWidth: true
+                    }
+
+                    Rectangle {
+                        implicitWidth: statusLabel.implicitWidth + 16
+                        implicitHeight: 24
+                        radius: 12
+                        color: anthraciteController.busy
+                               ? Qt.rgba(0.30, 0.52, 0.95, 0.18)
+                               : Qt.rgba(0.50, 0.50, 0.50, 0.14)
+
+                        Label {
+                            id: statusLabel
+                            anchors.centerIn: parent
+                            text: anthraciteController.status
+                            font.pixelSize: 11
+                            color: systemPalette.windowText
+                        }
+                    }
+                }
+
+                RowLayout {
+                    Layout.fillWidth: true
+
+                    ComboBox {
+                        id: threadPicker
+                        objectName: "AnthraciteThreadPicker"
+                        Layout.fillWidth: true
+                        model: anthraciteController.threads
+                        textRole: "title"
+                        enabled: !anthraciteController.busy && count > 0
+
+                        currentIndex: {
+                            for (let index = 0; index < count; ++index) {
+                                if (model[index].id === anthraciteController.currentThreadId) {
+                                    return index
+                                }
+                            }
+                            return count > 0 ? 0 : -1
+                        }
+
+                        onActivated: function(index) {
+                            anthraciteController.selectThread(model[index].id)
+                        }
+                    }
+
+                    ToolButton {
+                        id: newThreadButton
+                        objectName: "AnthraciteNewThread"
+                        text: "+"
+                        enabled: !anthraciteController.busy
+                        ToolTip.visible: hovered
+                        ToolTip.text: qsTr("New conversation")
+                        onClicked: anthraciteController.newThread()
+                    }
+                }
+            }
+
+            Rectangle {
+                anchors.bottom: parent.bottom
+                width: parent.width
+                height: 1
+                color: systemPalette.mid
+                opacity: 0.45
+            }
+        }
+
+        ListView {
+            id: timeline
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+            Layout.margins: 10
+            spacing: 9
+            clip: true
+            model: anthraciteController.messages
+
+            onCountChanged: positionViewAtEnd()
+
+            delegate: Item {
+                property bool activityExpanded: false
+                property bool isActivity: kind === "activity"
+
+                width: timeline.width
+                height: bubble.implicitHeight
+
+                Rectangle {
+                    id: bubble
+                    width: parent.width
+                    implicitHeight: messageColumn.implicitHeight + (isActivity ? 12 : 18)
+                    radius: 8
+                    color: kind === "user"
+                           ? Qt.rgba(0.30, 0.52, 0.95, 0.16)
+                             : kind === "error"
+                             ? Qt.rgba(0.90, 0.25, 0.25, 0.15)
+                             : kind === "plan"
+                               ? Qt.rgba(0.38, 0.63, 0.42, 0.14)
+                             : kind === "activity"
+                               ? Qt.rgba(0.50, 0.50, 0.50, 0.10)
+                               : Qt.rgba(0.50, 0.50, 0.50, 0.07)
+
+                    Column {
+                        id: messageColumn
+                        anchors.left: parent.left
+                        anchors.right: parent.right
+                        anchors.top: parent.top
+                        anchors.margins: isActivity ? 6 : 9
+                        spacing: 5
+
+                        Label {
+                            visible: !isActivity
+                            text: author
+                            font.pixelSize: 11
+                            font.weight: Font.DemiBold
+                            color: systemPalette.windowText
+                            opacity: 0.72
+                        }
+
+                        Label {
+                            width: parent.width
+                            text: isActivity ? (activityExpanded ? "⌄  " : "›  ") + body : body
+                            wrapMode: Text.Wrap
+                            maximumLineCount: isActivity && !activityExpanded ? 1 : 1000
+                            elide: isActivity && !activityExpanded ? Text.ElideRight : Text.ElideNone
+                            textFormat: Text.PlainText
+                            color: systemPalette.windowText
+                            opacity: isActivity ? 0.78 : 1.0
+                        }
+                    }
+
+                    MouseArea {
+                        anchors.fill: parent
+                        visible: isActivity
+                        cursorShape: Qt.PointingHandCursor
+                        onClicked: activityExpanded = !activityExpanded
+                    }
+                }
+            }
+
+            ScrollBar.vertical: ScrollBar {}
+        }
+
+        Rectangle {
+            id: interactionCard
+            objectName: "AnthraciteInteractionCard"
+            visible: anthraciteController.interactionPending
+            Layout.fillWidth: true
+            Layout.leftMargin: 10
+            Layout.rightMargin: 10
+            Layout.bottomMargin: 8
+            Layout.preferredHeight: Math.min(320, interactionContent.implicitHeight + 22)
+            radius: 8
+            color: Qt.rgba(0.78, 0.57, 0.18, 0.13)
+            border.color: Qt.rgba(0.78, 0.57, 0.18, 0.48)
+
+            ScrollView {
+                id: interactionScroll
+                anchors.fill: parent
+                anchors.margins: 10
+                clip: true
+
+                ColumnLayout {
+                    id: interactionContent
+                    width: interactionScroll.availableWidth
+                    spacing: 9
+
+                    Label {
+                        Layout.fillWidth: true
+                        text: anthraciteController.interactionTitle
+                        font.weight: Font.DemiBold
+                        color: systemPalette.windowText
+                    }
+
+                    Label {
+                        visible: text.length > 0
+                        Layout.fillWidth: true
+                        text: anthraciteController.interactionDetail
+                        wrapMode: Text.Wrap
+                        color: systemPalette.windowText
+                    }
+
+                    RowLayout {
+                        visible: anthraciteController.interactionKind === "approval"
+                        Layout.fillWidth: true
+
+                        Button {
+                            text: qsTr("Decline")
+                            onClicked: anthraciteController.respondToApproval("decline")
+                        }
+
+                        Item {
+                            Layout.fillWidth: true
+                        }
+
+                        Button {
+                            text: qsTr("Approve once")
+                            highlighted: true
+                            onClicked: anthraciteController.respondToApproval("approve")
+                        }
+
+                        Button {
+                            visible: anthraciteController.interactionAllowSession
+                            text: qsTr("Approve session")
+                            onClicked: anthraciteController.respondToApproval("approve_session")
+                        }
+                    }
+
+                    ColumnLayout {
+                        id: requestedInput
+                        objectName: "AnthraciteRequestedInput"
+                        visible: anthraciteController.interactionKind === "user_input"
+                        Layout.fillWidth: true
+                        spacing: 12
+
+                        Repeater {
+                            model: anthraciteController.interactionQuestions
+
+                            delegate: ColumnLayout {
+                                property var questionData: modelData
+                                Layout.fillWidth: true
+                                spacing: 5
+
+                                Label {
+                                    Layout.fillWidth: true
+                                    text: questionData.header || ""
+                                    font.pixelSize: 11
+                                    font.weight: Font.DemiBold
+                                    color: systemPalette.windowText
+                                    opacity: 0.72
+                                }
+
+                                Label {
+                                    Layout.fillWidth: true
+                                    text: questionData.question || ""
+                                    wrapMode: Text.Wrap
+                                    color: systemPalette.windowText
+                                }
+
+                                Repeater {
+                                    model: questionData.options || []
+
+                                    delegate: Button {
+                                        property var optionData: modelData
+                                        Layout.fillWidth: true
+                                        text: optionData.label || ""
+                                        checkable: true
+                                        checked: anthraciteController.inputAnswer(
+                                                     questionData.id) === text
+                                        onClicked: anthraciteController.setInputAnswer(
+                                                       questionData.id, text)
+
+                                        ToolTip.visible: hovered
+                                                             && (optionData.description || "").length > 0
+                                        ToolTip.text: optionData.description || ""
+                                    }
+                                }
+
+                                TextField {
+                                    Layout.fillWidth: true
+                                    placeholderText: qsTr("Or type another answer…")
+                                    echoMode: questionData.isSecret
+                                              ? TextInput.Password
+                                              : TextInput.Normal
+                                    onTextEdited: anthraciteController.setInputAnswer(
+                                                      questionData.id, text)
+                                }
+                            }
+                        }
+
+                        RowLayout {
+                            Layout.fillWidth: true
+
+                            Item {
+                                Layout.fillWidth: true
+                            }
+
+                            Button {
+                                text: qsTr("Answer")
+                                highlighted: true
+                                enabled: anthraciteController.inputComplete
+                                onClicked: anthraciteController.submitInputAnswers()
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        Rectangle {
+            Layout.fillWidth: true
+            Layout.preferredHeight: composerLayout.implicitHeight + 20
+            color: systemPalette.window
+
+            Rectangle {
+                width: parent.width
+                height: 1
+                color: systemPalette.mid
+                opacity: 0.45
+            }
+
+            ColumnLayout {
+                id: composerLayout
+                anchors.left: parent.left
+                anchors.right: parent.right
+                anchors.bottom: parent.bottom
+                anchors.margins: 10
+                spacing: 8
+
+                TextArea {
+                    id: composer
+                    objectName: "AnthraciteComposer"
+                    Layout.fillWidth: true
+                    Layout.preferredHeight: Math.max(70, Math.min(140, implicitHeight))
+                    placeholderText: qsTr("Describe what you want to make or change…")
+                    wrapMode: TextEdit.Wrap
+                    enabled: !anthraciteController.busy
+                    onTextChanged: anthraciteController.setDraft(text)
+
+                    Keys.onPressed: function(event) {
+                        if ((event.modifiers & (Qt.ControlModifier | Qt.MetaModifier))
+                                && (event.key === Qt.Key_Return || event.key === Qt.Key_Enter)) {
+                            send()
+                            event.accepted = true
+                        }
+                    }
+                }
+
+                Connections {
+                    target: anthraciteController
+
+                    function onDraftChanged() {
+                        if (composer.text !== anthraciteController.draft) {
+                            composer.text = anthraciteController.draft
+                        }
+                    }
+                }
+
+                RowLayout {
+                    id: modelControls
+                    objectName: "AnthraciteModelControls"
+                    visible: anthraciteController.modelControlsAvailable
+                             || anthraciteController.usageVisible
+                    Layout.fillWidth: true
+
+                    ComboBox {
+                        id: modelPicker
+                        objectName: "AnthraciteModelPicker"
+                        visible: anthraciteController.modelControlsAvailable
+                        Layout.fillWidth: true
+                        model: anthraciteController.models
+                        textRole: "name"
+                        enabled: !anthraciteController.busy
+
+                        currentIndex: {
+                            for (let index = 0; index < count; ++index) {
+                                if (model[index].model === anthraciteController.selectedModel) {
+                                    return index
+                                }
+                            }
+                            return count > 0 ? 0 : -1
+                        }
+
+                        onActivated: function(index) {
+                            anthraciteController.selectModel(model[index].model)
+                        }
+
+                        ToolTip.visible: hovered && currentIndex >= 0
+                                             && (model[currentIndex].description || "").length > 0
+                        ToolTip.text: currentIndex >= 0
+                                      ? model[currentIndex].description || ""
+                                      : ""
+                    }
+
+                    ComboBox {
+                        id: effortPicker
+                        objectName: "AnthraciteEffortPicker"
+                        visible: anthraciteController.modelControlsAvailable
+                        Layout.preferredWidth: Math.max(105, implicitWidth)
+                        model: anthraciteController.reasoningEfforts
+                        textRole: "label"
+                        enabled: !anthraciteController.busy && count > 0
+
+                        currentIndex: {
+                            for (let index = 0; index < count; ++index) {
+                                if (model[index].id === anthraciteController.selectedEffort) {
+                                    return index
+                                }
+                            }
+                            return count > 0 ? 0 : -1
+                        }
+
+                        onActivated: function(index) {
+                            anthraciteController.selectEffort(model[index].id)
+                        }
+
+                        ToolTip.visible: hovered && currentIndex >= 0
+                                             && (model[currentIndex].description || "").length > 0
+                        ToolTip.text: currentIndex >= 0
+                                      ? model[currentIndex].description || ""
+                                      : ""
+                    }
+
+                    Rectangle {
+                        id: contextUsage
+                        objectName: "AnthraciteContextUsage"
+                        visible: anthraciteController.usageVisible
+                        Layout.preferredWidth: usageText.implicitWidth + 16
+                        Layout.preferredHeight: 30
+                        radius: 6
+                        color: Qt.rgba(0.50, 0.50, 0.50, 0.10)
+
+                        Label {
+                            id: usageText
+                            anchors.centerIn: parent
+                            text: anthraciteController.usageLabel
+                            color: systemPalette.windowText
+                            font.pixelSize: 11
+                            opacity: 0.72
+                        }
+
+                        Rectangle {
+                            anchors.left: parent.left
+                            anchors.bottom: parent.bottom
+                            width: parent.width * anthraciteController.usageFraction
+                            height: 2
+                            radius: 1
+                            color: anthraciteController.usageFraction > 0.8
+                                   ? Qt.rgba(0.90, 0.35, 0.25, 0.9)
+                                   : Qt.rgba(0.30, 0.52, 0.95, 0.9)
+                        }
+
+                        ToolTip.visible: usageHover.containsMouse
+                        ToolTip.text: anthraciteController.usageDetail
+
+                        MouseArea {
+                            id: usageHover
+                            anchors.fill: parent
+                            hoverEnabled: true
+                        }
+                    }
+                }
+
+                RowLayout {
+                    Layout.fillWidth: true
+
+                    ComboBox {
+                        id: providerPicker
+                        objectName: "AnthraciteProviderPicker"
+                        Layout.preferredWidth: Math.max(105, implicitWidth)
+                        model: anthraciteController.providers
+                        textRole: "name"
+                        enabled: !anthraciteController.busy
+
+                        currentIndex: {
+                            for (let index = 0; index < count; ++index) {
+                                if (model[index].id === anthraciteController.selectedProvider) {
+                                    return index
+                                }
+                            }
+                            return 0
+                        }
+
+                        onActivated: function(index) {
+                            anthraciteController.selectProvider(model[index].id)
+                        }
+                    }
+
+                    ToolButton {
+                        text: qsTr("Configure…")
+                        flat: true
+                        onClicked: anthraciteController.chooseProvider()
+                    }
+
+                    Item {
+                        Layout.fillWidth: true
+                    }
+
+                    Button {
+                        visible: anthraciteController.busy
+                        text: qsTr("Stop")
+                        onClicked: anthraciteController.stop()
+                    }
+
+                    Button {
+                        visible: !anthraciteController.busy
+                        text: qsTr("Send")
+                        highlighted: true
+                        enabled: composer.text.trim().length > 0
+                        onClicked: send()
+                    }
+                }
+            }
+        }
+    }
+
+    function send() {
+        const text = composer.text.trim()
+        if (text.length === 0 || anthraciteController.busy) {
+            return
+        }
+        composer.text = ""
+        anthraciteController.submit(text)
+    }
+}
