+namespace {
+// Reproducible RCC timestamps cannot invalidate Qt's disk cache. Give only our
+// embedded components content-addressed URLs; leave FreeCAD's other QML alone.
+class SidebarQmlUrls final : public QObject, public QQmlAbstractUrlInterceptor
+{
+public:
+    explicit SidebarQmlUrls(QObject* parent) : QObject(parent) {}
+    QUrl intercept(const QUrl& url, DataType type) override
+    {
+        if (type != QmlFile || url.scheme() != QLatin1String("qrc")
+            || !url.path().startsWith(QLatin1String("/Anthracite/qml/"))) return url;
+        QUrl versioned(url);
+        versioned.setPath(QStringLiteral("/Anthracite/" ANTHRACITE_QML_VERSION)
+            + url.path().mid(QStringLiteral("/Anthracite").size()));
+        return versioned;
+    }
+};
+}
+
+namespace
+{
+QString pythonError()
+{
+    if (!PyErr_Occurred()) {
+        return QStringLiteral("Unknown embedded Python error.");
+    }
+
+    PyObject* type = nullptr;
+    PyObject* value = nullptr;
+    PyObject* traceback = nullptr;
+    PyErr_Fetch(&type, &value, &traceback);
+    PyErr_NormalizeException(&type, &value, &traceback);
+
+    QString result = QStringLiteral("Embedded Python error.");
+    if (value) {
+        PyObject* text = PyObject_Str(value);
+        if (text) {
+            result = QString::fromUtf8(PyUnicode_AsUTF8(text));
+            Py_DECREF(text);
+        }
+    }
+
+    Py_XDECREF(type);
+    Py_XDECREF(value);
+    Py_XDECREF(traceback);
+    return result;
+}
+}  // namespace
+
+SidebarController::SidebarController(QObject* parent)
+    : QObject(parent)
+    , conversation(this)
+{
+    toastTimer.setSingleShot(true);
+    toastTimer.setInterval(4000);
+    connect(&toastTimer, &QTimer::timeout, this, [this]() {
+        if (currentToast.isEmpty()) return;
+        currentToast.clear();
+        Q_EMIT toastChanged();
+    });
+    selectionConnection = Gui::Selection().signalSelectionChanged2.connect(
+        [this](const Gui::SelectionChanges& selection) {
+            if (!pickActive || selection.Type != Gui::SelectionChanges::AddSelection) return;
+            const auto gil = PyGILState_Ensure();
+            PyObject* module = PyImport_ImportModule("AnthraciteExecutor");
+            PyObject* result = module ? PyObject_CallMethod(module, "picked_reference_json", "sssddd",
+                selection.pDocName, selection.pObjectName, selection.pSubName,
+                double(selection.x), double(selection.y), double(selection.z)) : nullptr;
+            const char* encoded = result ? PyUnicode_AsUTF8(result) : nullptr;
+            const auto attachment = encoded ? QJsonDocument::fromJson(encoded).object() : QJsonObject();
+            const QString error = encoded ? QString() : pythonError();
+            Py_XDECREF(result);
+            Py_XDECREF(module);
+            PyGILState_Release(gil);
+            setPicking(false);
+            if (!error.isEmpty()) {
+                showToast(error);
+                return;
+            }
+            QString literal = attachment.value("inspect").toString();
+            if (literal.isEmpty()) {
+                literal = QString::fromUtf8(
+                    QJsonDocument(attachment.value("reference").toObject()).toJson(QJsonDocument::Compact)
+                );
+            }
+            QApplication::clipboard()->setText(literal);
+            showToast(tr("Copied %1").arg(attachment.value("name").toString()));
+        });
+}
