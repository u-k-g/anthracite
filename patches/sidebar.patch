+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonParseError>
+#include <QResource>
+#include <QTimer>
+
+#include <App/Application.h>
+#include <Base/Console.h>
+#include <Base/Interpreter.h>
+#include <Base/PyObjectBase.h>
+#include <Gui/Application.h>
+
+#include "Sidebar.h"
+#include "Chrome.h"
+
+
+void CreateAnthraciteCommands();
+
+void initAnthraciteResources()
+{
+    Q_INIT_RESOURCE(Anthracite);
+}
+
+namespace AnthraciteGui
+{
+class Module: public Py::ExtensionModule<Module>
+{
+public:
+    Module()
+        : Py::ExtensionModule<Module>("AnthraciteGui")
+    {
+        add_varargs_method(
+            "push_activity",
+            &Module::pushActivity,
+            "push_activity(json) -- Append one bridge operation to the activity history."
+        );
+        add_varargs_method(
+            "push_bridge_status",
+            &Module::pushBridgeStatus,
+            "push_bridge_status(json) -- Update the bridge status shown in the sidebar and status bar."
+        );
+        add_varargs_method(
+            "push_parameters",
+            &Module::pushParameters,
+            "push_parameters(json) -- Update the parameters panel."
+        );
+        add_varargs_method(
+            "take_parameter_request",
+            &Module::takeParameterRequest,
+            "take_parameter_request() -- Return and clear a pending parameters-panel request."
+        );
+        initialize("Native GUI integration for Anthracite.");
+    }
+
+private:
+    Py::Object pushActivity(const Py::Tuple& args)
+    {
+        const char* text = nullptr;
+        if (!PyArg_ParseTuple(args.ptr(), "s", &text)) {
+            throw Py::Exception();
+        }
+        QJsonParseError error;
+        const auto document = QJsonDocument::fromJson(QByteArray(text), &error);
+        if (error.error != QJsonParseError::NoError || !document.isObject()) {
+            throw Py::ValueError("push_activity expects a JSON object.");
+        }
+        const auto event = document.object();
+        sidebarController()->pushOperation(
+            event.value(QStringLiteral("operation")).toObject().toVariantMap(),
+            event.value(QStringLiteral("images")).toArray().toVariantList()
+        );
+        return Py::None();
+    }
+
+    Py::Object pushBridgeStatus(const Py::Tuple& args)
+    {
+        const char* text = nullptr;
+        if (!PyArg_ParseTuple(args.ptr(), "s", &text)) {
+            throw Py::Exception();
+        }
+        QJsonParseError error;
+        const auto document = QJsonDocument::fromJson(QByteArray(text), &error);
+        if (error.error != QJsonParseError::NoError || !document.isObject()) {
+            throw Py::ValueError("push_bridge_status expects a JSON object.");
+        }
+        sidebarController()->applyBridgeStatus(document.object().toVariantMap());
+        return Py::None();
+    }
+
+    Py::Object pushParameters(const Py::Tuple& args)
+    {
+        const char* text = nullptr;
+        if (!PyArg_ParseTuple(args.ptr(), "s", &text)) {
+            throw Py::Exception();
+        }
+        QJsonParseError error;
+        const auto document = QJsonDocument::fromJson(QByteArray(text), &error);
+        if (error.error != QJsonParseError::NoError || !document.isObject()) {
+            throw Py::ValueError("push_parameters expects a JSON object.");
+        }
+        sidebarController()->applyParameters(document.object().toVariantMap());
+        return Py::None();
+    }
+
+    Py::Object takeParameterRequest(const Py::Tuple&)
+    {
+        return Py::String(sidebarController()->takeParameterRequest().toStdString());
+    }
+};
+
+PyObject* initModule()
+{
+    return Base::Interpreter().addModule(new Module);
+}
+}  // namespace AnthraciteGui
+
+PyMOD_INIT_FUNC(AnthraciteGui)
+{
+    if (!Gui::Application::Instance) {
+        PyErr_SetString(PyExc_ImportError, "Cannot load AnthraciteGui in console mode.");
+        PyMOD_Return(nullptr);
+    }
+
+    initAnthraciteResources();
+    PyObject* module = AnthraciteGui::initModule();
+    CreateAnthraciteCommands();
+    AnthraciteGui::ensureSidebar();
+    QTimer::singleShot(0, []() { AnthraciteGui::installChrome(); });
+
+    auto preferences = App::GetApplication().GetParameterGroupByPath(
+        "User parameter:BaseApp/Preferences/Mod/Anthracite"
+    );
+    if (!preferences->GetBool("SidebarInitialized", false)) {
+        preferences->SetBool("SidebarInitialized", true);
+        QTimer::singleShot(0, []() { AnthraciteGui::showSidebar(); });
+    }
+
+    Base::Console().log("Loading GUI of Anthracite module... done\n");
+    PyMOD_Return(module);
+}
