+void SidebarController::attachFiles()
+{
+    if (turnBusy) return;
+    for (const auto& path : QFileDialog::getOpenFileNames(QApplication::activeWindow(), tr("Attach images or files"))) {
+        attachFile(path);
+    }
+}
