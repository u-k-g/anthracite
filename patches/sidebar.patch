+void SidebarController::showToast(const QString& message)
+{
+    currentToast = message;
+    toastTimer.start();
+    Q_EMIT toastChanged();
+}
+
+void SidebarController::dismissToast()
+{
+    toastTimer.stop();
+    if (currentToast.isEmpty()) return;
+    currentToast.clear();
+    Q_EMIT toastChanged();
+}
