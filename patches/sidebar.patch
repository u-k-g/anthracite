+QString AgentBridge::providerKind() const
+{
+    const auto preferences = App::GetApplication().GetParameterGroupByPath(preferencePath);
+    const QString configured = QString::fromStdString(preferences->GetASCII("Provider", "codex"));
+    return configured == QLatin1String("opencode") ? configured : QStringLiteral("codex");
+}
