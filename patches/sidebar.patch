+    setObjectName(QStringLiteral("AnthraciteChrome"));
+    latest = tr("Console · No messages yet");
+    position = QStringLiteral("X —   Y —   Z —");
+    connect(chat, &QDockWidget::topLevelChanged, this, [this]() { updateTitleBar(); Q_EMIT changed(); });
+    updateTitleBar();
+    qApp->installEventFilter(this);
+    if (auto* output = Gui::getMainWindow()->findChild<Gui::DockWnd::ReportOutput*>()) {
+        const auto update = [this, output]() {
+            auto block = output->document()->lastBlock();
+            while (block.isValid() && block.text().trimmed().isEmpty()) block = block.previous();
+            if (block.isValid()) {
+                latest = block.text().trimmed().left(2000);
+                Q_EMIT changed();
+            }
+        };
+        connect(output, &QTextEdit::textChanged, this, update);
+        update();
+    }
+    auto* timer = new QTimer(this);
+    timer->setInterval(33);
+    connect(timer, &QTimer::timeout, this, &Chrome::updatePosition);
+    timer->start();
+}
+
+bool Chrome::eventFilter(QObject* watched, QEvent* event)
+{
+    if ((event->type() == QEvent::FontChange || event->type() == QEvent::Show
+         || event->type() == QEvent::ParentChange || event->type() == QEvent::Polish)
+        && watched->inherits("Gui::DimensionWidget")) {
+        auto* widget = static_cast<QWidget*>(watched);
+        const auto style = QStringLiteral("min-width:%1px;").arg(widget->fontMetrics().horizontalAdvance(QStringLiteral("9999.99 mm x 9999.99 mm")) + 32);
+        if (widget->styleSheet() != style) widget->setStyleSheet(style);
+    }
+    if (event->type() == QEvent::ToolTip) {
+        if (auto* button = qobject_cast<QAbstractButton*>(watched); button && !button->toolTip().isEmpty()) {
+            QString text = button->toolTip();
+            if (Qt::mightBeRichText(text)) {
+                QTextDocument document;
+                document.setHtml(text);
+                text = document.toPlainText();
+            }
+            if (text.size() > 220) text = text.left(217) + QStringLiteral("…");
+            const auto bounds = QFontMetrics(QToolTip::font()).boundingRect(
+                QRect(0, 0, 260, 1000), Qt::TextWordWrap, text);
+            QPoint position = button->mapToGlobal(QPoint(button->width() - 12, -bounds.height() - 36));
+            if (position.y() < button->screen()->availableGeometry().top() + 8)
+                position = button->mapToGlobal(QPoint(button->width() - 12, button->height() + 2));
+            QToolTip::showText(position, Qt::convertFromPlainText(text), button, button->rect(), 4500);
+            return true;
+        }
+    }
+    return QObject::eventFilter(watched, event);
+}
+
+void Chrome::updateTitleBar()
+{
+    if (!chat) return;
+    chat->setFeatures(QDockWidget::DockWidgetClosable);
+    chat->setAllowedAreas(Qt::RightDockWidgetArea);
+    if (chat->isFloating()) chat->setFloating(false);
+    auto* previous = chat->titleBarWidget();
+    if (!previous || previous->objectName() != QStringLiteral("AnthraciteHiddenTitleBar")) {
+        auto* empty = new HiddenTitleBar(chat);
+        empty->setObjectName(QStringLiteral("AnthraciteHiddenTitleBar"));
+        empty->setFixedHeight(0);
+        chat->setTitleBarWidget(empty);
+        if (previous) previous->deleteLater();
+    }
+}
+
+void Chrome::toggleConsole()
+{
+    auto* window = Gui::getMainWindow();
+    auto* output = window->findChild<Gui::DockWnd::ReportOutput*>();
+    if (!output) return;
+    QWidget* parent = output;
+    while (parent && !qobject_cast<QDockWidget*>(parent)) parent = parent->parentWidget();
+    auto* dock = qobject_cast<QDockWidget*>(parent);
+    if (!dock) return;
+    const bool show = !dock->isVisible();
+    if (show) {
+        dock->setFloating(false);
+        window->addDockWidget(Qt::BottomDockWidgetArea, dock);
+        dock->show();
+        dock->raise();
+        if (auto* tabs = dock->findChild<QTabWidget*>(QStringLiteral("AnthraciteConsoleTabs")))
+            tabs->currentWidget()->setFocus();
+        else output->setFocus();
+    } else dock->hide();
+}
+
+void Chrome::updatePosition()
+{
+    QString next = QStringLiteral("X —   Y —   Z —");
+    QString origin = tr("Move the cursor over the 3D view");
+    auto* view = dynamic_cast<Gui::View3DInventor*>(Gui::Application::Instance->activeView());
+    if (view && view->isVisible() && qApp->applicationState() == Qt::ApplicationActive) {
+        auto* viewer = view->getViewer();
+        auto* viewport = viewer->viewport();
+        const QPoint local = viewport->mapFromGlobal(QCursor::pos());
+        if (viewport->rect().contains(local) && viewport->underMouse()) {
+            const auto& picked = Gui::Selection().getPreselection();
+            double x, y, z;
+            if (picked.pObjectName && *picked.pObjectName) {
+                x = picked.x; y = picked.y; z = picked.z;
+                origin = tr("Surface · world coordinates in millimetres");
+            } else {
+                const auto size = viewer->getSoRenderManager()->getViewportRegion().getViewportSizePixels();
+                const SbVec2s pixel(short(local.x() * size[0] / qMax(1, viewport->width())),
+                    short((viewport->height() - 1 - local.y()) * size[1] / qMax(1, viewport->height())));
+                const auto point = viewer->getPointOnFocalPlane(pixel);
+                x = point[0]; y = point[1]; z = point[2];
+                origin = tr("View plane · projected world coordinates in millimetres, not a surface hit");
+            }
+            next = QStringLiteral("X %1   Y %2   Z %3  mm").arg(x, 0, 'f', 2).arg(y, 0, 'f', 2).arg(z, 0, 'f', 2);
+        }
+    }
+    if (next != position || origin != source) { position = next; source = origin; Q_EMIT changed(); }
+}
+
+void AnthraciteGui::installChrome()
+{
+    auto* window = Gui::getMainWindow();
+    if (window->findChild<Chrome*>()) return;
+    auto preferences = App::GetApplication().GetParameterGroupByPath("User parameter:BaseApp/Preferences/Mod/Anthracite");
+    // Hide the indicator, not the notification observer: user-only messages
+    // are intentionally excluded from FreeCAD's Report view.
+    auto statusPreferences = App::GetApplication().GetParameterGroupByPath("User parameter:BaseApp/MainWindow/StatusBar");
+    if (!preferences->GetBool("NotificationIndicatorDefaultInitialized", false)) {
+        statusPreferences->SetBool("notificationArea", false);
+        preferences->SetBool("NotificationIndicatorDefaultInitialized", true);
+    }
+    if (auto* notifications = window->findChild<QWidget*>(QStringLiteral("notificationArea")))
+        notifications->setVisible(statusPreferences->GetBool("notificationArea", false));
+    auto windowPreferences = App::GetApplication().GetParameterGroupByPath("User parameter:BaseApp/Preferences/MainWindow");
+    if (preferences->GetBool("UseAnthraciteTheme", true)) {
+        // Native cube settings update existing views and remain user-editable.
+        if (!preferences->GetBool("NaviCubeThemeInitialized", false)) {
+            auto cube = App::GetApplication().GetParameterGroupByPath("User parameter:BaseApp/Preferences/NaviCube");
+            cube->SetUnsigned("BaseColor", 0x292929FF);
+            cube->SetUnsigned("EmphaseColor", 0xE5E1DEFF);
+            cube->SetUnsigned("HiliteColor", 0xA06666FF);
+            preferences->SetBool("NaviCubeThemeInitialized", true);
+        }
+        windowPreferences->SetASCII("OverlayActiveStyleSheet", ":/Anthracite/overlay.qss");
+        QPalette palette = qApp->palette();
+        palette.setColor(QPalette::Window, QColor("#080808"));
+        palette.setColor(QPalette::Base, QColor("#080808"));
+        palette.setColor(QPalette::AlternateBase, QColor("#111111"));
+        palette.setColor(QPalette::Button, QColor("#111111"));
+        palette.setColor(QPalette::WindowText, QColor("#E5E1DE"));
+        palette.setColor(QPalette::Text, QColor("#E5E1DE"));
+        palette.setColor(QPalette::ButtonText, QColor("#E5E1DE"));
+        palette.setColor(QPalette::Highlight, QColor("#A06666"));
+        palette.setColor(QPalette::HighlightedText, QColor("#FFFFFF"));
+        palette.setColor(QPalette::Link, QColor("#C99696"));
+        palette.setColor(QPalette::Mid, QColor("#292929"));
+        palette.setColor(QPalette::ToolTipBase, QColor("#111111"));
+        palette.setColor(QPalette::ToolTipText, QColor("#E5E1DE"));
+        palette.setColor(QPalette::PlaceholderText, QColor("#96918E"));
+        for (const auto role : {QPalette::WindowText, QPalette::Text, QPalette::ButtonText})
+            palette.setColor(QPalette::Disabled, role, QColor("#827D7A"));
+        qApp->setPalette(palette);
+        window->setPalette(palette);
+        // Use FreeCAD's theme parameter source, including its Start page and
+        // native controls. User parameter overrides retain their normal priority.
+        auto* styles = Gui::Application::Instance->styleParameterManager();
+        for (auto* source : styles->sources()) {
+            if (auto* theme = dynamic_cast<Gui::StyleParameters::YamlParameterSource*>(source)) {
+                theme->changeFilePath(":/Anthracite/theme.yaml");
+                break;
+            }
+        }
+        styles->reload();
+        Gui::Application::Instance->setStyleSheet(QStringLiteral("FreeCAD.qss"), false);
+        qApp->setStyleSheet(qApp->styleSheet() + QStringLiteral(
+            "\nQStatusBar{background:palette(window);border-top:1px solid palette(mid);}"
+            "QStatusBar::item{border:0;border-right:1px solid palette(mid);} QToolBar{border:0;spacing:4px;}"
+            "QMainWindow,QMenuBar,QMenu,QToolBar,QDockWidget{background:palette(window);color:palette(window-text);}"
+            "QTreeView{background:transparent;color:palette(text);selection-background-color:palette(highlight);selection-color:palette(highlighted-text);}"
+            "QDockWidget::title{padding:5px;} QMenu{padding:4px;}"
+            "QDockWidget::close-button{image:url(qss:overlay/icons/close.svg);}"
+            "QDockWidget::float-button{image:url(qss:overlay/icons/float.svg);}"
+            "QToolButton:hover{background:palette(mid);border-radius:4px;}"
+            "QToolButton:checked{background:palette(highlight);color:palette(highlighted-text);border-radius:4px;}"));
+        qApp->setStyleSheet(qApp->styleSheet() + QStringLiteral(
+            "#WbTabBar QTabBar::tab:selected{color:palette(window-text);border-bottom:2px solid palette(highlight);}"
+            "#WbTabBar QTabBar::tab:!selected{border-bottom:2px solid transparent;}"));
+        // Tooltips use their own palette roles (including the inactive group).
+        qApp->setStyleSheet(qApp->styleSheet() + QStringLiteral(
+            "QToolTip{background:palette(tool-tip-base);color:palette(tool-tip-text);"
+            "border:1px solid palette(mid);border-radius:5px;padding:5px;max-width:260px;}"));
+    } else if (windowPreferences->GetASCII("OverlayActiveStyleSheet") == ":/Anthracite/overlay.qss") {
+        windowPreferences->SetASCII("OverlayActiveStyleSheet", "");
+    }
+    // One-time defaults for both fresh and existing Anthracite profiles. Later
+    // user adjustments remain authoritative; never reset layout on every launch.
+    if (!preferences->GetBool("ChromeDefaultsInitialized", false)) {
+        auto overlay = App::GetApplication().GetParameterGroupByPath("User parameter:BaseApp/MainWindow/DockWindows/OverlayLeft");
+        overlay->SetASCII("Widgets", "Tree view,Property view,");
+        overlay->SetBool("Transparent", true);
+        overlay->SetBool("AutoHide", false);
+        auto view = App::GetApplication().GetParameterGroupByPath("User parameter:BaseApp/Preferences/View");
+        view->SetBool("Simple", true);
+        view->SetBool("Gradient", false);
+        view->SetBool("RadialGradient", false);
+        view->SetUnsigned("BackgroundColor", 0x080808FF);
+        preferences->SetBool("ChromeDefaultsInitialized", true);
+        Gui::OverlayManager::instance()->reload();
+    }
+    auto* dock = qobject_cast<QDockWidget*>(ensureSidebar()->parentWidget());
+    // Keep the original Report view and its observer alive under a native tab host.
+    if (auto* report = window->findChild<QDockWidget*>(QStringLiteral("Report view"))) {
+        if (!report->findChild<QTabWidget*>(QStringLiteral("AnthraciteConsoleTabs"))) {
+            auto* original = report->widget();
+            if (original) {
+                original->setParent(nullptr);
+                auto* panel = new QWidget(report);
+                auto* layout = new QHBoxLayout(panel);
+                layout->setContentsMargins(0, 0, 0, 0);
+                layout->setSpacing(0);
+                auto* tabs = new QTabWidget(panel);
+                tabs->setObjectName(QStringLiteral("AnthraciteConsoleTabs"));
+                tabs->setDocumentMode(true);
+                tabs->addTab(original, QObject::tr("Console"));
+                auto* notifications = new QQuickWidget(tabs);
+                notifications->setObjectName(QStringLiteral("AnthraciteNotificationsView"));
+                notifications->setResizeMode(QQuickWidget::SizeRootObjectToView);
+                auto* model = new UserNotifications(notifications);
+                notifications->rootContext()->setContextProperty(QStringLiteral("userNotifications"), model);
+                notifications->setSource(QUrl(QStringLiteral("qrc:/Anthracite/" ANTHRACITE_QML_VERSION "/qml/UserNotifications.qml")));
+                tabs->addTab(notifications, QObject::tr("User notifications"));
+                tabs->tabBar()->hide();
+                auto* navigation = new QQuickWidget(panel);
+                navigation->setObjectName(QStringLiteral("AnthraciteConsoleNavigation"));
+                navigation->setFixedWidth(150);
+                navigation->setResizeMode(QQuickWidget::SizeRootObjectToView);
+                navigation->rootContext()->setContextProperty(QStringLiteral("consolePages"), tabs);
+                navigation->setSource(QUrl(QStringLiteral("qrc:/Anthracite/" ANTHRACITE_QML_VERSION "/qml/ConsoleNavigation.qml")));
+                layout->addWidget(navigation);
+                layout->addWidget(tabs, 1);
+                report->setWidget(panel);
+                auto* title = new HiddenTitleBar(report);
+                title->setObjectName(QStringLiteral("AnthraciteConsoleHiddenTitleBar"));
+                title->setFixedHeight(0);
+                report->setTitleBarWidget(title);
+            }
+        }
+    }
+    auto* chrome = new Chrome(dock);
+    auto* bar = new QQuickWidget(window->statusBar());
+    bar->setObjectName(QStringLiteral("AnthraciteStatusBar"));
+    bar->setResizeMode(QQuickWidget::SizeRootObjectToView);
+    bar->setFixedHeight(30);
+    bar->rootContext()->setContextProperty(QStringLiteral("chrome"), chrome);
+    bar->rootContext()->setContextProperty(QStringLiteral("anthraciteController"), sidebarController());
+    bar->setSource(QUrl(QStringLiteral("qrc:/Anthracite/" ANTHRACITE_QML_VERSION "/qml/StatusBar.qml")));
+    // Keep native command hints, progress, and navigation. Only the duplicate
+    // coordinate/measurement label is replaced by the QML coordinate display.
+    for (auto* label : window->statusBar()->findChildren<QLabel*>(QString(), Qt::FindDirectChildrenOnly)) {
+        window->statusBar()->removeWidget(label);
+        if (label->objectName() == QStringLiteral("rightSideLabel")) label->hide();
+        else {
+            label->setMaximumWidth(260);
+            window->statusBar()->addWidget(label, 0);
+        }
+    }
+    window->statusBar()->addPermanentWidget(bar, 1);
+    for (auto* widget : QApplication::allWidgets()) {
+        if (widget->inherits("Gui::DimensionWidget")) {
+            widget->setStyleSheet(QStringLiteral("min-width:%1px;").arg(widget->fontMetrics().horizontalAdvance(QStringLiteral("9999.99 mm x 9999.99 mm")) + 32));
+        }
+    }
+}
