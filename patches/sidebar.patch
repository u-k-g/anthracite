+void AgentBridge::handleMessage(const QJsonObject& message)
+{
+    const QString type = message.value("type").toString();
+    const QJsonObject payload = message.value("payload").toObject();
+    if (type == QLatin1String("thread.local.ready")) {
+        selectedLocalThreadId = payload.value("localThreadId").toString();
+    }
+    else if (type == QLatin1String("thread.list")) {
+        sidebar->updateThreads(
+            payload.value("currentThreadId").toString(),
+            payload.value("threads").toArray().toVariantList()
+        );
+    }
+    else if (type == QLatin1String("timeline.edit")) {
+        sidebar->applyTimelineEdit(payload.toVariantMap());
+    }
+    else if (type == QLatin1String("draft.loaded")) {
+        if (sidebar->busy() || sidebar->processingAttachments() || draftDirty) return;
+        pendingDraft = payload.value("body").toString();
+        draftDirty = false;
+        sidebar->loadDraft(pendingDraft);
+        sidebar->loadAttachments(payload.value("attachments").toArray().toVariantList());
+    }
+    else if (type == QLatin1String("draft.saved")) {
+        const qint64 saveId = payload.value("saveId").toInteger();
+        if (restartPending && saveId == pendingRestartSaveId) {
+            performSessionRestart(pendingRestartThreadId, pendingRestartCreateThread);
+        }
+    }
+    else if (type == QLatin1String("model.selection")) {
+        if (!pendingProvider.isEmpty()) return;
+        selectedModel = payload.value("model").toString();
+        selectedEffort = payload.value("effort").toString();
+        sidebar->restoreModelSelection(selectedModel, selectedEffort);
+        selectedModel = sidebar->selectedModel();
+        selectedEffort = sidebar->selectedEffort();
+    }
+    else if (type == QLatin1String("model.catalog")) {
+        if (!pendingProvider.isEmpty()) {
+            runningProviderModels = payload.value("models").toArray().toVariantList();
+            return;
+        }
+        sidebar->updateModelCatalog(payload.value("models").toArray().toVariantList());
+        selectedModel = sidebar->selectedModel();
+        selectedEffort = sidebar->selectedEffort();
+    }
+    else if (type == QLatin1String("usage.updated")) {
+        sidebar->updateUsage(payload.toVariantMap());
+    }
+    else if (type == QLatin1String("runtime.ready")) {
+        runtimeReady = true;
+        sidebar->appendActivity(
+            tr("%1 connected").arg(
+                payload.value("provider").toString() == QLatin1String("opencode")
+                    ? QStringLiteral("OpenCode")
+                    : QStringLiteral("Codex")
+            )
+        );
+        sidebar->updateStatus(queuedPrompt.isEmpty() ? tr("Ready") : tr("Thinking"));
+        persistDraft();
+        if (!queuedPrompt.isEmpty() || !queuedAttachments.isEmpty()) {
+            submit(queuedPrompt);
+        }
+    }
+    else if (type == QLatin1String("content.delta")) {
+        sidebar->updateStatus(tr("Responding"));
+    }
+    else if (type == QLatin1String("tool.call")) {
+        // Inspect without executing model code. The runtime must durably acknowledge
+        // this context before sending tool.execute.
+        const PyGILState_STATE state = PyGILState_Ensure();
+        PyObject* module = PyImport_ImportModule("AnthraciteExecutor");
+        PyObject* context = module ? PyObject_CallMethod(module, "context_json", nullptr) : nullptr;
+        const char* encoded = context ? PyUnicode_AsUTF8(context) : nullptr;
+        const QByteArray bytes = encoded ? QByteArray(encoded) : QByteArray();
+        const QString error = encoded ? QString() : pythonError();
+        Py_XDECREF(context);
+        Py_XDECREF(module);
+        PyGILState_Release(state);
+        const auto document = QJsonDocument::fromJson(bytes);
+        if (!document.isObject()) {
+            const QJsonObject rejected {
+                {"ok", false},
+                {"notExecuted", true},
+                {"error", QJsonObject {{"type", "PreflightError"}, {"message", error}}},
+            };
+            send(QStringLiteral("tool.result"), {
+                {"requestId", payload.value("requestId")},
+                {"result", QString::fromUtf8(QJsonDocument(rejected).toJson(QJsonDocument::Compact))},
+                {"success", false},
+            });
+            return;
+        }
+        QJsonObject preparation = payload;
+        preparation.insert("context", document.object());
+        send(QStringLiteral("tool.prepare"), preparation);
+    }
+    else if (type == QLatin1String("tool.execute")) {
+        scheduleFreeCADTool(payload, runtime.processId());
+    }
+    else if (type == QLatin1String("request.opened")) {
+        sidebar->showApproval(
+            payload.value("requestId").toString(),
+            payload.value("title").toString(tr("Approval needed")),
+            payload.value("detail").toString(),
+            payload.value("allowSession").toBool()
+        );
+    }
+    else if (type == QLatin1String("user_input.requested")) {
+        sidebar->showUserInput(
+            payload.value("requestId").toString(),
+            payload.value("questions").toArray().toVariantList()
+        );
+    }
+    else if (type == QLatin1String("runtime.warning") && !payload.contains("timestampMs")) {
+        sidebar->appendActivity(payload.value("message").toString());
+    }
+    else if (type == QLatin1String("turn.completed")) {
+        const QString status = payload.value("status").toString();
+        if (status == QLatin1String("failed")) {
+            queuedPrompt.clear();
+            sidebar->failTurn(payload.value("error").toString(tr("The provider turn failed.")),
+                              false);
+        }
+        else {
+            sidebar->completeTurn();
+        }
+    }
+    else if (type == QLatin1String("session.state") && payload.value("state").toString() == QLatin1String("running") && awaitingSubmission) {
+        awaitingSubmission = false;
+        queuedAttachments = {};
+        sidebar->acceptSubmission();
+    }
+    else if (type == QLatin1String("runtime.error")) {
+        queuedPrompt.clear();
+        queuedAttachments = {};
+        awaitingSubmission = false;
+        sidebar->failTurn(payload.value("message").toString(tr("Unknown agent error.")), !payload.contains("timestampMs"));
+    }
+}
+
+void AgentBridge::scheduleFreeCADTool(const QJsonObject& payload, qint64 processId, bool notified)
+{
+    // Do not run stale queued work after its runtime exits or is replaced.
+    if (runtime.state() != QProcess::Running || runtime.processId() != processId) return;
+    if (executingTool || QApplication::mouseButtons() != Qt::NoButton
+        || QApplication::activePopupWidget() || QApplication::activeModalWidget()) {
+        if (!notified) {
+            send(QStringLiteral("tool.progress"), {{"requestId", payload.value("requestId")},
+                {"operationId", payload.value("operationId")}, {"stage", "waiting-for-interaction"}});
+        }
+        QTimer::singleShot(100, this, [this, payload, processId]() {
+            scheduleFreeCADTool(payload, processId, true);
+        });
+        return;
+    }
+    runFreeCADTool(payload);
+}
+
+void AgentBridge::runFreeCADTool(const QJsonObject& payload)
+{
+    Q_ASSERT(QThread::currentThread() == qApp->thread());
+    QScopedValueRollback<bool> executionGuard(executingTool, true);
+    const QString operationId = payload.value("operationId").toString();
+    if (operationId.isEmpty() || executedOperations.contains(operationId)) {
+        fail(tr("Missing or duplicate CAD operation ID; Python was not executed."));
+        return;
+    }
+    executedOperations.insert(operationId);
+    if (documentSyncPending || documentIdentity() != runtimeDocumentIdentity) {
+        send(
+            QStringLiteral("tool.result"),
+            {
+                {"requestId", payload.value("requestId")},
+                {
+                    "result",
+                    QStringLiteral(
+                        R"({"ok":false,"notExecuted":true,"error":{"type":"DocumentContextChanged","message":"The active FreeCAD document changed before this call could run."}})"
+                    ),
+                },
+                {"success", false},
+            }
+        );
+        return;
+    }
+    sidebar->updateStatus(tr("Editing"));
+
+    const auto context = payload.value("context").toObject();
+    if (!context.value("revision").isDouble()) {
+        fail(tr("Missing prepared CAD revision; Python was not executed."));
+        return;
+    }
+    if (!documentRevision) {
+        documentRevision = context.value("revision").toInt();
+    }
+
+    bool success = false;
+    QString result
+        = executePython(payload.value("arguments").toObject().value("code").toString(), success, payload);
+    auto resultDocument = QJsonDocument::fromJson(result.toUtf8());
+    QJsonArray images;
+    if (resultDocument.isObject()) {
+        auto resultObject = resultDocument.object();
+        images = resultObject.take(QStringLiteral("images")).toArray();
+        resultDocument.setObject(resultObject);
+        result = QString::fromUtf8(resultDocument.toJson(QJsonDocument::Compact));
+        if (resultObject.value("revision").isDouble()) {
+            documentRevision = resultObject.value("revision").toInt();
+        }
+    }
+
+    send(
+        QStringLiteral("tool.result"),
+        {
+            {"requestId", payload.value("requestId")},
+            {"result", result},
+            {"success", success},
+            {"images", images},
+        }
+    );
+}
+
+QString AgentBridge::executePython(const QString& source, bool& success, const QJsonObject& payload)
+{
+    success = false;
+    const PyGILState_STATE state = PyGILState_Ensure();
+    PyObject* module = PyImport_ImportModule("AnthraciteExecutor");
+    if (!module) {
+        const QString error = pythonError();
+        PyGILState_Release(state);
+        return QString::fromUtf8(
+            QJsonDocument(
+                QJsonObject {
+                    {"ok", false},
+                    {"error", QJsonObject {{"type", "ImportError"}, {"message", error}}},
+                }
+            )
+                .toJson(QJsonDocument::Compact)
+        );
+    }
+
+    const QByteArray encoded = source.toUtf8();
+    QPointer<AgentBridge> bridge(this);
+    const auto processId = runtime.processId();
+    auto* callback = new ProgressCallback([bridge, payload, processId](const QString& stage) {
+        if (!bridge || bridge->runtime.processId() != processId) return;
+        bridge->send(QStringLiteral("tool.progress"), {{"requestId", payload.value("requestId")},
+            {"operationId", payload.value("operationId")}, {"stage", stage}});
+        // Flush before entering native work, without pumping user events.
+        if (bridge->runtime.bytesToWrite()) bridge->runtime.waitForBytesWritten(1000);
+    });
+    PyObject* capsule = PyCapsule_New(callback, "anthracite.progress", [](PyObject* value) {
+        delete static_cast<ProgressCallback*>(PyCapsule_GetPointer(value, "anthracite.progress"));
+    });
+    PyObject* progress = capsule ? PyCFunction_New(&progressMethod, capsule) : nullptr;
+    if (!capsule) delete callback;
+    Py_XDECREF(capsule);
+    PyObject* result = progress ? PyObject_CallMethod(module, "execute_json", "siO",
+        encoded.constData(), documentRevision.value_or(0), progress) : nullptr;
+    Py_XDECREF(progress);
+    Py_DECREF(module);
+
+    if (!result) {
+        const QString error = pythonError();
+        PyGILState_Release(state);
+        return QString::fromUtf8(
+            QJsonDocument(
+                QJsonObject {
+                    {"ok", false},
+                    {"error", QJsonObject {{"type", "PythonError"}, {"message", error}}},
+                }
+            )
+                .toJson(QJsonDocument::Compact)
+        );
+    }
+
+    const char* encodedResult = PyUnicode_AsUTF8(result);
+    const QString text = encodedResult
+        ? QString::fromUtf8(encodedResult)
+        : QStringLiteral(
+              R"({"ok":false,"error":{"type":"EncodingError","message":"Executor returned non-text."}})"
+          );
+    Py_DECREF(result);
+    PyGILState_Release(state);
+
+    const auto document = QJsonDocument::fromJson(text.toUtf8());
+    success = document.isObject() && document.object().value("ok").toBool();
+    return text;
+}
+
+QString AgentBridge::runtimePath() const
+{
+    return QDir(QString::fromStdString(App::Application::getHomePath()))
+        .filePath(QStringLiteral("Mod/Anthracite/anthracite-runtime"));
+}
+
+QString AgentBridge::providerKind() const
+{
+    const auto preferences = App::GetApplication().GetParameterGroupByPath(preferencePath);
+    const QString configured = QString::fromStdString(preferences->GetASCII("Provider", "codex"));
+    return configured == QLatin1String("opencode") ? configured : QStringLiteral("codex");
+}
+
+QString AgentBridge::providerPath() const
+{
+    return findProviderExecutable(providerKind());
+}
+
+QString AgentBridge::findProviderExecutable(const QString& provider) const
+{
+    const auto preferences = App::GetApplication().GetParameterGroupByPath(preferencePath);
+    const char* key = provider == QLatin1String("opencode") ? "OpenCodeBinary" : "CodexBinary";
+    const QString configured = QString::fromStdString(preferences->GetASCII(key, ""));
+    if (!configured.isEmpty()) {
+        return configured;
+    }
+    const QString executable = QStandardPaths::findExecutable(provider);
+    if (!executable.isEmpty()) {
+        return executable;
+    }
+
+    const QString home = QDir::homePath();
+    const QStringList candidates =
+        provider == QLatin1String("opencode")
+        ? QStringList {
+              QDir(home).filePath(QStringLiteral(".opencode/bin/opencode")),
+              QStringLiteral("/opt/homebrew/bin/opencode"),
+              QStringLiteral("/usr/local/bin/opencode"),
+          }
+        : QStringList {
+              QDir(home).filePath(QStringLiteral(".local/bin/codex")),
+              QStringLiteral("/opt/homebrew/bin/codex"),
+              QStringLiteral("/usr/local/bin/codex"),
+          };
+    for (const QString& candidate : candidates) {
+        if (QFileInfo(candidate).isExecutable()) {
+            return candidate;
+        }
+    }
+
+    QProcess shell;
+#ifdef Q_OS_WIN
+    shell.start(QStringLiteral("cmd.exe"), {QStringLiteral("/C"), QStringLiteral("where"), provider});
+#else
+    const QString shellProgram = QProcessEnvironment::systemEnvironment().value(
+        QStringLiteral("SHELL"),
+        QStringLiteral("/bin/sh")
+    );
+    shell.start(
+        shellProgram,
+        {QStringLiteral("-lc"), QStringLiteral("command -v %1").arg(provider)}
+    );
+#endif
+    if (shell.waitForFinished(2000) && shell.exitCode() == 0) {
+        const QString resolved = QString::fromUtf8(shell.readAllStandardOutput()).trimmed();
+        if (QFileInfo(resolved).isExecutable()) {
+            return resolved;
+        }
+    }
+    return {};
+}
+
+QString AgentBridge::workingDirectory() const
+{
+    if (const auto* document = App::GetApplication().getActiveDocument()) {
+        const std::string fileName = document->getFileName();
+        if (!fileName.empty()) {
+            return QFileInfo(QString::fromStdString(fileName)).absolutePath();
+        }
+    }
+    return QDir::currentPath();
+}
+
+QString AgentBridge::databasePath() const
+{
+    QString root = qEnvironmentVariable("XDG_STATE_HOME");
+    if (root.isEmpty() || !QDir::isAbsolutePath(root)) {
+        root = QDir::home().filePath(QStringLiteral(".local/state"));
+    }
+    return QDir(root).filePath(QStringLiteral("anthracite/anthracite.sqlite3"));
+}
+
+QJsonObject AgentBridge::documentContext()
+{
+    const auto* document = App::GetApplication().getActiveDocument();
+    const QString name = document ? QString::fromUtf8(document->getName()) : QStringLiteral("none");
+    const QString contextKey = document ? QStringLiteral("document:%1").arg(name)
+                                        : QStringLiteral("no-document");
+    QString sessionKey = documentSessionKeys.value(contextKey);
+    if (sessionKey.isEmpty()) {
+        sessionKey = QUuid::createUuid().toString(QUuid::WithoutBraces);
+        documentSessionKeys.insert(contextKey, sessionKey);
+    }
+
+    if (!document) {
+        return {
+            {"displayName", tr("Unsaved FreeCAD document")},
+            {"sessionKey", sessionKey},
+        };
+    }
+
+    const QString fileName = QString::fromStdString(document->getFileName());
+    return {
+        {"path", fileName},
+        {"displayName", fileName.isEmpty() ? name : QFileInfo(fileName).fileName()},
+        {"sessionKey", sessionKey},
+    };
+}
+
+QString AgentBridge::documentIdentity() const
+{
+    if (const auto* document = App::GetApplication().getActiveDocument()) {
+        return QStringLiteral("%1\n%2").arg(
+            QString::fromUtf8(document->getName()),
+            QString::fromStdString(document->getFileName())
+        );
+    }
+    return QStringLiteral("<no-active-document>");
+}
+
+void AgentBridge::scheduleDocumentSync()
+{
+    if (documentSyncPending) {
+        return;
+    }
+    documentSyncPending = true;
+    QTimer::singleShot(0, this, [this]() {
+        documentSyncPending = false;
+        synchronizeDocumentContext();
+    });
+}
+
+void AgentBridge::synchronizeDocumentContext()
+{
+    const QString currentIdentity = documentIdentity();
+    if (currentIdentity == runtimeDocumentIdentity) {
+        return;
+    }
+
+    queuedPrompt.clear();
+    queuedAttachments = {};
+    awaitingSubmission = false;
+    draftTimer.stop();
+    draftDirty = false;
+    restartPending = false;
+    pendingRestartSaveId = 0;
+    pendingDraft.clear();
+    sidebar->documentContextChanged();
+    const QString currentProviderPath = providerPath();
+    if (runtime.state() == QProcess::NotRunning
+        && (currentProviderPath.isEmpty() || !QFileInfo::exists(currentProviderPath)
+            || !QFileInfo::exists(runtimePath()))) {
+        runtimeDocumentIdentity = currentIdentity;
+        selectedLocalThreadId.clear();
+        runtimeReady = false;
+        sidebar->updateStatus(tr("Ready"));
+        return;
+    }
+    performSessionRestart(QString(), false);
+}
+
+void AgentBridge::documentDeleted(const App::Document& document)
+{
+    documentSessionKeys.remove(
+        QStringLiteral("document:%1").arg(QString::fromUtf8(document.getName()))
+    );
+    scheduleDocumentSync();
+}
+
+void AgentBridge::fail(const QString& message)
+{
+    queuedPrompt.clear();
+    queuedAttachments = {};
+    awaitingSubmission = false;
+    sidebar->failTurn(message);
+}
