+// SPDX-License-Identifier: LGPL-2.1-or-later
+import QtQuick
+import QtQuick.Controls.Basic
+
+ToolTip {
+    id: hint
+    objectName: "AnthraciteHint"
+    // A status-bar QQuickWidget is only 30px high. An item popup would be
+    // confined to that strip and forced over the button it describes.
+    popupType: Popup.Window
+    property bool hovered: false
+    visible: hovered && !(parent && parent.down)
+    delay: 700
+    timeout: 4500
+    padding: 7
+    margins: 8
+    width: Math.min(300, implicitWidth)
+    // Above the control with a gap; Popup's margins constrain it to the window.
+    x: parent ? parent.width - width : 0
+    y: -height - 8
+    SystemPalette { id: colors }
+    contentItem: Text {
+        text: hint.text
+        color: colors.text
+        wrapMode: Text.WordWrap
+        font.pixelSize: 12
+    }
+    background: Rectangle {
+        color: colors.alternateBase
+        border.color: colors.mid
+        radius: 5
+    }
+}
