+}
+
+bool Sidebar::eventFilter(QObject* watched, QEvent* event)
+{
+    // Observe, never consume: mouse wheels can change Flickable.contentY
+    // without movementStarted. Qt Quick still owns the actual scrolling.
+    if (watched == quickView && event->type() == QEvent::Wheel) {
+        auto* root = quickView->rootObject();
+        if (root && root->metaObject()->indexOfMethod("observeWheel(QVariant)") >= 0) {
+            QMetaObject::invokeMethod(root, "observeWheel", Qt::DirectConnection,
+                Q_ARG(QVariant, QVariant(static_cast<QWheelEvent*>(event)->position())));
+        }
+    }
+    return QWidget::eventFilter(watched, event);
+}
+
+void Sidebar::reloadUi()
+{
+    QString configRoot = qEnvironmentVariable("XDG_CONFIG_HOME");
+    if (configRoot.isEmpty() || !QDir::isAbsolutePath(configRoot)) {
+        configRoot = QDir::home().filePath(QStringLiteral(".config"));
+    }
+    const QString overridePath = QDir(configRoot)
+        .filePath(QStringLiteral("anthracite/qml/Main.qml"));
+    QUrl source = QFileInfo::exists(overridePath)
+        ? QUrl::fromLocalFile(overridePath)
+        : QUrl(QStringLiteral("qrc:/Anthracite/qml/Main.qml"));
+    auto* replacement = new QQuickWidget(this);
+    replacement->installEventFilter(this);
+    replacement->setResizeMode(QQuickWidget::SizeRootObjectToView);
+    replacement->engine()->addUrlInterceptor(new SidebarQmlUrls(replacement));
+    replacement->rootContext()->setContextProperty(
+        QStringLiteral("anthraciteController"),
+        &sidebarController
+    );
+    // RCC timestamps are fixed in reproducible builds. Compile this small
+    // surface from its actual bytes so Qt cannot reuse stale disk-cached QML.
+    const auto load = [replacement](const QUrl& url) {
+        QFile file(url.isLocalFile() ? url.toLocalFile() : QStringLiteral(":") + url.path());
+        if (!file.open(QIODevice::ReadOnly)) {
+            replacement->setSource(url);
+            return;
+        }
+        auto* component = new QQmlComponent(replacement->engine(), replacement);
+        component->setData(file.readAll(), url);
+        replacement->setContent(url, component, component->isReady() ? component->create() : nullptr);
+    };
+    load(source);
+    if (replacement->status() != QQuickWidget::Ready) {
+        for (const auto& error : replacement->errors()) {
+            Base::Console().error("Anthracite QML: %s\n", error.toString().toUtf8().constData());
+        }
+        if (!quickView && source.isLocalFile()) {
+            source = QUrl(QStringLiteral("qrc:/Anthracite/qml/Main.qml"));
+            load(source);
+        }
+        if (quickView || replacement->status() != QQuickWidget::Ready) {
+            delete replacement;
+            return;
+        }
+    }
+    if (quickView) {
+        layout()->removeWidget(quickView);
+        delete quickView;
+    }
+    quickView = replacement;
+    layout()->addWidget(quickView);
+    setProperty("anthraciteQmlSource", source.toString());
+    Base::Console().message("Anthracite QML source: %s\n", source.toString().toUtf8().constData());
+}
+
+Sidebar::~Sidebar()
+{
+    delete quickView;
+    quickView = nullptr;
+}
+
+SidebarController* Sidebar::controller()
+{
+    return &sidebarController;
+}
+
+Sidebar* AnthraciteGui::ensureSidebar()
+{
+    auto* manager = Gui::DockWindowManager::instance();
+    if (auto* existing = qobject_cast<Sidebar*>(manager->getDockWindow("AnthraciteSidebar"))) {
+        return existing;
+    }
+
+    auto* sidebar = new Sidebar();
+    manager->addDockWindow("AnthraciteSidebar", sidebar, Qt::RightDockWidgetArea);
+    return sidebar;
+}
+
+void AnthraciteGui::showSidebar()
+{
+    auto* sidebar = ensureSidebar();
+    auto* dock = qobject_cast<QDockWidget*>(sidebar->parentWidget());
+    if (dock) {
+        dock->show();
+        dock->raise();
+    }
+    sidebar->setFocus();
+}
+
+SidebarController* AnthraciteGui::sidebarController()
+{
+    return ensureSidebar()->controller();
+}
