+// SPDX-License-Identifier: LGPL-2.1-or-later
+import QtQuick 2.15
+
+// Exact geometry for the loaded history page. Moving the viewport must not
+// instantiate delegates, remeasure text, or change the scroll range. History
+// and activity pagination belong to the conversation model, not the viewport.
+Flickable {
+    id: view
+    property alias model: rows.model
+    property alias delegate: rows.delegate
+    property alias count: rows.count
+    property alias spacing: layout.spacing
+    property alias header: headerLoader.sourceComponent
+    property alias footer: footerLoader.sourceComponent
+    readonly property alias rowItems: layout.children
+    contentWidth: width
+    contentHeight: layout.height
+    flickableDirection: Flickable.VerticalFlick
+
+    function itemAtIndex(index) { return rows.itemAt(index) }
+    function indexAt(x, y) {
+        for (let i = 0; i < count; ++i) {
+            const item = rows.itemAt(i)
+            if (item && y >= item.y && y < item.y + item.height) return i
+        }
+        return -1
+    }
+    function forceLayout() { layout.forceLayout() }
+    function positionViewAtEnd() {
+        forceLayout()
+        contentY = Math.max(0, contentHeight - height)
+    }
+    function positionViewAtIndex(index, mode) {
+        forceLayout()
+        const item = itemAtIndex(index)
+        if (item) contentY = Math.max(0, Math.min(contentHeight - height,
+            mode === ListView.End ? item.y + item.height - height : item.y))
+    }
+    Column {
+        id: layout
+        width: view.width
+        Loader {
+            id: headerLoader
+            width: parent.width
+            visible: height > 0
+        }
+        Repeater { id: rows }
+        Loader {
+            id: footerLoader
+            width: parent.width
+            visible: height > 0
+        }
+    }
+}
