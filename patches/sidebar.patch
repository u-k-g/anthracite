+void AgentBridge::restartSession(const QString& threadId, bool createThread)
+{
+    draftTimer.stop();
+    if (draftDirty && runtimeReady) {
+        restartPending = true;
+        pendingRestartThreadId = threadId;
+        pendingRestartCreateThread = createThread;
+        pendingRestartSaveId = persistDraftNow();
+        return;
+    }
+    performSessionRestart(threadId, createThread);
+}
+
+void AgentBridge::performSessionRestart(const QString& threadId, bool createThread)
+{
+    restartPending = false;
+    pendingRestartSaveId = 0;
+    selectedLocalThreadId = threadId;
+    createNewThread = createThread;
+    documentRevision.reset();
+    standardOutputBuffer.clear();
+    sidebar->clearInteraction();
+    sidebar->clearUsage();
+    selectedModel.clear();
+    selectedEffort.clear();
+    sidebar->restoreModelSelection(QString(), QString());
+
+    if (runtime.state() != QProcess::NotRunning) {
+        stopping = true;
+        runtime.kill();
+        runtime.waitForFinished(1000);
+        stopping = false;
+    }
+    runtimeReady = false;
+    ensureRuntime();
+}
+
+qint64 AgentBridge::persistDraftNow()
+{
+    if (!draftDirty || !runtimeReady) {
+        return 0;
+    }
+    const qint64 saveId = nextDraftSaveId++;
+    send(QStringLiteral("draft.save"), {{"body", pendingDraft}, {"saveId", saveId},
+        {"attachments", QJsonArray::fromVariantList(sidebar->attachments())}});
+    draftDirty = false;
+    return saveId;
+}
+
+void AgentBridge::send(const QString& type, const QJsonObject& payload)
+{
+    if (runtime.state() == QProcess::NotRunning) {
+        return;
+    }
+    const QJsonObject message {
+        {"protocolVersion", 2},
+        {"type", type},
+        {"payload", payload},
+    };
+    runtime.write(QJsonDocument(message).toJson(QJsonDocument::Compact));
+    runtime.write("\n");
+}
