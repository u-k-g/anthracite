+                    const row = model.indexOfId(newTurnId)
+                    if (row >= 0) {
+                        positionViewAtIndex(row, ListView.Beginning)
+                        // Keep the prompt at the top until the answer outgrows the viewport.
+                        const last = itemAtIndex(count - 1)
+                        if (!last) positionViewAtIndex(count - 1, ListView.End)
+                        else if (last.y + last.height > contentY + height)
+                            contentY = last.y + last.height - height
+                    }
