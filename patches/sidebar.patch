+        color: colors.text
+        Accessible.name: root.body
+    }
+    ToolButton {
+        visible: root.foldLong && messageText.contentHeight > 120
+        text: root.expanded ? qsTr("Show less") : qsTr("Show full message")
+        onClicked: { root.resizing(); root.expanded = !root.expanded }
+    }
