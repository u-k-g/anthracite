+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#ifndef ANTHRACITEGUI_CONVERSATIONMODEL_H
+#define ANTHRACITEGUI_CONVERSATIONMODEL_H
+
+#include <QAbstractListModel>
+#include <QString>
+#include <QTimer>
+#include <QMap>
+#include <vector>
+
+
+namespace AnthraciteGui
+{
+class ConversationModel: public QAbstractListModel
+{
+    Q_OBJECT
+    Q_PROPERTY(bool hasEarlier READ hasEarlier NOTIFY historyChanged)
+    Q_PROPERTY(QVariantMap detailRequests READ detailRequests NOTIFY historyChanged)
+    Q_PROPERTY(bool loadingEarlier READ loadingEarlier NOTIFY historyChanged)
+
+public:
+    enum Role
+    {
+        AuthorRole = Qt::UserRole + 1,
+        BodyRole,
+        KindRole,
+        EntriesRole,
+        IdRole,
+        TitleRole,
+        EntryCountRole,
+        ContentRole
+    };
+
+    explicit ConversationModel(QObject* parent = nullptr);
+
+    int rowCount(const QModelIndex& parent = QModelIndex()) const override;
+    QVariant data(const QModelIndex& index, int role) const override;
+    QHash<int, QByteArray> roleNames() const override;
+
+    void append(QString author, QString body, QString kind);
+    void clear();
+    Q_INVOKABLE void apply(const QVariantMap& edit);
+    bool hasEarlier() const { return earlier; }
+    QVariantMap detailRequests() const { return detailStates; }
+    bool loadingEarlier() const { return earlierLoading; }
+    Q_INVOKABLE int indexOfId(const QString& id) const;
+    Q_INVOKABLE QString idAt(int row) const;
+    Q_INVOKABLE QString kindAt(int row) const;
+    Q_INVOKABLE void loadEarlier();
+    Q_INVOKABLE void loadDetails(const QString& id);
+
+Q_SIGNALS:
+    void historyChanged();
+    void earlierRequested(const QString& before);
+    void detailsRequested(const QString& id, int offset);
+
+private:
+    void flushChanges();
+    QTimer updateTimer;
+    QMap<int, QList<int>> pendingRoles;
+    std::vector<QVariantMap> messages;
+    bool earlier = false;
+    bool earlierLoading = false;
+    QVariantMap detailStates;
+    QMap<QString, quint64> requestTokens;
+    quint64 requestSequence = 0;
+};
+}  // namespace AnthraciteGui
+
+#endif  // ANTHRACITEGUI_CONVERSATIONMODEL_H
