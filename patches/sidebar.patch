+void SidebarController::applyModelSelection(
+    const QString& requestedModel,
+    const QString& requestedEffort,
+    bool edited
+)
+{
+    if (availableModels.isEmpty()) {
+        const bool changed = currentModel != requestedModel || currentEffort != requestedEffort
+            || !availableEfforts.isEmpty();
+        currentModel = requestedModel;
+        currentEffort = requestedEffort;
+        availableEfforts.clear();
+        if (changed) {
+            Q_EMIT modelsChanged();
+        }
+        if (edited) {
+            Q_EMIT modelSelectionEdited(currentModel, currentEffort);
+        }
+        return;
+    }
+
+    QString model = requestedModel;
+    QVariantMap modelData;
+    for (const auto& value : availableModels) {
+        const QVariantMap candidate = value.toMap();
+        if (candidate.value(QStringLiteral("model")).toString() == model) {
+            modelData = candidate;
+            break;
+        }
+    }
+    if (modelData.isEmpty() && !availableModels.isEmpty()) {
+        for (const auto& value : availableModels) {
+            const QVariantMap candidate = value.toMap();
+            if (candidate.value(QStringLiteral("isDefault")).toBool()) {
+                modelData = candidate;
+                break;
+            }
+        }
+        if (modelData.isEmpty()) {
+            modelData = availableModels.constFirst().toMap();
+        }
+        model = modelData.value(QStringLiteral("model")).toString();
+    }
+
+    QVariantList efforts = modelData.value(QStringLiteral("efforts")).toList();
+    QString effort = requestedEffort;
+    bool effortSupported = false;
+    for (const auto& value : efforts) {
+        if (value.toMap().value(QStringLiteral("id")).toString() == effort) {
+            effortSupported = true;
+            break;
+        }
+    }
+    if (!effortSupported) {
+        effort = modelData.value(QStringLiteral("defaultEffort")).toString();
+        if (effort.isEmpty() && !efforts.isEmpty()) {
+            effort = efforts.constFirst().toMap().value(QStringLiteral("id")).toString();
+        }
+    }
+
+    const bool changed = model != currentModel || effort != currentEffort
+        || efforts != availableEfforts;
+    currentModel = model;
+    currentEffort = effort;
+    availableEfforts = efforts;
+    if (changed) {
+        Q_EMIT modelsChanged();
+    }
+    if (edited) {
+        Q_EMIT modelSelectionEdited(currentModel, currentEffort);
+    }
+}
