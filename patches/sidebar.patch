+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "ConversationModel.h"
+#include <QUuid>
+#include <utility>
+
+using namespace AnthraciteGui;
+
+ConversationModel::ConversationModel(QObject* parent)
+    : QAbstractListModel(parent)
+{
+    updateTimer.setSingleShot(true);
+    updateTimer.setInterval(16);
+    connect(&updateTimer, &QTimer::timeout, this, &ConversationModel::flushChanges);
+}
+
+void ConversationModel::flushChanges()
+{
+    updateTimer.stop();
+    const auto changes = std::exchange(pendingRoles, {});
+    for (auto it = changes.cbegin(); it != changes.cend(); ++it)
+        Q_EMIT dataChanged(index(it.key()), index(it.key()), it.value());
+}
+
+int ConversationModel::rowCount(const QModelIndex& parent) const
+{
+    return parent.isValid() ? 0 : static_cast<int>(messages.size());
+}
+
+QVariant ConversationModel::data(const QModelIndex& index, int role) const
+{
+    if (!index.isValid() || index.row() < 0 || index.row() >= rowCount()) {
+        return {};
+    }
+    return messages[index.row()].value(role == IdRole ? QStringLiteral("id")
+        : QString::fromLatin1(roleNames().value(role)));
+}
+
+QHash<int, QByteArray> ConversationModel::roleNames() const
+{
+    return {{AuthorRole, "author"}, {BodyRole, "body"}, {KindRole, "kind"},
+            {EntriesRole, "entries"}, {IdRole, "entryId"}, {TitleRole, "title"},
+            {EntryCountRole, "entryCount"}, {ContentRole, "content"}};
+}
+
+int ConversationModel::indexOfId(const QString& id) const
+{
+    for (int row = 0; row < rowCount(); ++row)
+        if (messages[row].value("id").toString() == id) return row;
+    return -1;
+}
+
+QString ConversationModel::idAt(int row) const
+{
+    return row >= 0 && row < rowCount() ? messages[row].value("id").toString() : QString();
+}
+
+QString ConversationModel::kindAt(int row) const
+{
+    return row >= 0 && row < rowCount() ? messages[row].value("kind").toString() : QString();
+}
+
+void ConversationModel::loadEarlier()
+{
+    if (!earlier || earlierLoading || messages.empty()) return;
+    earlierLoading = true;
+    Q_EMIT historyChanged();
+    const auto token = ++requestSequence;
+    requestTokens[QString()] = token;
+    QTimer::singleShot(10000, this, [this, token]() {
+        if (requestTokens.value(QString()) != token || !earlierLoading) return;
+        earlierLoading = false;
+        Q_EMIT historyChanged();
+    });
+    Q_EMIT earlierRequested(idAt(0));
+}
+
+void ConversationModel::loadDetails(const QString& id)
+{
+    const int row = indexOfId(id);
+    if (row < 0 || detailStates.value(id) == QStringLiteral("loading")) return;
+    detailStates[id] = QStringLiteral("loading");
+    Q_EMIT historyChanged();
+    const auto token = ++requestSequence;
+    requestTokens[id] = token;
+    QTimer::singleShot(10000, this, [this, id, token]() {
+        if (requestTokens.value(id) != token || detailStates.value(id) != QStringLiteral("loading")) return;
+        detailStates[id] = QStringLiteral("retry");
+        Q_EMIT historyChanged();
+    });
+    Q_EMIT detailsRequested(id, messages[row].value("entries").toList().size());
+}
+
+void ConversationModel::append(QString author, QString body, QString kind)
+{
+    apply({{"op", "append"}, {"row", QVariantMap {{"id", QUuid::createUuid().toString()},
+        {"author", author}, {"body", body}, {"kind", kind}, {"title", author},
+        {"entries", QVariantList()}, {"entryCount", 0}}}});
+}
+
+void ConversationModel::clear()
+{
+    apply({{"op", "reset"}});
+}
+
+void ConversationModel::apply(const QVariantMap& edit)
+{
+    // Generic row transport only. Message/run semantics belong to the Rust runtime.
+    const QString operation = edit.value("op").toString();
+    // Structural edits must not leave delayed signals addressing old row indices.
+    if (operation != QLatin1String("update")) flushChanges();
+    if (edit.contains("hasEarlier") || operation == QLatin1String("reset")) {
+        earlierLoading = false;
+        earlier = edit.value("hasEarlier").toBool();
+        Q_EMIT historyChanged();
+    }
+    if (operation == QLatin1String("reset")) {
+        detailStates.clear();
+        requestTokens.clear();
+        Q_EMIT historyChanged();
+        beginResetModel();
+        messages.clear();
+        for (const auto& row : edit.value("rows").toList()) {
+            messages.push_back(row.toMap());
+        }
+        endResetModel();
+    }
+    else if (operation == QLatin1String("prepend")) {
+        const auto rows = edit.value("rows").toList();
+        if (rows.isEmpty()) return;
+        beginInsertRows({}, 0, rows.size() - 1);
+        std::vector<QVariantMap> prefix;
+        for (const auto& row : rows) prefix.push_back(row.toMap());
+        messages.insert(messages.begin(), prefix.begin(), prefix.end());
+        endInsertRows();
+    }
+    else if (operation == QLatin1String("details")) {
+        const int row = indexOfId(edit.value("id").toString());
+        if (row < 0) return;
+        auto entries = messages[row].value("entries").toList();
+        // Duplicate or stale page responses must not duplicate activity.
+        if (entries.size() != edit.value("offset").toInt()) return;
+        detailStates.remove(edit.value("id").toString());
+        requestTokens.remove(edit.value("id").toString());
+        Q_EMIT historyChanged();
+        entries.append(edit.value("entries").toList());
+        messages[row]["entries"] = entries;
+        Q_EMIT dataChanged(index(row), index(row), {EntriesRole});
+    }
+    else if (operation == QLatin1String("append")) {
+        const int row = rowCount();
+        beginInsertRows({}, row, row);
+        messages.push_back(edit.value("row").toMap());
+        endInsertRows();
+    }
+    else if (operation == QLatin1String("update")) {
+        const QVariantMap value = edit.value("row").toMap();
+        for (int row = 0; row < rowCount(); ++row) {
+            if (messages[row].value("id") == value.value("id")) {
+                auto roles = roleNames();
+                QList<int> changed;
+                for (auto it = roles.cbegin(); it != roles.cend(); ++it) {
+                    const QString key = it.key() == IdRole ? QStringLiteral("id") : QString::fromLatin1(it.value());
+                    if (messages[row].value(key) != value.value(key)) changed.append(it.key());
+                }
+                messages[row] = value;
+                if (!changed.isEmpty()) {
+                    auto& pending = pendingRoles[row];
+                    for (int role : changed) if (!pending.contains(role)) pending.append(role);
+                    // Throttle, don't debounce: continuous output must still paint.
+                    if (!updateTimer.isActive()) updateTimer.start();
+                }
+                break;
+            }
+        }
+    }
+    else if (operation == QLatin1String("remove")) {
+        const QVariantList ids = edit.value("ids").toList();
+        for (int row = rowCount() - 1; row >= 0; --row) {
+            if (ids.contains(messages[row].value("id"))) {
+                beginRemoveRows({}, row, row);
+                messages.erase(messages.begin() + row);
+                endRemoveRows();
+            }
+        }
+    }
+}
