+QString AgentBridge::providerPath() const
+{
+    return findProviderExecutable(providerKind());
+}
+
+QString AgentBridge::findProviderExecutable(const QString& provider) const
+{
+    const auto preferences = App::GetApplication().GetParameterGroupByPath(preferencePath);
+    const char* key = provider == QLatin1String("opencode") ? "OpenCodeBinary" : "CodexBinary";
+    const QString configured = QString::fromStdString(preferences->GetASCII(key, ""));
+    if (!configured.isEmpty()) {
+        return configured;
+    }
+    const QString executable = QStandardPaths::findExecutable(provider);
+    if (!executable.isEmpty()) {
+        return executable;
+    }
+
+    const QString home = QDir::homePath();
+    const QStringList candidates =
+        provider == QLatin1String("opencode")
+        ? QStringList {
+              QDir(home).filePath(QStringLiteral(".opencode/bin/opencode")),
+              QStringLiteral("/opt/homebrew/bin/opencode"),
+              QStringLiteral("/usr/local/bin/opencode"),
+          }
+        : QStringList {
+              QDir(home).filePath(QStringLiteral(".local/bin/codex")),
+              QStringLiteral("/opt/homebrew/bin/codex"),
+              QStringLiteral("/usr/local/bin/codex"),
+          };
+    for (const QString& candidate : candidates) {
+        if (QFileInfo(candidate).isExecutable()) {
+            return candidate;
+        }
+    }
+
+    QProcess shell;
+#ifdef Q_OS_WIN
+    shell.start(QStringLiteral("cmd.exe"), {QStringLiteral("/C"), QStringLiteral("where"), provider});
+#else
+    const QString shellProgram = QProcessEnvironment::systemEnvironment().value(
+        QStringLiteral("SHELL"),
+        QStringLiteral("/bin/sh")
+    );
+    shell.start(
+        shellProgram,
+        {QStringLiteral("-lc"), QStringLiteral("command -v %1").arg(provider)}
+    );
+#endif
+    if (shell.waitForFinished(2000) && shell.exitCode() == 0) {
+        const QString resolved = QString::fromUtf8(shell.readAllStandardOutput()).trimmed();
+        if (QFileInfo(resolved).isExecutable()) {
+            return resolved;
+        }
+    }
+    return {};
+}
+
+QString AgentBridge::workingDirectory() const
+{
+    if (const auto* document = App::GetApplication().getActiveDocument()) {
+        const std::string fileName = document->getFileName();
+        if (!fileName.empty()) {
+            return QFileInfo(QString::fromStdString(fileName)).absolutePath();
+        }
+    }
+    return QDir::currentPath();
+}
+
+QString AgentBridge::databasePath() const
+{
+    return QDir(QString::fromStdString(App::Application::getUserAppDataDir()))
+        .filePath(QStringLiteral("Anthracite/anthracite.db"));
+}
+
+QJsonObject AgentBridge::documentContext()
+{
+    const auto* document = App::GetApplication().getActiveDocument();
+    const QString name = document ? QString::fromUtf8(document->getName()) : QStringLiteral("none");
+    const QString contextKey = document ? QStringLiteral("document:%1").arg(name)
+                                        : QStringLiteral("no-document");
+    QString sessionKey = documentSessionKeys.value(contextKey);
+    if (sessionKey.isEmpty()) {
+        sessionKey = QUuid::createUuid().toString(QUuid::WithoutBraces);
+        documentSessionKeys.insert(contextKey, sessionKey);
+    }
+
+    if (!document) {
+        return {
+            {"displayName", tr("Unsaved FreeCAD document")},
+            {"sessionKey", sessionKey},
+        };
+    }
+
+    const QString fileName = QString::fromStdString(document->getFileName());
+    return {
+        {"path", fileName},
+        {"displayName", fileName.isEmpty() ? name : QFileInfo(fileName).fileName()},
+        {"sessionKey", sessionKey},
+    };
+}
+
+QString AgentBridge::documentIdentity() const
+{
+    if (const auto* document = App::GetApplication().getActiveDocument()) {
+        return QStringLiteral("%1\n%2").arg(
+            QString::fromUtf8(document->getName()),
+            QString::fromStdString(document->getFileName())
+        );
+    }
+    return QStringLiteral("<no-active-document>");
+}
+
+void AgentBridge::scheduleDocumentSync()
+{
+    if (documentSyncPending) {
+        return;
+    }
+    documentSyncPending = true;
+    QTimer::singleShot(0, this, [this]() {
+        documentSyncPending = false;
+        synchronizeDocumentContext();
+    });
+}
+
+void AgentBridge::synchronizeDocumentContext()
+{
+    const QString currentIdentity = documentIdentity();
+    if (currentIdentity == runtimeDocumentIdentity) {
+        return;
+    }
+
+    queuedPrompt.clear();
+    draftTimer.stop();
+    draftDirty = false;
+    restartPending = false;
+    pendingRestartSaveId = 0;
+    pendingDraft.clear();
+    sidebar->documentContextChanged();
+    const QString currentProviderPath = providerPath();
+    if (runtime.state() == QProcess::NotRunning
+        && (currentProviderPath.isEmpty() || !QFileInfo::exists(currentProviderPath)
+            || !QFileInfo::exists(runtimePath()))) {
+        runtimeDocumentIdentity = currentIdentity;
+        selectedLocalThreadId.clear();
+        runtimeReady = false;
+        sidebar->updateStatus(tr("Ready"));
+        return;
+    }
+    performSessionRestart(QString(), false);
+}
+
+void AgentBridge::documentDeleted(const App::Document& document)
+{
+    documentSessionKeys.remove(
+        QStringLiteral("document:%1").arg(QString::fromUtf8(document.getName()))
+    );
+    scheduleDocumentSync();
+}
+
+void AgentBridge::fail(const QString& message)
+{
+    queuedPrompt.clear();
+    sidebar->failTurn(message);
+}
