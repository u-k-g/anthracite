+void SidebarController::submit(const QString& prompt)
+{
+    QString text = prompt.trimmed();
+    for (const auto& item : currentAttachments) {
+        const auto token = item.toMap();
+        if (token.value("type").toString() == QLatin1String("cad") && !token.value("token").toString().isEmpty()) {
+            text.replace(token.value("token").toString(), QStringLiteral("@[%1]").arg(token.value("name").toString()));
+        }
+    }
+    if ((text.isEmpty() && currentAttachments.isEmpty()) || turnBusy || processingAttachments()) {
+        return;
+    }
+
+    clearInteraction();
+    setPicking(false);
+    submissionPending = true;
+    setBusy(true);
+    setStatus(QStringLiteral("Starting agent"));
+    Q_EMIT promptSubmitted(text);
+}
