+
+void AgentBridge::ensureRuntime()
+{
+    if (runtime.state() != QProcess::NotRunning) {
+        return;
+    }
+
+    const QString provider = providerPath();
+    if (provider.isEmpty() || !QFileInfo::exists(provider)) {
+        const QString displayName = providerKind() == QLatin1String("opencode")
+            ? QStringLiteral("OpenCode")
+            : QStringLiteral("Codex");
+        fail(
+            tr("%1 was not found. Use Configure… to select your existing executable.")
+                .arg(displayName)
+        );
+        return;
+    }
+
+    const QString executable = runtimePath();
+    if (!QFileInfo::exists(executable)) {
+        fail(tr("Anthracite runtime was not found at %1").arg(executable));
+        return;
+    }
+
+    sidebar->appendActivity(
+        tr("Starting %1").arg(
+            providerKind() == QLatin1String("opencode") ? QStringLiteral("OpenCode")
+                                                        : QStringLiteral("Codex")
+        )
+    );
+    runtime.setProgram(executable);
+    runtime.setWorkingDirectory(workingDirectory());
+    runtime.start();
+}
