+// SPDX-License-Identifier: LGPL-2.1-or-later
+import QtQuick
+import QtQuick.Controls.Basic
+
+Rectangle {
+    SystemPalette { id: colors }
+    color: colors.window
+    Rectangle {
+        anchors.right: parent.right
+        height: parent.height
+        width: 1
+        color: colors.mid
+    }
+    Column {
+        anchors.fill: parent
+        anchors.margins: 6
+        spacing: 4
+        Repeater {
+            model: [qsTr("Console"), qsTr("User notifications")]
+            ToolButton {
+                required property int index
+                required property string modelData
+                objectName: "AnthraciteConsolePage" + index
+                width: parent.width
+                height: Math.max(32, implicitContentHeight + 12)
+                padding: 6
+                text: modelData
+                Accessible.name: modelData
+                checked: consolePages.currentIndex === index
+                onClicked: consolePages.currentIndex = index
+                contentItem: Text {
+                    text: parent.text
+                    color: colors.windowText
+                    verticalAlignment: Text.AlignVCenter
+                    wrapMode: Text.WordWrap
+                }
+                background: Rectangle {
+                    radius: 4
+                    color: parent.checked ? colors.highlight : parent.hovered ? colors.alternateBase : "transparent"
+                    opacity: parent.down ? 0.8 : 1
+                }
+            }
+        }
+    }
+}
