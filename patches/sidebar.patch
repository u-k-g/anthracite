+void SidebarController::attachFile(const QString& path)
+{
+    prepareAttachment([path]() -> QVariantMap {
+    QFile file(path);
+    const QFileInfo info(file);
+    if (!info.isFile() || info.size() > 8 * 1024 * 1024 || !file.open(QIODevice::ReadOnly)) {
+        return {{"error", tr("Cannot attach %1: choose a readable file up to 8 MiB.").arg(info.fileName())}};
+    }
+    QImageReader reader(path);
+    if (reader.canRead()) {
+        reader.setAutoTransform(true);
+        if (!reader.size().isValid() || qint64(reader.size().width()) * reader.size().height() > 64 * 1024 * 1024) {
+            return {{"error", tr("Image dimensions are too large or invalid.")}};
+        }
+        reader.setScaledSize(reader.size().scaled(2048, 2048, Qt::KeepAspectRatio));
+        const auto attachment = imageAttachment(reader.read(), info.fileName());
+        return attachment;
+    }
+    // Snapshot native file-dialog input so later edits to the original cannot change a sent attachment.
+    const QString root = qEnvironmentVariable("XDG_STATE_HOME", QDir::homePath() + QStringLiteral("/.local/state"));
+    const QString directory = QDir(root).filePath(QStringLiteral("anthracite/attachments/") + QUuid::createUuid().toString(QUuid::WithoutBraces));
+    if (!QDir().mkpath(directory)) return {{"error", tr("Cannot create attachment directory.")}};
+    const QString destination = QDir(directory).filePath(info.fileName());
+    QSaveFile saved(destination);
+    const auto bytes = file.read(8 * 1024 * 1024 + 1);
+    if (bytes.size() > 8 * 1024 * 1024 || !saved.open(QIODevice::WriteOnly)
+        || saved.write(bytes) != bytes.size() || !saved.commit()) {
+        return {{"error", tr("Cannot save attachment.")}};
+    }
+    return {{"type", "file"}, {"name", info.fileName()}, {"path", destination}};
+    });
+}
+
+void SidebarController::prepareAttachment(std::function<QVariantMap()> read)
+{
+    if (turnBusy) return;
+    setPicking(false);
+    if (currentAttachments.size() + pendingAttachments >= 8) {
+        appendActivity(tr("At most 8 attachments per message."));
+        return;
+    }
+    ++pendingAttachments;
+    Q_EMIT attachmentsChanged();
+    const auto generation = composerGeneration;
+    auto* watcher = new QFutureWatcher<QVariantMap>(this);
+    connect(watcher, &QFutureWatcher<QVariantMap>::finished, this, [this, watcher, generation]() {
+        --pendingAttachments;
+        const auto result = watcher->result();
+        watcher->deleteLater();
+        if (generation != composerGeneration) {
+            appendActivity(tr("Document changed while reading an attachment. Attach it again in the intended document."));
+        } else if (result.isEmpty() || result.contains("error")) {
+            appendActivity(result.value("error", tr("Could not decode image.")).toString());
+        } else {
+            addAttachment(result);
+        }
+        Q_EMIT attachmentsChanged();
+    });
+    watcher->setFuture(QtConcurrent::run(&attachmentPool, std::move(read)));
+}
