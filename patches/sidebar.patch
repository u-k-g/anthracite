+    Q_PROPERTY(QString currentThreadId READ currentThreadId NOTIFY threadsChanged)
+    Q_PROPERTY(QString draft READ draft NOTIFY draftChanged)
+    Q_PROPERTY(QVariantList models READ models NOTIFY modelsChanged)
+    Q_PROPERTY(QString selectedModel READ selectedModel NOTIFY modelsChanged)
+    Q_PROPERTY(QVariantList reasoningEfforts READ reasoningEfforts NOTIFY modelsChanged)
+    Q_PROPERTY(QString selectedEffort READ selectedEffort NOTIFY modelsChanged)
+    Q_PROPERTY(bool modelControlsAvailable READ modelControlsAvailable NOTIFY modelsChanged)
+    Q_PROPERTY(QString usageLabel READ usageLabel NOTIFY usageChanged)
+    Q_PROPERTY(QString usageDetail READ usageDetail NOTIFY usageChanged)
+    Q_PROPERTY(double usageFraction READ usageFraction NOTIFY usageChanged)
+    Q_PROPERTY(bool usageVisible READ usageVisible NOTIFY usageChanged)
+    Q_PROPERTY(QVariantList providers READ providers CONSTANT)
+    Q_PROPERTY(QString selectedProvider READ selectedProvider NOTIFY providerChanged)
+
+public:
+    explicit SidebarController(QObject* parent = nullptr);
+
+    QAbstractItemModel* messages();
+    QString status() const;
+    bool busy() const;
+    bool interactionPending() const;
+    QString interactionKind() const;
+    QString interactionTitle() const;
+    QString interactionDetail() const;
+    bool interactionAllowSession() const;
+    QVariantList interactionQuestions() const;
+    bool inputComplete() const;
+    QVariantList threads() const;
+    QString currentThreadId() const;
+    QString draft() const;
+    QVariantList models() const;
+    QString selectedModel() const;
+    QVariantList reasoningEfforts() const;
+    QString selectedEffort() const;
+    bool modelControlsAvailable() const;
+    QString usageLabel() const;
+    QString usageDetail() const;
+    double usageFraction() const;
+    bool usageVisible() const;
+    QVariantList providers() const;
+    QString selectedProvider() const;
+
+    Q_INVOKABLE void submit(const QString& prompt);
+    Q_INVOKABLE void stop();
+    Q_INVOKABLE void chooseProvider();
+    Q_INVOKABLE void selectProvider(const QString& provider);
+    Q_INVOKABLE void newThread();
+    Q_INVOKABLE void selectThread(const QString& threadId);
+    Q_INVOKABLE void setDraft(const QString& body);
+    Q_INVOKABLE void selectModel(const QString& model);
+    Q_INVOKABLE void selectEffort(const QString& effort);
+    Q_INVOKABLE void respondToApproval(const QString& decision);
+    Q_INVOKABLE void setInputAnswer(const QString& questionId, const QString& answer);
+    Q_INVOKABLE QString inputAnswer(const QString& questionId) const;
+    Q_INVOKABLE void submitInputAnswers();
+
+    void appendActivity(const QString& text);
+    void resetHistory();
+    void showWelcome();
+    void appendUserMessage(const QString& text);
+    void beginAssistantMessage();
+    void appendAssistantDelta(const QString& delta);
+    void updatePlan(const QString& explanation, const QVariantList& steps);
+    void showApproval(
+        const QString& requestId,
+        const QString& title,
+        const QString& detail,
+        bool allowSession
+    );
+    void showUserInput(const QString& requestId, const QVariantList& questions);
+    void clearInteraction();
+    void completeTurn();
+    void failTurn(const QString& error);
+    void updateStatus(const QString& status);
+    void updateThreads(const QString& currentThreadId, const QVariantList& threads);
+    void loadDraft(const QString& body);
+    void updateModelCatalog(const QVariantList& models);
