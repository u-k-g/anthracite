+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include <Gui/Action.h>
+#include <Gui/Application.h>
+#include <Gui/Command.h>
+#include <Gui/MainWindow.h>
+
+#include "StatusController.h"
+
+
+DEF_STD_CMD_A(AnthraciteCmdPickReference)
+
+AnthraciteCmdPickReference::AnthraciteCmdPickReference()
+    : Command("Anthracite_PickReference")
+{
+    sGroup = "Anthracite";
+    sMenuText = QT_TR_NOOP("Pick CAD &geometry");
+    sToolTipText = QT_TR_NOOP("Copy a model reference to the clipboard");
+    sStatusTip = QT_TR_NOOP("Copy a model reference to the clipboard");
+    sAccel = "Ctrl+Shift+E";
+    sWhatsThis = "Anthracite_PickReference";
+}
+
+void AnthraciteCmdPickReference::activated(int message)
+{
+    Q_UNUSED(message);
+    AnthraciteGui::statusController()->togglePicker();
+}
+
+bool AnthraciteCmdPickReference::isActive()
+{
+    return true;
+}
+
+void CreateAnthraciteCommands()
+{
+    auto& commands = Gui::Application::Instance->commandManager();
+    auto* command = new AnthraciteCmdPickReference();
+    command->initAction();
+    commands.addCommand(command);
+    // The accelerator only fires once the action belongs to the main window.
+    if (auto* action = command->getAction()) {
+        Gui::getMainWindow()->addAction(action->action());
+    }
+}
