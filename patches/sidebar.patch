+    Q_INVOKABLE void toggleConsole();
+Q_SIGNALS:
+    void changed();
+protected:
+    bool eventFilter(QObject* watched, QEvent* event) override;
+private:
+    void updatePosition();
+    void updateTitleBar();
+    QPointer<QDockWidget> chat;
+    QString latest;
+    QString position;
+    QString source;
+};
+void installChrome();
+}
