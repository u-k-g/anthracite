diff --git a/src/Mod/Anthracite/TestAnthraciteGui.py b/src/Mod/Anthracite/TestAnthraciteGui.py
new file mode 100644
index 0000000000..ede4cf8a06
--- /dev/null
+++ b/src/Mod/Anthracite/TestAnthraciteGui.py
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtWidgets
+from PySide6 import QtQuickWidgets
+
+import AnthraciteExecutor
+import AnthraciteGui  # noqa: F401 - importing registers the dock window
+
+
+def run_smoke_test():
+    main_window = Gui.getMainWindow()
+    dock = main_window.findChild(QtWidgets.QDockWidget, "AnthraciteSidebar")
+    if dock is None:
+        raise AssertionError("AnthraciteSidebar was not registered as a dock window.")
+    if dock.widget() is None:
+        raise AssertionError("AnthraciteSidebar does not contain its native widget.")
+    quick_widget = dock.findChild(QtQuickWidgets.QQuickWidget)
+    if quick_widget is None:
+        raise AssertionError("AnthraciteSidebar does not contain its QML surface.")
+    if quick_widget.status() != QtQuickWidgets.QQuickWidget.Ready:
+        errors = "; ".join(error.toString() for error in quick_widget.errors())
+        raise AssertionError(f"Anthracite QML did not load: {errors}")
+    root = quick_widget.rootObject()
+    if root.findChild(QtCore.QObject, "AnthraciteInteractionCard") is None:
+        raise AssertionError("Anthracite QML does not expose the interaction card.")
+    if root.findChild(QtCore.QObject, "AnthraciteRequestedInput") is None:
+        raise AssertionError("Anthracite QML does not expose requested-input controls.")
+    if root.findChild(QtCore.QObject, "AnthraciteThreadPicker") is None:
+        raise AssertionError("Anthracite QML does not expose the conversation picker.")
+    if root.findChild(QtCore.QObject, "AnthraciteNewThread") is None:
+        raise AssertionError("Anthracite QML does not expose the new-conversation control.")
+    if root.findChild(QtCore.QObject, "AnthraciteComposer") is None:
+        raise AssertionError("Anthracite QML does not expose the persistent composer.")
+    if root.findChild(QtCore.QObject, "AnthraciteModelControls") is None:
+        raise AssertionError("Anthracite QML does not expose model controls.")
+    if root.findChild(QtCore.QObject, "AnthraciteModelPicker") is None:
+        raise AssertionError("Anthracite QML does not expose the model picker.")
+    if root.findChild(QtCore.QObject, "AnthraciteEffortPicker") is None:
+        raise AssertionError("Anthracite QML does not expose the reasoning-effort picker.")
+    if root.findChild(QtCore.QObject, "AnthraciteContextUsage") is None:
+        raise AssertionError("Anthracite QML does not expose context-window usage.")
+    if root.findChild(QtCore.QObject, "AnthraciteProviderPicker") is None:
+        raise AssertionError("Anthracite QML does not expose the provider picker.")
+
+    render_document = App.newDocument("AnthraciteRender")
+    render_result = AnthraciteExecutor.execute(
+        "\n".join(
+            [
+                "box = doc.addObject('Part::Box', 'RenderBox')",
+                "box.Length = 12",
+                "box.Width = 8",
+                "box.Height = 5",
+                "cad.render(width=256, height=192)",
+            ]
+        )
+    )
+    if not render_result["ok"]:
+        raise AssertionError(f"Viewport observation failed: {render_result}")
+    if not render_result["images"][0].startswith("data:image/png;base64,"):
+        raise AssertionError("Viewport observation did not return an inline PNG.")
+    if render_result["observation"]["render"]["width"] != 256:
+        raise AssertionError("Viewport observation metadata is incomplete.")
+    Gui.Selection.addSelection(render_document.getObject("RenderBox"), "Face1")
+    selection_result = AnthraciteExecutor.execute("cad.selection()")
+    selection = selection_result["result"][0]
+    if selection["object"] != "RenderBox":
+        raise AssertionError("Selection observation lost the internal object name.")
+    if selection["subelements"][0]["name"] != "Face1":
+        raise AssertionError("Selection observation lost the selected face.")
+    if selection["subelements"][0]["topology"]["shapeType"] != "Face":
+        raise AssertionError("Selection observation did not describe selected topology.")
+    Gui.Selection.clearSelection()
+    App.closeDocument(render_document.Name)
+
+    first = App.newDocument("AnthraciteContextOne")
+    second = App.newDocument("AnthraciteContextTwo")
+    App.setActiveDocument(first.Name)
+    QtWidgets.QApplication.processEvents()
+    App.setActiveDocument(second.Name)
+    QtWidgets.QApplication.processEvents()
+    App.closeDocument(first.Name)
+    App.closeDocument(second.Name)
+    QtWidgets.QApplication.processEvents()
+    print("ANTHRACITE_GUI_SMOKE_OK")
+
+
+run_smoke_test()
+QtCore.QTimer.singleShot(0, QtWidgets.QApplication.instance().quit)
