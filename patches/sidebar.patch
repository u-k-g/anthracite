+using namespace AnthraciteGui;
+
+namespace
+{
+QString formatTokens(qint64 tokens)
+{
+    if (tokens >= 1'000'000) {
+        return QStringLiteral("%1m").arg(tokens / 1'000'000.0, 0, 'f', 1);
+    }
+    if (tokens >= 1'000) {
+        return QStringLiteral("%1k").arg(tokens / 1'000.0, 0, 'f', 1);
+    }
+    return QString::number(tokens);
+}
+}  // namespace
+
+SidebarController::SidebarController(QObject* parent)
+    : QObject(parent)
+    , conversation(this)
+    , currentStatus(QStringLiteral("Ready"))
+{
+    showWelcome();
+}
+
+void SidebarController::showWelcome()
+{
+    conversation.append(
+        QStringLiteral("Anthracite"),
+        QStringLiteral("Connect an existing agent and describe what you want to make in FreeCAD."),
+        QStringLiteral("system")
+    );
+}
+
+QAbstractItemModel* SidebarController::messages()
+{
+    return &conversation;
+}
+
+QString SidebarController::status() const
+{
+    return currentStatus;
+}
+
+bool SidebarController::busy() const
+{
+    return turnBusy;
+}
+
+bool SidebarController::interactionPending() const
+{
+    return !pendingInteractionKind.isEmpty();
+}
+
+QString SidebarController::interactionKind() const
+{
+    return pendingInteractionKind;
+}
+
+QString SidebarController::interactionTitle() const
+{
+    return pendingInteractionTitle;
+}
+
+QString SidebarController::interactionDetail() const
+{
+    return pendingInteractionDetail;
+}
+
+bool SidebarController::interactionAllowSession() const
+{
+    return pendingAllowSession;
+}
+
+QVariantList SidebarController::interactionQuestions() const
+{
+    return pendingQuestions;
+}
+
+bool SidebarController::inputComplete() const
+{
+    if (pendingInteractionKind != QLatin1String("user_input") || pendingQuestions.isEmpty()) {
+        return false;
+    }
+    for (const auto& value : pendingQuestions) {
+        const QString id = value.toMap().value(QStringLiteral("id")).toString();
+        if (id.isEmpty() || pendingAnswers.value(id).toString().trimmed().isEmpty()) {
+            return false;
+        }
+    }
+    return true;
+}
+
+QVariantList SidebarController::threads() const
+{
+    return availableThreads;
+}
+
+QString SidebarController::currentThreadId() const
+{
+    return activeThreadId;
+}
+
+QString SidebarController::draft() const
+{
+    return currentDraft;
+}
+
+QVariantList SidebarController::models() const
+{
+    return availableModels;
+}
+
+QString SidebarController::selectedModel() const
+{
+    return currentModel;
+}
+
+QVariantList SidebarController::reasoningEfforts() const
+{
+    return availableEfforts;
+}
+
+QString SidebarController::selectedEffort() const
+{
+    return currentEffort;
+}
+
+bool SidebarController::modelControlsAvailable() const
+{
+    return !availableModels.isEmpty();
+}
+
+QString SidebarController::usageLabel() const
+{
+    return currentUsageLabel;
+}
+
+QString SidebarController::usageDetail() const
+{
+    return currentUsageDetail;
+}
+
+double SidebarController::usageFraction() const
+{
+    return currentUsageFraction;
+}
+
+bool SidebarController::usageVisible() const
+{
+    return !currentUsageLabel.isEmpty();
+}
+
+QVariantList SidebarController::providers() const
+{
+    return {
+        QVariantMap {
+            {QStringLiteral("id"), QStringLiteral("codex")},
+            {QStringLiteral("name"), QStringLiteral("Codex")},
+        },
+        QVariantMap {
+            {QStringLiteral("id"), QStringLiteral("opencode")},
+            {QStringLiteral("name"), QStringLiteral("OpenCode")},
+        },
+    };
+}
+
+QString SidebarController::selectedProvider() const
+{
+    return currentProvider;
+}
+
+void SidebarController::submit(const QString& prompt)
+{
+    const QString text = prompt.trimmed();
+    if (text.isEmpty() || turnBusy) {
+        return;
+    }
+
+    conversation.append(QStringLiteral("You"), text, QStringLiteral("user"));
+    conversation.beginTurn();
+    clearInteraction();
+    if (!currentDraft.isEmpty()) {
+        currentDraft.clear();
+        Q_EMIT draftChanged();
+        Q_EMIT draftEdited(currentDraft);
+    }
+    setBusy(true);
+    setStatus(QStringLiteral("Starting agent"));
+    Q_EMIT promptSubmitted(text);
+}
+
+void SidebarController::stop()
+{
+    if (turnBusy) {
+        Q_EMIT stopRequested();
+        setStatus(QStringLiteral("Stopping"));
+    }
+}
+
+void SidebarController::chooseProvider()
+{
+    Q_EMIT chooseProviderRequested();
+}
+
+void SidebarController::selectProvider(const QString& provider)
+{
+    if (turnBusy || (provider != QLatin1String("codex") && provider != QLatin1String("opencode"))
+        || provider == currentProvider) {
+        return;
+    }
+    currentProvider = provider;
+    Q_EMIT providerChanged();
+    Q_EMIT providerSelected(provider);
+}
+
+void SidebarController::newThread()
+{
+    if (!turnBusy) {
+        Q_EMIT newThreadRequested();
+    }
+}
+
+void SidebarController::selectThread(const QString& threadId)
+{
+    if (!turnBusy && !threadId.isEmpty() && threadId != activeThreadId) {
+        Q_EMIT threadSelected(threadId);
+    }
+}
+
+void SidebarController::setDraft(const QString& body)
+{
+    if (currentDraft == body) {
+        return;
+    }
+    currentDraft = body;
+    Q_EMIT draftChanged();
+    Q_EMIT draftEdited(currentDraft);
+}
+
+void SidebarController::selectModel(const QString& model)
+{
+    if (!turnBusy && model != currentModel) {
+        applyModelSelection(model, QString(), true);
+    }
+}
+
+void SidebarController::selectEffort(const QString& effort)
+{
+    if (!turnBusy && effort != currentEffort) {
+        applyModelSelection(currentModel, effort, true);
+    }
+}
+
+void SidebarController::respondToApproval(const QString& decision)
+{
+    if (pendingInteractionKind != QLatin1String("approval") || pendingRequestId.isEmpty()) {
+        return;
+    }
+    const QString requestId = pendingRequestId;
+    appendActivity(
+        decision.startsWith(QLatin1String("approve")) ? tr("Approved provider request")
+                                                      : tr("Declined provider request")
+    );
+    clearInteraction();
+    setStatus(QStringLiteral("Thinking"));
+    Q_EMIT approvalResponded(requestId, decision);
+}
+
+void SidebarController::setInputAnswer(const QString& questionId, const QString& answer)
+{
+    if (pendingInteractionKind != QLatin1String("user_input") || questionId.isEmpty()) {
+        return;
+    }
+    const QString text = answer.trimmed();
+    if (text.isEmpty()) {
+        pendingAnswers.remove(questionId);
+    }
+    else {
+        pendingAnswers.insert(questionId, text);
+    }
+    Q_EMIT interactionChanged();
+}
+
+QString SidebarController::inputAnswer(const QString& questionId) const
+{
+    return pendingAnswers.value(questionId).toString();
+}
+
+void SidebarController::submitInputAnswers()
+{
+    if (!inputComplete() || pendingRequestId.isEmpty()) {
+        return;
+    }
+    const QString requestId = pendingRequestId;
+    const QVariantMap answers = pendingAnswers;
+    appendActivity(tr("Answered provider question"));
+    clearInteraction();
+    setStatus(QStringLiteral("Thinking"));
+    Q_EMIT userInputResponded(requestId, answers);
+}
+
+void SidebarController::appendActivity(const QString& text)
+{
+    conversation.append(QStringLiteral("Activity"), text, QStringLiteral("activity"));
+}
+
+void SidebarController::resetHistory()
+{
+    conversation.clear();
+}
+
+void SidebarController::appendUserMessage(const QString& text)
+{
+    conversation.append(QStringLiteral("You"), text, QStringLiteral("user"));
+    conversation.beginTurn();
+}
+
+void SidebarController::beginAssistantMessage()
+{
+    conversation.beginAssistantMessage();
+}
+
+void SidebarController::appendAssistantDelta(const QString& delta)
+{
+    conversation.appendAssistantDelta(delta);
+}
+
+void SidebarController::updatePlan(const QString& explanation, const QVariantList& steps)
+{
+    QStringList lines;
+    if (!explanation.trimmed().isEmpty()) {
+        lines.append(explanation.trimmed());
+        lines.append(QString());
+    }
+    for (const auto& value : steps) {
+        const QVariantMap step = value.toMap();
+        const QString status = step.value(QStringLiteral("status")).toString();
+        const QString marker = status == QLatin1String("completed") ? QStringLiteral("●")
+            : status == QLatin1String("inProgress")                 ? QStringLiteral("◐")
+                                                                    : QStringLiteral("○");
+        lines.append(
+            QStringLiteral("%1 %2").arg(marker, step.value(QStringLiteral("step")).toString())
+        );
+    }
+    conversation.upsertPlan(lines.join(QLatin1Char('\n')));
+}
+
+void SidebarController::showApproval(
+    const QString& requestId,
+    const QString& title,
+    const QString& detail,
+    bool allowSession
+)
+{
+    clearInteraction();
+    pendingRequestId = requestId;
+    pendingInteractionKind = QStringLiteral("approval");
+    pendingInteractionTitle = title;
+    pendingInteractionDetail = detail;
+    pendingAllowSession = allowSession;
+    setStatus(QStringLiteral("Approval needed"));
+    Q_EMIT interactionChanged();
+}
+
+void SidebarController::showUserInput(const QString& requestId, const QVariantList& questions)
+{
+    clearInteraction();
+    pendingRequestId = requestId;
+    pendingInteractionKind = QStringLiteral("user_input");
+    pendingInteractionTitle = tr("Input needed");
+    pendingQuestions = questions;
+    setStatus(QStringLiteral("Input needed"));
+    Q_EMIT interactionChanged();
+}
+
+void SidebarController::clearInteraction()
+{
+    if (!interactionPending() && pendingRequestId.isEmpty()) {
+        return;
+    }
+    pendingRequestId.clear();
+    pendingInteractionKind.clear();
+    pendingInteractionTitle.clear();
+    pendingInteractionDetail.clear();
+    pendingQuestions.clear();
+    pendingAnswers.clear();
+    pendingAllowSession = false;
+    Q_EMIT interactionChanged();
+}
+
+void SidebarController::restoreProvider(const QString& provider)
+{
+    const QString normalized = provider == QLatin1String("opencode") ? provider
+                                                                     : QStringLiteral("codex");
+    if (currentProvider != normalized) {
+        currentProvider = normalized;
+        Q_EMIT providerChanged();
+    }
+}
+
+void SidebarController::completeTurn()
+{
+    clearInteraction();
+    setBusy(false);
+    setStatus(QStringLiteral("Ready"));
+}
+
+void SidebarController::failTurn(const QString& error)
+{
+    clearInteraction();
+    conversation.append(QStringLiteral("Error"), error, QStringLiteral("error"));
+    setBusy(false);
+    setStatus(QStringLiteral("Error"));
+}
+
+void SidebarController::updateStatus(const QString& status)
+{
+    setStatus(status);
+}
+
+void SidebarController::updateThreads(const QString& currentThreadId, const QVariantList& threads)
+{
+    activeThreadId = currentThreadId;
+    availableThreads = threads;
+    Q_EMIT threadsChanged();
+}
+
+void SidebarController::loadDraft(const QString& body)
+{
+    if (currentDraft == body) {
+        return;
+    }
+    currentDraft = body;
+    Q_EMIT draftChanged();
+}
+
+void SidebarController::updateModelCatalog(const QVariantList& models)
+{
+    availableModels = models;
+    applyModelSelection(currentModel, currentEffort, false);
+}
+
+void SidebarController::restoreModelSelection(const QString& model, const QString& effort)
+{
+    applyModelSelection(model, effort, false);
+}
+
+void SidebarController::updateUsage(const QVariantMap& usage)
+{
+    const qint64 used = usage.value(QStringLiteral("usedTokens")).toLongLong();
+    const qint64 maximum = usage.value(QStringLiteral("maxTokens")).toLongLong();
+    const qint64 processed = usage.value(QStringLiteral("totalProcessedTokens")).toLongLong();
+    if (used <= 0) {
+        clearUsage();
+        return;
+    }
+
+    currentUsageLabel = maximum > 0 ? tr("%1 / %2").arg(formatTokens(used), formatTokens(maximum))
+                                    : tr("%1 tokens").arg(formatTokens(used));
+    currentUsageDetail = maximum > 0
+        ? tr("Context window: %1 of %2 tokens").arg(formatTokens(used), formatTokens(maximum))
+        : tr("Context window: %1 tokens").arg(formatTokens(used));
+    if (processed > used) {
+        currentUsageDetail += tr("; %1 processed in this conversation").arg(formatTokens(processed));
+    }
+    currentUsageFraction = maximum > 0
+        ? std::clamp(static_cast<double>(used) / static_cast<double>(maximum), 0.0, 1.0)
+        : 0.0;
+    Q_EMIT usageChanged();
+}
+
+void SidebarController::clearUsage()
+{
+    if (currentUsageLabel.isEmpty()) {
+        return;
+    }
+    currentUsageLabel.clear();
+    currentUsageDetail.clear();
+    currentUsageFraction = 0.0;
+    Q_EMIT usageChanged();
+}
+
+void SidebarController::documentContextChanged()
+{
+    clearInteraction();
+    setBusy(false);
+    resetHistory();
+    showWelcome();
+    updateThreads(QString(), {});
+    loadDraft(QString());
+    availableModels.clear();
+    currentModel.clear();
+    currentEffort.clear();
+    availableEfforts.clear();
+    Q_EMIT modelsChanged();
+    clearUsage();
+    setStatus(QStringLiteral("Connecting"));
+}
+
+void SidebarController::applyModelSelection(
+    const QString& requestedModel,
+    const QString& requestedEffort,
+    bool edited
+)
+{
+    if (availableModels.isEmpty()) {
+        const bool changed = currentModel != requestedModel || currentEffort != requestedEffort
+            || !availableEfforts.isEmpty();
+        currentModel = requestedModel;
+        currentEffort = requestedEffort;
+        availableEfforts.clear();
+        if (changed) {
+            Q_EMIT modelsChanged();
+        }
+        if (edited) {
+            Q_EMIT modelSelectionEdited(currentModel, currentEffort);
+        }
+        return;
+    }
+
+    QString model = requestedModel;
+    QVariantMap modelData;
+    for (const auto& value : availableModels) {
+        const QVariantMap candidate = value.toMap();
+        if (candidate.value(QStringLiteral("model")).toString() == model) {
+            modelData = candidate;
+            break;
+        }
+    }
+    if (modelData.isEmpty() && !availableModels.isEmpty()) {
+        for (const auto& value : availableModels) {
+            const QVariantMap candidate = value.toMap();
+            if (candidate.value(QStringLiteral("isDefault")).toBool()) {
+                modelData = candidate;
+                break;
+            }
+        }
+        if (modelData.isEmpty()) {
+            modelData = availableModels.constFirst().toMap();
+        }
+        model = modelData.value(QStringLiteral("model")).toString();
+    }
+
+    QVariantList efforts = modelData.value(QStringLiteral("efforts")).toList();
+    QString effort = requestedEffort;
+    bool effortSupported = false;
+    for (const auto& value : efforts) {
+        if (value.toMap().value(QStringLiteral("id")).toString() == effort) {
+            effortSupported = true;
+            break;
+        }
+    }
+    if (!effortSupported) {
+        effort = modelData.value(QStringLiteral("defaultEffort")).toString();
+        if (effort.isEmpty() && !efforts.isEmpty()) {
+            effort = efforts.constFirst().toMap().value(QStringLiteral("id")).toString();
+        }
+    }
+
+    const bool changed = model != currentModel || effort != currentEffort
+        || efforts != availableEfforts;
+    currentModel = model;
+    currentEffort = effort;
+    availableEfforts = efforts;
+    if (changed) {
+        Q_EMIT modelsChanged();
+    }
+    if (edited) {
+        Q_EMIT modelSelectionEdited(currentModel, currentEffort);
+    }
+}
+
+void SidebarController::setStatus(QString status)
+{
+    if (currentStatus == status) {
+        return;
+    }
+    currentStatus = std::move(status);
+    Q_EMIT statusChanged();
+}
+
+void SidebarController::setBusy(bool busy)
+{
+    if (turnBusy == busy) {
+        return;
+    }
+    turnBusy = busy;
+    Q_EMIT busyChanged();
+}
+
+Sidebar::Sidebar(QWidget* parent)
+    : QWidget(parent)
+    , sidebarController(this)
+    , agentBridge(new AgentBridge(&sidebarController, this))
+    , quickView(new QQuickWidget(this))
+{
+    setWindowTitle(tr("Anthracite"));
+    setMinimumWidth(320);
+
+    quickView->setResizeMode(QQuickWidget::SizeRootObjectToView);
+    quickView->rootContext()->setContextProperty(
+        QStringLiteral("anthraciteController"),
+        &sidebarController
+    );
+    quickView->setSource(QUrl(QStringLiteral("qrc:/Anthracite/qml/Main.qml")));
+
+    auto* layout = new QVBoxLayout(this);
+    layout->setContentsMargins(0, 0, 0, 0);
+    layout->addWidget(quickView);
+}
+
+Sidebar::~Sidebar()
+{
+    delete quickView;
+    quickView = nullptr;
+    delete agentBridge;
+    agentBridge = nullptr;
+}
+
+SidebarController* Sidebar::controller()
+{
+    return &sidebarController;
+}
+
+Sidebar* AnthraciteGui::ensureSidebar()
+{
+    auto* manager = Gui::DockWindowManager::instance();
+    if (auto* existing = qobject_cast<Sidebar*>(manager->getDockWindow("AnthraciteSidebar"))) {
+        return existing;
+    }
+
+    auto* sidebar = new Sidebar();
+    manager->addDockWindow("AnthraciteSidebar", sidebar, Qt::RightDockWidgetArea);
+    return sidebar;
+}
+
+void AnthraciteGui::showSidebar()
+{
+    auto* sidebar = ensureSidebar();
+    auto* dock = qobject_cast<QDockWidget*>(sidebar->parentWidget());
+    if (dock) {
+        dock->show();
+        dock->raise();
+    }
+    sidebar->setFocus();
+}
+
+SidebarController* AnthraciteGui::sidebarController()
+{
+    return ensureSidebar()->controller();
+}
