+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+import QtQuick 2.15
+import QtQuick.Controls 2.15
+import QtQuick.Controls.Basic
+import QtQuick.Layouts 1.15
+import "qrc:/Anthracite/qml" as Transcript
+
+Pane {
+    id: root
+    FontMetrics { id: controlFont; font: root.font }
+    readonly property real compactControlHeight: Math.max(28, Math.ceil(controlFont.height) + 8)
+    property bool reducedMotion: true
+    property string activeTab: "activity"
+    onActiveTabChanged: if (activeTab === "parameters") anthraciteController.refreshParameters()
+    onReducedMotionChanged: {
+        if (reducedMotion && latestMotion && latestMotion.running) {
+            latestMotion.stop()
+            timeline.latest()
+        }
+    }
+    function observeWheel(position) {
+        if (imagePreview.visible) return
+        const point = timeline.mapFromItem(root, position.x, position.y)
+        if (point.x >= 0 && point.y >= 0 && point.x < timeline.width && point.y < timeline.height)
+            timeline.navigate()
+    }
+    function refreshMotion() {
+        reducedMotion = anthraciteController.reducedMotion()
+    }
+    Component.onCompleted: refreshMotion()
+    Connections {
+        target: Qt.application
+        function onStateChanged() { root.refreshMotion() }
+    }
+
+    padding: 0
+
+    Popup {
+        id: imagePreview
+        property url imageSource
