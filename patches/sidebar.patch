+namespace {
+// Reproducible RCC timestamps cannot invalidate Qt's disk cache. Give only our
+// embedded components content-addressed URLs; leave FreeCAD's other QML alone.
+class SidebarQmlUrls final : public QObject, public QQmlAbstractUrlInterceptor
+{
+public:
+    explicit SidebarQmlUrls(QObject* parent) : QObject(parent) {}
+    QUrl intercept(const QUrl& url, DataType type) override
+    {
+        if (type != QmlFile || url.scheme() != QLatin1String("qrc")
+            || !url.path().startsWith(QLatin1String("/Anthracite/qml/"))) return url;
+        QUrl versioned(url);
+        versioned.setPath(QStringLiteral("/Anthracite/" ANTHRACITE_QML_VERSION)
+            + url.path().mid(QStringLiteral("/Anthracite").size()));
+        return versioned;
+    }
+};
+}
