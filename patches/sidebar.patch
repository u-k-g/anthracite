+void AgentBridge::processStarted()
+{
+    sidebar->updateStatus(tr("Connecting"));
+    runtimeDocumentIdentity = documentIdentity();
+    QJsonObject session {
+        {
+            "provider",
+            QJsonObject {
+                {"kind", providerKind()},
+                {"binary", providerPath()},
+            },
+        },
+        {"cwd", workingDirectory()},
+        {"storagePath", databasePath()},
+        {"document", documentContext()},
+        {"createThread", createNewThread},
+    };
+    if (!selectedLocalThreadId.isEmpty()) {
+        session.insert(QStringLiteral("localThreadId"), selectedLocalThreadId);
+    }
+    send(QStringLiteral("session.start"), session);
+    createNewThread = false;
+}
+
+void AgentBridge::readStandardOutput()
+{
+    standardOutputBuffer += runtime.readAllStandardOutput();
+    while (true) {
+        const qsizetype newline = standardOutputBuffer.indexOf('\n');
+        if (newline < 0) {
+            break;
+        }
+
+        const QByteArray line = standardOutputBuffer.left(newline).trimmed();
+        standardOutputBuffer.remove(0, newline + 1);
+        if (line.isEmpty()) {
+            continue;
+        }
+
+        QJsonParseError error;
+        const auto document = QJsonDocument::fromJson(line, &error);
+        if (error.error != QJsonParseError::NoError || !document.isObject()) {
+            Base::Console().warning("Anthracite runtime returned invalid JSON: %s\n", line.constData());
+            continue;
+        }
+        handleMessage(document.object());
+    }
+}
+
+void AgentBridge::readStandardError()
+{
+    const QString text = QString::fromUtf8(runtime.readAllStandardError()).trimmed();
+    if (!text.isEmpty()) {
+        Base::Console().warning("Anthracite runtime: %s\n", text.toUtf8().constData());
+    }
+}
+
+void AgentBridge::processError(QProcess::ProcessError error)
+{
+    Q_UNUSED(error);
+    if (!stopping) {
+        fail(tr("Agent runtime failed: %1").arg(runtime.errorString()));
+    }
+}
+
+void AgentBridge::processFinished(int exitCode, QProcess::ExitStatus exitStatus)
+{
+    runtimeReady = false;
+    if (!stopping && sidebar->busy()) {
+        const QString reason = exitStatus == QProcess::CrashExit
+            ? tr("Agent runtime crashed.")
+            : tr("Agent runtime exited with code %1.").arg(exitCode);
+        fail(reason);
+    }
+}
+
+void AgentBridge::ensureRuntime()
+{
+    if (runtime.state() != QProcess::NotRunning) {
+        return;
+    }
+
+    const QString provider = providerPath();
+    if (provider.isEmpty() || !QFileInfo::exists(provider)) {
+        const QString displayName = providerKind() == QLatin1String("opencode")
+            ? QStringLiteral("OpenCode")
+            : QStringLiteral("Codex");
+        fail(
+            tr("%1 was not found. Use Configure… to select your existing executable.")
+                .arg(displayName)
+        );
+        return;
+    }
+
+    const QString executable = runtimePath();
+    if (!QFileInfo::exists(executable)) {
+        fail(tr("Anthracite runtime was not found at %1").arg(executable));
+        return;
+    }
+
+    sidebar->appendActivity(
+        tr("Starting %1").arg(
+            providerKind() == QLatin1String("opencode") ? QStringLiteral("OpenCode")
+                                                        : QStringLiteral("Codex")
+        )
+    );
+    runtime.setProgram(executable);
+    runtime.setWorkingDirectory(workingDirectory());
+    runtime.start();
+}
+
+void AgentBridge::restartSession(const QString& threadId, bool createThread)
+{
+    draftTimer.stop();
+    if (draftDirty && runtimeReady) {
+        restartPending = true;
+        pendingRestartThreadId = threadId;
+        pendingRestartCreateThread = createThread;
+        pendingRestartSaveId = persistDraftNow();
+        return;
+    }
+    performSessionRestart(threadId, createThread);
+}
+
+void AgentBridge::performSessionRestart(const QString& threadId, bool createThread)
+{
+    restartPending = false;
+    pendingRestartSaveId = 0;
+    selectedLocalThreadId = threadId;
+    createNewThread = createThread;
+    assistantMessageStarted = false;
+    documentRevision.reset();
+    standardOutputBuffer.clear();
+    sidebar->clearInteraction();
+    sidebar->clearUsage();
+    selectedModel.clear();
+    selectedEffort.clear();
+    sidebar->restoreModelSelection(QString(), QString());
+
+    if (runtime.state() != QProcess::NotRunning) {
+        stopping = true;
+        runtime.kill();
+        runtime.waitForFinished(1000);
+        stopping = false;
+    }
+    runtimeReady = false;
+    ensureRuntime();
+}
+
+qint64 AgentBridge::persistDraftNow()
+{
+    if (!draftDirty || !runtimeReady) {
+        return 0;
+    }
+    const qint64 saveId = nextDraftSaveId++;
+    send(QStringLiteral("draft.save"), {{"body", pendingDraft}, {"saveId", saveId}});
+    draftDirty = false;
+    return saveId;
+}
+
+void AgentBridge::send(const QString& type, const QJsonObject& payload)
+{
+    if (runtime.state() == QProcess::NotRunning) {
+        return;
+    }
+    const QJsonObject message {
+        {"protocolVersion", 1},
+        {"type", type},
+        {"payload", payload},
+    };
+    runtime.write(QJsonDocument(message).toJson(QJsonDocument::Compact));
+    runtime.write("\n");
+}
+
+void AgentBridge::handleMessage(const QJsonObject& message)
+{
+    const QString type = message.value("type").toString();
+    const QJsonObject payload = message.value("payload").toObject();
+    if (type == QLatin1String("thread.local.ready")) {
+        selectedLocalThreadId = payload.value("localThreadId").toString();
+    }
+    else if (type == QLatin1String("thread.list")) {
+        sidebar->updateThreads(
+            payload.value("currentThreadId").toString(),
+            payload.value("threads").toArray().toVariantList()
+        );
+    }
+    else if (type == QLatin1String("history.snapshot")) {
+        const QJsonArray events = payload.value("events").toArray();
+        sidebar->resetHistory();
+        assistantMessageStarted = false;
+        for (const auto& value : events) {
+            const QJsonObject event = value.toObject();
+            if (event.value("type").toString() == QLatin1String("content.user")) {
+                sidebar->appendUserMessage(event.value("payload").toObject().value("text").toString());
+                assistantMessageStarted = false;
+            }
+            else {
+                handleMessage(event);
+            }
+        }
+        if (events.isEmpty()) {
+            sidebar->showWelcome();
+        }
+        if (!queuedPrompt.isEmpty()) {
+            sidebar->appendUserMessage(queuedPrompt);
+        }
+    }
+    else if (type == QLatin1String("draft.loaded")) {
+        pendingDraft = payload.value("body").toString();
+        draftDirty = false;
+        sidebar->loadDraft(pendingDraft);
+    }
+    else if (type == QLatin1String("draft.saved")) {
+        const qint64 saveId = payload.value("saveId").toInteger();
+        if (restartPending && saveId == pendingRestartSaveId) {
+            performSessionRestart(pendingRestartThreadId, pendingRestartCreateThread);
+        }
+    }
+    else if (type == QLatin1String("model.selection")) {
+        selectedModel = payload.value("model").toString();
+        selectedEffort = payload.value("effort").toString();
+        sidebar->restoreModelSelection(selectedModel, selectedEffort);
+        selectedModel = sidebar->selectedModel();
+        selectedEffort = sidebar->selectedEffort();
+    }
+    else if (type == QLatin1String("model.catalog")) {
+        sidebar->updateModelCatalog(payload.value("models").toArray().toVariantList());
+        selectedModel = sidebar->selectedModel();
+        selectedEffort = sidebar->selectedEffort();
+    }
+    else if (type == QLatin1String("usage.updated")) {
+        sidebar->updateUsage(payload.toVariantMap());
+    }
+    else if (type == QLatin1String("runtime.ready")) {
+        runtimeReady = true;
+        sidebar->appendActivity(
+            tr("%1 connected").arg(
+                payload.value("provider").toString() == QLatin1String("opencode")
+                    ? QStringLiteral("OpenCode")
+                    : QStringLiteral("Codex")
+            )
+        );
+        sidebar->updateStatus(queuedPrompt.isEmpty() ? tr("Ready") : tr("Thinking"));
+        persistDraft();
+        if (!queuedPrompt.isEmpty()) {
+            QJsonObject turnPayload {{"prompt", queuedPrompt}};
+            if (!selectedModel.isEmpty()) {
+                turnPayload.insert(QStringLiteral("model"), selectedModel);
+            }
+            if (!selectedEffort.isEmpty()) {
+                turnPayload.insert(QStringLiteral("effort"), selectedEffort);
+            }
+            send(QStringLiteral("turn.start"), turnPayload);
+            queuedPrompt.clear();
+        }
+    }
+    else if (type == QLatin1String("content.delta")
+             && payload.value("streamKind").toString() == QLatin1String("assistant_text")) {
+        sidebar->updateStatus(tr("Responding"));
+        if (!assistantMessageStarted) {
+            sidebar->beginAssistantMessage();
+            assistantMessageStarted = true;
+        }
+        sidebar->appendAssistantDelta(payload.value("text").toString());
+    }
+    else if (type == QLatin1String("item.started")) {
+        const QString title = payload.value("title").toString();
+        const QString detail = payload.value("detail").toString();
+        sidebar->appendActivity(detail.isEmpty() ? title : tr("%1: %2").arg(title, detail));
+    }
+    else if (type == QLatin1String("tool.call")) {
+        runFreeCADTool(payload);
+    }
+    else if (type == QLatin1String("request.opened")) {
+        sidebar->showApproval(
+            payload.value("requestId").toString(),
+            payload.value("title").toString(tr("Approval needed")),
+            payload.value("detail").toString(),
+            payload.value("allowSession").toBool()
+        );
+    }
+    else if (type == QLatin1String("user_input.requested")) {
+        sidebar->showUserInput(
+            payload.value("requestId").toString(),
+            payload.value("questions").toArray().toVariantList()
+        );
+    }
+    else if (type == QLatin1String("plan.updated")) {
+        sidebar->updatePlan(
+            payload.value("explanation").toString(),
+            payload.value("steps").toArray().toVariantList()
+        );
+    }
+    else if (type == QLatin1String("runtime.warning")) {
+        sidebar->appendActivity(payload.value("message").toString());
+    }
+    else if (type == QLatin1String("turn.completed")) {
+        const QString status = payload.value("status").toString();
+        if (status == QLatin1String("failed")) {
+            fail(payload.value("error").toString(tr("The provider turn failed.")));
+        }
+        else {
+            sidebar->completeTurn();
+        }
+    }
+    else if (type == QLatin1String("runtime.error")) {
+        fail(payload.value("message").toString(tr("Unknown agent error.")));
+    }
+}
