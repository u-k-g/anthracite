+AgentBridge::AgentBridge(SidebarController* controller, QObject* parent)
+    : QObject(parent)
+    , sidebar(controller)
+{
+    connect(sidebar, &SidebarController::promptSubmitted, this, &AgentBridge::submit);
+    connect(sidebar, &SidebarController::stopRequested, this, &AgentBridge::stop);
+    connect(sidebar, &SidebarController::chooseProviderRequested, this, &AgentBridge::chooseProvider);
+    connect(sidebar, &SidebarController::providerSelected, this, &AgentBridge::selectProvider);
+    connect(sidebar, &SidebarController::newThreadRequested, this, &AgentBridge::newThread);
+    connect(sidebar, &SidebarController::threadSelected, this, &AgentBridge::selectThread);
+    connect(sidebar, &SidebarController::draftEdited, this, &AgentBridge::draftEdited);
+    connect(sidebar, &SidebarController::modelSelectionEdited, this, &AgentBridge::modelSelectionEdited);
+    connect(sidebar, &SidebarController::approvalResponded, this, &AgentBridge::respondToApproval);
+    connect(sidebar, &SidebarController::userInputResponded, this, &AgentBridge::respondToUserInput);
+    connect(&runtime, &QProcess::started, this, &AgentBridge::processStarted);
+    connect(&runtime, &QProcess::readyReadStandardOutput, this, &AgentBridge::readStandardOutput);
+    connect(&runtime, &QProcess::readyReadStandardError, this, &AgentBridge::readStandardError);
+    connect(&runtime, &QProcess::errorOccurred, this, &AgentBridge::processError);
+    connect(
+        &runtime,
+        qOverload<int, QProcess::ExitStatus>(&QProcess::finished),
+        this,
+        &AgentBridge::processFinished
+    );
+    draftTimer.setSingleShot(true);
+    draftTimer.setInterval(250);
+    connect(&draftTimer, &QTimer::timeout, this, &AgentBridge::persistDraft);
+
+    activeDocumentConnection = App::GetApplication().signalActiveDocument.connect(
+        [this](const App::Document&) { scheduleDocumentSync(); }
+    );
+    savedDocumentConnection = App::GetApplication().signalSaveDocument.connect(
+        [this](const App::Document&) { scheduleDocumentSync(); }
+    );
+    deletedDocumentConnection = App::GetApplication().signalDeleteDocument.connect(
+        [this](const App::Document& document) { documentDeleted(document); }
+    );
+
+    sidebar->restoreProvider(providerKind());
+    QTimer::singleShot(0, this, [this]() {
+        if (!providerPath().isEmpty() && QFileInfo::exists(runtimePath())) {
+            ensureRuntime();
+        }
+    });
+}
+
+AgentBridge::~AgentBridge()
+{
+    draftTimer.stop();
+    if (runtime.state() == QProcess::NotRunning) {
+        return;
+    }
+
+    send(QStringLiteral("session.shutdown"));
+    runtime.closeWriteChannel();
+    if (!runtime.waitForFinished(1500)) {
+        runtime.terminate();
+        if (!runtime.waitForFinished(1000)) {
+            runtime.kill();
+            runtime.waitForFinished(1000);
+        }
+    }
+}
+
+void AgentBridge::submit(const QString& prompt)
+{
+    queuedPrompt = prompt;
+    assistantMessageStarted = false;
+    stopping = false;
+
+    if (runtimeReady) {
+        QJsonObject payload {{"prompt", queuedPrompt}};
+        if (!selectedModel.isEmpty()) {
+            payload.insert(QStringLiteral("model"), selectedModel);
+        }
+        if (!selectedEffort.isEmpty()) {
+            payload.insert(QStringLiteral("effort"), selectedEffort);
+        }
+        send(QStringLiteral("turn.start"), payload);
+        queuedPrompt.clear();
+        return;
+    }
+
+    ensureRuntime();
+}
+
+void AgentBridge::stop()
+{
+    stopping = true;
+    send(QStringLiteral("turn.interrupt"));
+}
+
+void AgentBridge::chooseProvider()
+{
+    const QString provider = providerKind();
+    const QString displayName =
+        provider == QLatin1String("opencode") ? QStringLiteral("OpenCode") : QStringLiteral("Codex");
+    const QString selected = QFileDialog::getOpenFileName(
+        QApplication::activeWindow(),
+        tr("Choose the %1 executable").arg(displayName),
+        providerPath()
+    );
+    if (selected.isEmpty()) {
+        return;
+    }
+
+    auto preferences = App::GetApplication().GetParameterGroupByPath(preferencePath);
+    const char* key = provider == QLatin1String("opencode") ? "OpenCodeBinary" : "CodexBinary";
+    preferences->SetASCII(key, selected.toUtf8().constData());
+    sidebar->appendActivity(tr("%1 executable set to %2").arg(displayName, selected));
+
+    if (runtime.state() != QProcess::NotRunning) {
+        stopping = true;
+        runtime.kill();
+        runtime.waitForFinished(1000);
+        stopping = false;
+    }
+    runtimeReady = false;
+    ensureRuntime();
+}
+
+void AgentBridge::selectProvider(const QString& provider)
+{
+    auto preferences = App::GetApplication().GetParameterGroupByPath(preferencePath);
+    preferences->SetASCII("Provider", provider.toUtf8().constData());
+    selectedLocalThreadId.clear();
+    createNewThread = false;
+    sidebar->appendActivity(
+        tr("Using %1").arg(
+            provider == QLatin1String("opencode") ? QStringLiteral("OpenCode")
+                                                   : QStringLiteral("Codex")
+        )
+    );
+    performSessionRestart(QString(), false);
+}
+
+void AgentBridge::newThread()
+{
+    restartSession(QString(), true);
+}
+
+void AgentBridge::selectThread(const QString& threadId)
+{
+    restartSession(threadId, false);
+}
