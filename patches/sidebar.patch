+namespace {
+QVariantMap imageAttachment(QImage image, const QString& name)
+{
+    if (image.isNull()) return {};
+    if (image.width() > 2048 || image.height() > 2048) {
+        image = image.scaled(2048, 2048, Qt::KeepAspectRatio, Qt::SmoothTransformation);
+    }
+    QByteArray bytes;
+    QBuffer buffer(&bytes);
+    buffer.open(QIODevice::WriteOnly);
+    if (!image.save(&buffer, "PNG")) return {};
+    return {{"type", "image"}, {"name", name},
+            {"dataUrl", QStringLiteral("data:image/png;base64,") + QString::fromLatin1(bytes.toBase64())}};
+}
+}
+
+bool SidebarController::pasteAttachments()
+{
+    if (turnBusy) return false;
+    const auto* mime = QApplication::clipboard()->mimeData();
+    if (mime->hasImage()) {
+        const auto image = QApplication::clipboard()->image();
+        prepareAttachment([image]() { return imageAttachment(image, tr("Pasted image.png")); });
+        return true;
+    }
+    if (mime->hasUrls()) {
+        bool local = false;
+        for (const auto& url : mime->urls()) {
+            if (url.isLocalFile()) { attachFile(url.toLocalFile()); local = true; }
+        }
+        return local;
+    }
+    return false; // Let Qt handle ordinary text paste.
+}
