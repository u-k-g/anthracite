+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonParseError>
+#include <QResource>
+#include <QTimer>
+
+#include <App/Application.h>
+#include <Base/Console.h>
+#include <Base/Interpreter.h>
+#include <Base/PyObjectBase.h>
+#include <Gui/Application.h>
+
+#include "StatusController.h"
+#include "Chrome.h"
+
+
+void CreateAnthraciteCommands();
+
+void initAnthraciteResources()
+{
+    Q_INIT_RESOURCE(Anthracite);
+}
+
+namespace AnthraciteGui
+{
+class Module: public Py::ExtensionModule<Module>
+{
+public:
+    Module()
+        : Py::ExtensionModule<Module>("AnthraciteGui")
+    {
+        add_varargs_method(
+            "push_bridge_status",
+            &Module::pushBridgeStatus,
+            "push_bridge_status(json) -- Update the bridge status shown in the status bar."
+        );
+        initialize("Native GUI integration for Anthracite.");
+    }
+
+private:
+    Py::Object pushBridgeStatus(const Py::Tuple& args)
+    {
+        const char* text = nullptr;
+        if (!PyArg_ParseTuple(args.ptr(), "s", &text)) {
+            throw Py::Exception();
+        }
+        QJsonParseError error;
+        const auto document = QJsonDocument::fromJson(QByteArray(text), &error);
+        if (error.error != QJsonParseError::NoError || !document.isObject()) {
+            throw Py::ValueError("push_bridge_status expects a JSON object.");
+        }
+        statusController()->applyBridgeStatus(document.object().toVariantMap());
+        return Py::None();
+    }
+};
+
+PyObject* initModule()
+{
+    return Base::Interpreter().addModule(new Module);
+}
+}  // namespace AnthraciteGui
+
+PyMOD_INIT_FUNC(AnthraciteGui)
+{
+    if (!Gui::Application::Instance) {
+        PyErr_SetString(PyExc_ImportError, "Cannot load AnthraciteGui in console mode.");
+        PyMOD_Return(nullptr);
+    }
+
+    initAnthraciteResources();
+    PyObject* module = AnthraciteGui::initModule();
+    CreateAnthraciteCommands();
+    QTimer::singleShot(0, []() { AnthraciteGui::installChrome(); });
+
+    Base::Console().log("Loading GUI of Anthracite module... done\n");
+    PyMOD_Return(module);
+}
