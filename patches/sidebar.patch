+using ProgressCallback = std::function<void(const QString&)>;
+PyObject* reportExecutionStage(PyObject* self, PyObject* stage)
+{
+    const char* text = PyUnicode_AsUTF8(stage);
+    if (!text) return nullptr;
+    auto* callback = static_cast<ProgressCallback*>(PyCapsule_GetPointer(self, "anthracite.progress"));
+    if (!callback) return nullptr;
+    (*callback)(QString::fromUtf8(text));
+    Py_RETURN_NONE;
+}
+PyMethodDef progressMethod = {"report_stage", reportExecutionStage, METH_O, nullptr};
+
+QString pythonError()
+{
+    if (!PyErr_Occurred()) {
+        return QStringLiteral("Unknown embedded Python error.");
+    }
+
+    PyObject* type = nullptr;
+    PyObject* value = nullptr;
+    PyObject* traceback = nullptr;
+    PyErr_Fetch(&type, &value, &traceback);
+    PyErr_NormalizeException(&type, &value, &traceback);
+
+    QString result = QStringLiteral("Embedded Python error.");
+    if (value) {
+        PyObject* text = PyObject_Str(value);
+        if (text) {
+            result = QString::fromUtf8(PyUnicode_AsUTF8(text));
+            Py_DECREF(text);
+        }
+    }
+
+    Py_XDECREF(type);
+    Py_XDECREF(value);
+    Py_XDECREF(traceback);
+    return result;
+}
