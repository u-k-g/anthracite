+        id: messageText
+        objectName: "transcriptText"
+        width: parent.width
+        height: root.foldLong && !root.expanded ? Math.min(contentHeight, 120) : contentHeight
+        clip: true
+        text: root.body
+        textFormat: root.markdown ? TextEdit.MarkdownText : TextEdit.PlainText
+        readOnly: true
+        selectByMouse: true
+        onSelectedTextChanged: if (selectedText.length) root.resizing()
