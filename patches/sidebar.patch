+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+// Native text-document glue: a CAD mention is one inline image character, not editable label text.
+#include "Sidebar.h"
+
+#include <QApplication>
+#include <QBuffer>
+#include <QClipboard>
+#include <QPainter>
+#include <QQuickTextDocument>
+#include <QTextBlock>
+#include <QTextCursor>
+#include <QTextDocument>
+#include <QTextDocumentFragment>
+#include <QTextImageFormat>
+#include <QUuid>
+#include <QSet>
+#include <algorithm>
+
+using namespace AnthraciteGui;
+
+namespace {
+constexpr int tokenProperty = QTextFormat::UserProperty + 1;
+}
+
+void SidebarController::bindComposer(QObject* quickDocument)
+{
+    auto* quick = qobject_cast<QQuickTextDocument*>(quickDocument);
+    if (!quick) return;
+    if (composerDocument) disconnect(composerDocument, nullptr, this, nullptr);
+    composerDocument = quick->textDocument();
+    connect(composerDocument, &QTextDocument::contentsChanged, this, &SidebarController::readComposer);
+    renderComposer();
+}
+
+void SidebarController::setComposerSelection(int start, int end)
+{
+    if (updatingComposer) return;
+    composerSelectionStart = start;
+    composerSelectionEnd = end;
+}
+
+QString SidebarController::composerPlainText(QTextDocument* document) const
+{
+    QString result;
+    for (auto block = document->begin(); block.isValid(); block = block.next()) {
+        if (block != document->begin()) result += QLatin1Char('\n');
+        for (auto it = block.begin(); !it.atEnd(); ++it) {
+            const auto fragment = it.fragment();
+            if (fragment.charFormat().isImageFormat()) {
+                const auto id = fragment.charFormat().property(tokenProperty).toString();
+                if (composerTokens.contains(id)) result += composerTokens.value(id).value("token").toString();
+            } else {
+                result += fragment.text();
+            }
+        }
+    }
+    return result;
+}
+
+void SidebarController::readComposer()
+{
+    if (updatingComposer || !composerDocument) return;
+    const QString nextDraft = composerPlainText(composerDocument);
+    const bool draftChangedValue = nextDraft != currentDraft;
+    currentDraft = nextDraft;
+    QVariantList active;
+    for (const auto& item : currentAttachments) {
+        if (item.toMap().value("type").toString() != QLatin1String("cad")) active.append(item);
+    }
+    QSet<QString> seen;
+    for (auto block = composerDocument->begin(); block.isValid(); block = block.next()) {
+        for (auto it = block.begin(); !it.atEnd(); ++it) {
+            if (!it.fragment().charFormat().isImageFormat()) continue;
+            const auto id = it.fragment().charFormat().property(tokenProperty).toString();
+            if (composerTokens.contains(id) && !seen.contains(id)) {
+                active.append(composerTokens.value(id));
+                seen.insert(id);
+            }
+        }
+    }
+    const bool attachmentsChangedValue = currentAttachments != active;
+    if (attachmentsChangedValue) {
+        currentAttachments = active;
+        Q_EMIT attachmentsChanged();
+    }
+    if (draftChangedValue) Q_EMIT draftChanged();
+    if (draftChangedValue || attachmentsChangedValue) Q_EMIT draftEdited(currentDraft);
+}
+
+void SidebarController::insertComposerToken(QTextCursor& cursor, const QVariantMap& token)
+{
+    const QString id = token.value("id").toString();
+    const QString label = token.value("name").toString();
+    const QFont font = composerDocument->defaultFont();
+    const QFontMetrics metrics(font);
+    const QString display = metrics.elidedText(label, Qt::ElideMiddle, 250);
+    const QSize size(metrics.horizontalAdvance(display) + 16, metrics.height() + 8);
+    QImage image(size * 2, QImage::Format_ARGB32_Premultiplied);
+    image.setDevicePixelRatio(2);
+    image.fill(Qt::transparent);
+    image.setText("anthracite-token", id);
+    QPainter painter(&image);
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.setPen(Qt::NoPen);
+    auto background = qApp->palette().highlight().color();
+    background.setAlpha(65);
+    painter.setBrush(background);
+    painter.drawRoundedRect(QRectF(QPointF(0, 0), size), 5, 5);
+    painter.setFont(font);
+    painter.setPen(qApp->palette().text().color());
+    painter.drawText(QRect(QPoint(), size), Qt::AlignCenter, display);
+    painter.end();
+    QByteArray png;
+    QBuffer buffer(&png);
+    buffer.open(QIODevice::WriteOnly);
+    image.save(&buffer, "PNG");
+    QTextImageFormat format;
+    format.setName(QStringLiteral("data:image/png;base64,") + QString::fromLatin1(png.toBase64()));
+    format.setWidth(size.width());
+    format.setHeight(size.height());
+    format.setToolTip(label);
+    format.setProperty(tokenProperty, id);
+    cursor.insertImage(format);
+    // Following text must not inherit the object's identity.
+    cursor.setCharFormat(QTextCharFormat());
+}
+
+void SidebarController::insertComposerText(QTextCursor& cursor, const QString& text)
+{
+    int position = 0;
+    while (position < text.size()) {
+        int next = text.size();
+        QVariantMap found;
+        for (const auto& token : composerTokens) {
+            const QString marker = token.value("token").toString();
+            const int index = marker.isEmpty() ? -1 : text.indexOf(marker, position);
+            if (index >= 0 && index < next) { next = index; found = token; }
+        }
+        cursor.insertText(text.mid(position, next - position));
+        if (found.isEmpty()) break;
+        insertComposerToken(cursor, found);
+        position = next + found.value("token").toString().size();
+    }
+}
+
+void SidebarController::renderComposer()
+{
+    if (!composerDocument) return;
+    updatingComposer = true;
+    Q_EMIT composerCursorRequested(0);
+    composerDocument->clear();
+    QTextCursor cursor(composerDocument);
+    insertComposerText(cursor, currentDraft);
+    composerDocument->clearUndoRedoStacks();
+    composerSelectionStart = composerSelectionEnd = cursor.position();
+    updatingComposer = false;
+    Q_EMIT composerCursorRequested(cursor.position());
+}
+
+void SidebarController::insertPick(QVariantMap attachment)
+{
+    const QString id = QUuid::createUuid().toString(QUuid::WithoutBraces);
+    attachment.insert("id", id);
+    attachment.insert("token", QStringLiteral("@[%1 #%2]").arg(attachment.value("name").toString(), id));
+    composerTokens.insert(id, attachment);
+    if (!composerDocument) return;
+    QTextCursor cursor(composerDocument);
+    cursor.setPosition(std::clamp(composerSelectionStart, 0, composerDocument->characterCount() - 1));
+    cursor.setPosition(std::clamp(composerSelectionEnd, 0, composerDocument->characterCount() - 1), QTextCursor::KeepAnchor);
+    cursor.beginEditBlock();
+    insertComposerToken(cursor, attachment);
+    cursor.endEditBlock();
+    Q_EMIT composerCursorRequested(cursor.position());
+}
+
+void SidebarController::copyComposerSelection(bool cut)
+{
+    if (!composerDocument) return;
+    QTextCursor cursor(composerDocument);
+    cursor.setPosition(std::clamp(composerSelectionStart, 0, composerDocument->characterCount() - 1));
+    cursor.setPosition(std::clamp(composerSelectionEnd, 0, composerDocument->characterCount() - 1), QTextCursor::KeepAnchor);
+    if (!cursor.hasSelection()) return;
+    QTextDocument selected;
+    QTextCursor(&selected).insertFragment(cursor.selection());
+    QApplication::clipboard()->setText(composerPlainText(&selected));
+    if (cut) cursor.removeSelectedText();
+}
+
+void SidebarController::pasteComposerText()
+{
+    if (!composerDocument) return;
+    QTextCursor cursor(composerDocument);
+    cursor.setPosition(std::clamp(composerSelectionStart, 0, composerDocument->characterCount() - 1));
+    cursor.setPosition(std::clamp(composerSelectionEnd, 0, composerDocument->characterCount() - 1), QTextCursor::KeepAnchor);
+    cursor.beginEditBlock();
+    cursor.removeSelectedText();
+    // Only restore known local tokens. Never load arbitrary clipboard HTML/image resources.
+    insertComposerText(cursor, QApplication::clipboard()->text());
+    cursor.endEditBlock();
+    Q_EMIT composerCursorRequested(cursor.position());
+}
