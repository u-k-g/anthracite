+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "ConversationModel.h"
+
+#include <utility>
+
+
+using namespace AnthraciteGui;
+
+ConversationModel::ConversationModel(QObject* parent)
+    : QAbstractListModel(parent)
+{}
+
+int ConversationModel::rowCount(const QModelIndex& parent) const
+{
+    return parent.isValid() ? 0 : static_cast<int>(messages.size());
+}
+
+QVariant ConversationModel::data(const QModelIndex& index, int role) const
+{
+    if (!index.isValid() || index.row() < 0 || index.row() >= static_cast<int>(messages.size())) {
+        return {};
+    }
+
+    const auto& message = messages.at(static_cast<std::size_t>(index.row()));
+    switch (role) {
+        case AuthorRole:
+            return message.author;
+        case BodyRole:
+            return message.body;
+        case KindRole:
+            return message.kind;
+        default:
+            return {};
+    }
+}
+
+QHash<int, QByteArray> ConversationModel::roleNames() const
+{
+    return {
+        {AuthorRole, "author"},
+        {BodyRole, "body"},
+        {KindRole, "kind"},
+    };
+}
+
+void ConversationModel::append(QString author, QString body, QString kind)
+{
+    const int row = static_cast<int>(messages.size());
+    beginInsertRows({}, row, row);
+    messages.push_back({std::move(author), std::move(body), std::move(kind)});
+    endInsertRows();
+}
+
+void ConversationModel::beginAssistantMessage()
+{
+    append(QStringLiteral("Anthracite"), {}, QStringLiteral("assistant"));
+}
+
+void ConversationModel::appendAssistantDelta(const QString& delta)
+{
+    if (messages.empty() || messages.back().kind != QLatin1String("assistant")) {
+        beginAssistantMessage();
+    }
+
+    messages.back().body += delta;
+    const int row = static_cast<int>(messages.size()) - 1;
+    Q_EMIT dataChanged(index(row), index(row), {BodyRole});
+}
