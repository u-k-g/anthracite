+namespace AnthraciteGui
+{
+class Module: public Py::ExtensionModule<Module>
+{
+public:
+    Module()
+        : Py::ExtensionModule<Module>("AnthraciteGui")
+    {
+        initialize("Native GUI integration for Anthracite.");
+    }
+};
+
+PyObject* initModule()
+{
+    return Base::Interpreter().addModule(new Module);
+}
+}  // namespace AnthraciteGui
+
+PyMOD_INIT_FUNC(AnthraciteGui)
+{
+    if (!Gui::Application::Instance) {
+        PyErr_SetString(PyExc_ImportError, "Cannot load AnthraciteGui in console mode.");
+        PyMOD_Return(nullptr);
+    }
+
+    Q_INIT_RESOURCE(Anthracite);
+    PyObject* module = AnthraciteGui::initModule();
+    CreateAnthraciteCommands();
+    AnthraciteGui::ensureSidebar();
+
+    auto preferences = App::GetApplication().GetParameterGroupByPath(
+        "User parameter:BaseApp/Preferences/Mod/Anthracite"
+    );
+    if (!preferences->GetBool("SidebarInitialized", false)) {
+        preferences->SetBool("SidebarInitialized", true);
+        QTimer::singleShot(0, []() { AnthraciteGui::showSidebar(); });
+    }
+
+    Base::Console().log("Loading GUI of Anthracite module... done\n");
+    PyMOD_Return(module);
+}
