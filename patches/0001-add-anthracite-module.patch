+                    implicitHeight: messageColumn.implicitHeight + 18
+                    radius: 8
+                    color: kind === "user"
+                           ? Qt.rgba(0.30, 0.52, 0.95, 0.16)
+                           : kind === "error"
+                             ? Qt.rgba(0.90, 0.25, 0.25, 0.15)
