+_EDITABLE_TEXT = {"App::PropertyString"}
+_EDITABLE_BOOL = {"App::PropertyBool"}
+_EDITABLE_ENUM = {"App::PropertyEnumeration"}
+_DIMENSION_CONSTRAINTS = {"Distance", "DistanceX", "DistanceY", "Radius", "Diameter", "Angle"}
