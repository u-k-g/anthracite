+              "state": list(obj.State),
+              "dependsOn": [x.Name for x in obj.OutList[:100]], "dependencyCount": len(obj.OutList),
+              "usedBy": [x.Name for x in obj.InList[:100]], "usedByCount": len(obj.InList)}
