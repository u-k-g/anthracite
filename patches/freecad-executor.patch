+_EDITABLE_NUMBERS = {
+    "App::PropertyLength": "mm",
+    "App::PropertyDistance": "mm",
+    "App::PropertyAngle": "deg",
+    "App::PropertyPercent": "%",
+    "App::PropertyFloat": "",
+    "App::PropertyFloatConstraint": "",
+    "App::PropertyInteger": "",
+    "App::PropertyIntegerConstraint": "",
