+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "AgentBridge.h"
+
+#include "Sidebar.h"
+
+#include <Python.h>
+
+#include <QApplication>
+#include <QDir>
+#include <QFileDialog>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QJsonArray>
+#include <QJsonObject>
+#include <QStandardPaths>
+#include <QThread>
+
+#include <App/Application.h>
+#include <App/Document.h>
+#include <Base/Console.h>
+
+
+using namespace AnthraciteGui;
+
+namespace
+{
+constexpr auto preferencePath = "User parameter:BaseApp/Preferences/Mod/Anthracite";
+
+QString pythonError()
+{
+    if (!PyErr_Occurred()) {
+        return QStringLiteral("Unknown embedded Python error.");
+    }
+
+    PyObject* type = nullptr;
+    PyObject* value = nullptr;
+    PyObject* traceback = nullptr;
+    PyErr_Fetch(&type, &value, &traceback);
+    PyErr_NormalizeException(&type, &value, &traceback);
+
+    QString result = QStringLiteral("Embedded Python error.");
+    if (value) {
+        PyObject* text = PyObject_Str(value);
+        if (text) {
+            result = QString::fromUtf8(PyUnicode_AsUTF8(text));
+            Py_DECREF(text);
+        }
+    }
+
+    Py_XDECREF(type);
+    Py_XDECREF(value);
+    Py_XDECREF(traceback);
+    return result;
+}
+}  // namespace
+
+AgentBridge::AgentBridge(SidebarController* controller, QObject* parent)
+    : QObject(parent)
+    , sidebar(controller)
+{
+    connect(sidebar, &SidebarController::promptSubmitted, this, &AgentBridge::submit);
+    connect(sidebar, &SidebarController::stopRequested, this, &AgentBridge::stop);
+    connect(sidebar, &SidebarController::chooseProviderRequested, this, &AgentBridge::chooseProvider);
+    connect(&runtime, &QProcess::started, this, &AgentBridge::processStarted);
+    connect(&runtime, &QProcess::readyReadStandardOutput, this, &AgentBridge::readStandardOutput);
+    connect(&runtime, &QProcess::readyReadStandardError, this, &AgentBridge::readStandardError);
+    connect(&runtime, &QProcess::errorOccurred, this, &AgentBridge::processError);
+    connect(
+        &runtime,
+        qOverload<int, QProcess::ExitStatus>(&QProcess::finished),
+        this,
+        &AgentBridge::processFinished
+    );
+}
+
+void AgentBridge::submit(const QString& prompt)
+{
+    queuedPrompt = prompt;
+    assistantMessageStarted = false;
+    stopping = false;
+
+    if (runtimeReady) {
+        send({{"type", "turn"}, {"prompt", queuedPrompt}});
+        queuedPrompt.clear();
+        return;
+    }
+
+    ensureRuntime();
+}
+
+void AgentBridge::stop()
+{
+    stopping = true;
+    send({{"type", "interrupt"}});
+}
+
+void AgentBridge::chooseProvider()
+{
+    const QString selected = QFileDialog::getOpenFileName(
+        QApplication::activeWindow(),
+        tr("Choose the Codex executable"),
+        codexPath()
+    );
+    if (selected.isEmpty()) {
+        return;
+    }
+
+    auto preferences = App::GetApplication().GetParameterGroupByPath(preferencePath);
+    preferences->SetASCII("CodexBinary", selected.toUtf8().constData());
+    sidebar->appendActivity(tr("Codex executable set to %1").arg(selected));
+
+    if (runtime.state() != QProcess::NotRunning) {
+        runtime.kill();
+        runtime.waitForFinished(1000);
+    }
+    runtimeReady = false;
+}
+
+void AgentBridge::processStarted()
+{
+    sidebar->updateStatus(tr("Connecting"));
+    send({
+        {"type", "start"},
+        {"provider", "codex"},
+        {"binary", codexPath()},
+        {"cwd", workingDirectory()},
+    });
+}
+
+void AgentBridge::readStandardOutput()
+{
+    standardOutputBuffer += runtime.readAllStandardOutput();
+    while (true) {
+        const qsizetype newline = standardOutputBuffer.indexOf('\n');
+        if (newline < 0) {
+            break;
+        }
+
+        const QByteArray line = standardOutputBuffer.left(newline).trimmed();
+        standardOutputBuffer.remove(0, newline + 1);
+        if (line.isEmpty()) {
+            continue;
+        }
+
+        QJsonParseError error;
+        const auto document = QJsonDocument::fromJson(line, &error);
+        if (error.error != QJsonParseError::NoError || !document.isObject()) {
+            Base::Console().warning("Anthracite runtime returned invalid JSON: %s\n", line.constData());
+            continue;
+        }
+        handleMessage(document.object());
+    }
+}
+
+void AgentBridge::readStandardError()
+{
+    const QString text = QString::fromUtf8(runtime.readAllStandardError()).trimmed();
+    if (!text.isEmpty()) {
+        Base::Console().warning("Anthracite runtime: %s\n", text.toUtf8().constData());
+    }
+}
+
+void AgentBridge::processError(QProcess::ProcessError error)
+{
+    Q_UNUSED(error);
+    if (!stopping) {
+        fail(tr("Agent runtime failed: %1").arg(runtime.errorString()));
+    }
+}
+
+void AgentBridge::processFinished(int exitCode, QProcess::ExitStatus exitStatus)
+{
+    runtimeReady = false;
+    if (!stopping && sidebar->busy()) {
+        const QString reason = exitStatus == QProcess::CrashExit
+            ? tr("Agent runtime crashed.")
+            : tr("Agent runtime exited with code %1.").arg(exitCode);
+        fail(reason);
+    }
+}
+
+void AgentBridge::ensureRuntime()
+{
+    if (runtime.state() != QProcess::NotRunning) {
+        return;
+    }
+
+    const QString provider = codexPath();
+    if (provider.isEmpty() || !QFileInfo::exists(provider)) {
+        fail(tr("Codex was not found. Use Configure… to select your existing Codex executable."));
+        return;
+    }
+
+    const QString executable = runtimePath();
+    if (!QFileInfo::exists(executable)) {
+        fail(tr("Anthracite runtime was not found at %1").arg(executable));
+        return;
+    }
+
+    sidebar->appendActivity(tr("Starting Codex"));
+    runtime.setProgram(executable);
+    runtime.setWorkingDirectory(workingDirectory());
+    runtime.start();
+}
+
+void AgentBridge::send(const QJsonObject& message)
+{
+    if (runtime.state() == QProcess::NotRunning) {
+        return;
+    }
+    runtime.write(QJsonDocument(message).toJson(QJsonDocument::Compact));
+    runtime.write("\n");
+}
+
+void AgentBridge::handleMessage(const QJsonObject& message)
+{
+    const QString type = message.value("type").toString();
+    if (type == QLatin1String("ready")) {
+        runtimeReady = true;
+        sidebar->appendActivity(tr("Codex connected"));
+        sidebar->updateStatus(tr("Thinking"));
+        if (!queuedPrompt.isEmpty()) {
+            send({{"type", "turn"}, {"prompt", queuedPrompt}});
+            queuedPrompt.clear();
+        }
+    }
+    else if (type == QLatin1String("assistant_delta")) {
+        sidebar->updateStatus(tr("Responding"));
+        if (!assistantMessageStarted) {
+            sidebar->beginAssistantMessage();
+            assistantMessageStarted = true;
+        }
+        sidebar->appendAssistantDelta(message.value("text").toString());
+    }
+    else if (type == QLatin1String("activity")) {
+        sidebar->appendActivity(message.value("text").toString());
+    }
+    else if (type == QLatin1String("tool_call")) {
+        runFreeCADTool(message);
+    }
+    else if (type == QLatin1String("turn_completed")) {
+        sidebar->completeTurn();
+    }
+    else if (type == QLatin1String("error")) {
+        fail(message.value("message").toString(tr("Unknown agent error.")));
+    }
+}
+
+void AgentBridge::runFreeCADTool(const QJsonObject& message)
+{
+    Q_ASSERT(QThread::currentThread() == qApp->thread());
+    sidebar->updateStatus(tr("Editing"));
+    sidebar->appendActivity(tr("Running FreeCAD Python"));
+
+    bool success = false;
+    const QString result = executePython(message.value("code").toString(), success);
+    const auto resultDocument = QJsonDocument::fromJson(result.toUtf8());
+    if (resultDocument.isObject()) {
+        const auto resultObject = resultDocument.object();
+        if (resultObject.value("revision").isDouble()) {
+            documentRevision = resultObject.value("revision").toInt();
+        }
+        const auto observation = resultObject.value("observation").toObject();
+        const int created = observation.value("created").toArray().size();
+        const int changed = observation.value("changed").toArray().size();
+        const int deleted = observation.value("deleted").toArray().size();
+        sidebar->appendActivity(
+            tr("FreeCAD: %1 created, %2 changed, %3 deleted").arg(created).arg(changed).arg(deleted)
+        );
+    }
+
+    send({
+        {"type", "tool_result"},
+        {"requestId", message.value("requestId")},
+        {"result", result},
+        {"success", success},
+    });
+}
+
+QString AgentBridge::executePython(const QString& source, bool& success)
+{
+    success = false;
+    const PyGILState_STATE state = PyGILState_Ensure();
+    PyObject* module = PyImport_ImportModule("AnthraciteExecutor");
+    if (!module) {
+        const QString error = pythonError();
+        PyGILState_Release(state);
+        return QString::fromUtf8(
+            QJsonDocument(
+                QJsonObject {
+                    {"ok", false},
+                    {"error", QJsonObject {{"type", "ImportError"}, {"message", error}}},
+                }
+            )
+                .toJson(QJsonDocument::Compact)
+        );
+    }
+
+    const QByteArray encoded = source.toUtf8();
+    PyObject* result = documentRevision
+        ? PyObject_CallMethod(module, "execute_json", "si", encoded.constData(), *documentRevision)
+        : PyObject_CallMethod(module, "execute_json", "s", encoded.constData());
+    Py_DECREF(module);
+
+    if (!result) {
+        const QString error = pythonError();
+        PyGILState_Release(state);
+        return QString::fromUtf8(
+            QJsonDocument(
+                QJsonObject {
+                    {"ok", false},
+                    {"error", QJsonObject {{"type", "PythonError"}, {"message", error}}},
+                }
+            )
+                .toJson(QJsonDocument::Compact)
+        );
+    }
+
+    const char* encodedResult = PyUnicode_AsUTF8(result);
+    const QString text = encodedResult
+        ? QString::fromUtf8(encodedResult)
+        : QStringLiteral(
+              R"({"ok":false,"error":{"type":"EncodingError","message":"Executor returned non-text."}})"
+          );
+    Py_DECREF(result);
+    PyGILState_Release(state);
+
+    const auto document = QJsonDocument::fromJson(text.toUtf8());
+    success = document.isObject() && document.object().value("ok").toBool();
+    return text;
+}
+
+QString AgentBridge::runtimePath() const
+{
+    return QDir(QString::fromStdString(App::Application::getHomePath()))
+        .filePath(QStringLiteral("Mod/Anthracite/anthracite-runtime"));
+}
+
+QString AgentBridge::codexPath() const
+{
+    const auto preferences = App::GetApplication().GetParameterGroupByPath(preferencePath);
+    const QString configured = QString::fromStdString(preferences->GetASCII("CodexBinary", ""));
+    if (!configured.isEmpty()) {
+        return configured;
+    }
+    return QStandardPaths::findExecutable(QStringLiteral("codex"));
+}
+
+QString AgentBridge::workingDirectory() const
+{
+    if (const auto* document = App::GetApplication().getActiveDocument()) {
+        const std::string fileName = document->getFileName();
+        if (!fileName.empty()) {
+            return QFileInfo(QString::fromStdString(fileName)).absolutePath();
+        }
+    }
+    return QDir::currentPath();
+}
+
+void AgentBridge::fail(const QString& message)
+{
+    queuedPrompt.clear();
+    sidebar->failTurn(message);
+}
