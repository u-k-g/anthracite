+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+use serde_json::{Value, json};
+use std::io::{self, BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::{Arc, Mutex, mpsc};
+use std::thread;
+
+const INITIALIZE_ID: u64 = 1;
+const THREAD_START_ID: u64 = 2;
+
+enum Event {
+    HostLine(String),
+    HostClosed,
+    ServerLine(String),
+    ServerError(String),
+    ServerClosed,
+}
+
+struct Provider {
+    child: Child,
+    input: Arc<Mutex<ChildStdin>>,
+    next_request_id: u64,
+    thread_id: Option<String>,
+    turn_id: Option<String>,
+}
+
+impl Provider {
+    fn send(&self, value: &Value) -> Result<(), String> {
+        let mut input = self
+            .input
+            .lock()
+            .map_err(|_| "Codex input lock was poisoned.".to_string())?;
+        serde_json::to_writer(&mut *input, value).map_err(|error| error.to_string())?;
+        input.write_all(b"\n").map_err(|error| error.to_string())?;
+        input.flush().map_err(|error| error.to_string())
+    }
+
+    fn request(&mut self, method: &str, params: Value) -> Result<u64, String> {
+        let id = self.next_request_id;
+        self.next_request_id += 1;
+        self.send(&json!({"id": id, "method": method, "params": params}))?;
+        Ok(id)
+    }
+}
+
+impl Drop for Provider {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+fn emit(value: Value) {
+    let stdout = io::stdout();
+    let mut output = stdout.lock();
+    if serde_json::to_writer(&mut output, &value).is_ok() {
+        let _ = output.write_all(b"\n");
+        let _ = output.flush();
+    }
+}
+
+fn emit_error(message: impl Into<String>) {
+    emit(json!({"type": "error", "message": message.into()}));
+}
+
+fn spawn_line_reader<R: io::Read + Send + 'static>(
+    reader: R,
+    sender: mpsc::Sender<Event>,
+    map: fn(String) -> Event,
+    closed: Option<Event>,
+) {
+    thread::spawn(move || {
+        for line in BufReader::new(reader).lines() {
+            match line {
+                Ok(line) => {
+                    if sender.send(map(line)).is_err() {
+                        return;
+                    }
+                }
+                Err(error) => {
+                    let _ = sender.send(Event::ServerError(error.to_string()));
+                    return;
+                }
+            }
+        }
+        if let Some(event) = closed {
+            let _ = sender.send(event);
+        }
+    });
+}
+
+fn start_provider(
+    binary: &str,
+    cwd: &str,
+    sender: &mpsc::Sender<Event>,
+) -> Result<Provider, String> {
+    let mut child = Command::new(binary)
+        .arg("app-server")
+        .current_dir(cwd)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|error| format!("Could not start Codex at {binary}: {error}"))?;
+
+    let input = child
+        .stdin
+        .take()
+        .ok_or_else(|| "Codex did not expose standard input.".to_string())?;
+    let output = child
+        .stdout
+        .take()
+        .ok_or_else(|| "Codex did not expose standard output.".to_string())?;
+    let errors = child
+        .stderr
+        .take()
+        .ok_or_else(|| "Codex did not expose standard error.".to_string())?;
+
+    spawn_line_reader(
+        output,
+        sender.clone(),
+        Event::ServerLine,
+        Some(Event::ServerClosed),
+    );
+    spawn_line_reader(errors, sender.clone(), Event::ServerError, None);
+
+    let provider = Provider {
+        child,
+        input: Arc::new(Mutex::new(input)),
+        next_request_id: 3,
+        thread_id: None,
+        turn_id: None,
+    };
+    provider.send(&json!({
+        "id": INITIALIZE_ID,
+        "method": "initialize",
+        "params": {
+            "clientInfo": {
+                "name": "anthracite_freecad",
+                "title": "Anthracite for FreeCAD",
+                "version": env!("CARGO_PKG_VERSION")
+            },
+            "capabilities": {
+                "experimentalApi": true
+            }
+        }
+    }))?;
+    Ok(provider)
+}
+
+fn thread_start(provider: &Provider, cwd: &str) -> Result<(), String> {
+    provider.send(&json!({
+        "id": THREAD_START_ID,
+        "method": "thread/start",
+        "params": {
+            "cwd": cwd,
+            "serviceName": "anthracite_freecad",
+            "developerInstructions": concat!(
+                "You are operating inside FreeCAD through Anthracite. ",
+                "Use the freecad tool for CAD inspection and every CAD mutation. ",
+                "The tool accepts ordinary FreeCAD Python with App, Gui, doc, and cad available. ",
+                "Prefer parametric, named objects and constraints. Inspect before editing. ",
+                "A tool call is one undoable transaction: failures roll back automatically. ",
+                "Read the returned observation, fix errors, and verify the finished model."
+            ),
+            "dynamicTools": [{
+                "type": "function",
+                "name": "freecad",
+                "description": concat!(
+                    "Execute ordinary Python inside the active FreeCAD GUI. ",
+                    "App/FreeCAD, Gui, doc, and a small cad inspection helper are prebound. ",
+                    "The complete source runs as one transaction, recomputes and validates, ",
+                    "then returns result/stdout plus created, changed, and deleted objects."
+                ),
+                "inputSchema": {
+                    "type": "object",
+                    "properties": {
+                        "code": {
+                            "type": "string",
+                            "description": "Complete ordinary FreeCAD Python source."
+                        }
+                    },
+                    "required": ["code"],
+                    "additionalProperties": false
+                }
+            }]
+        }
+    }))
+}
+
+fn start_turn(provider: &mut Provider, prompt: &str) -> Result<(), String> {
+    let thread_id = provider
+        .thread_id
+        .clone()
+        .ok_or_else(|| "Codex thread is not ready.".to_string())?;
+    provider.request(
+        "turn/start",
+        json!({
+            "threadId": thread_id,
+            "input": [{
+                "type": "text",
+                "text": prompt,
+                "textElements": []
+            }]
+        }),
+    )?;
+    emit(json!({"type": "activity", "text": "Codex is thinking"}));
+    Ok(())
+}
+
+fn handle_host_message(
+    message: Value,
+    provider: &mut Option<Provider>,
+    sender: &mpsc::Sender<Event>,
+) -> bool {
+    let command = message.get("type").and_then(Value::as_str).unwrap_or("");
+    match command {
+        "start" => {
+            let binary = message.get("binary").and_then(Value::as_str).unwrap_or("");
+            let cwd = message.get("cwd").and_then(Value::as_str).unwrap_or(".");
+            if message.get("provider").and_then(Value::as_str) != Some("codex") {
+                emit_error("Only the Codex adapter is implemented in this vertical slice.");
+                return true;
+            }
+            match start_provider(binary, cwd, sender) {
+                Ok(started) => *provider = Some(started),
+                Err(error) => emit_error(error),
+            }
+        }
+        "turn" => {
+            let prompt = message.get("prompt").and_then(Value::as_str).unwrap_or("");
+            match provider {
+                Some(provider) => {
+                    if let Err(error) = start_turn(provider, prompt) {
+                        emit_error(error);
+                    }
+                }
+                None => emit_error("Codex is not running."),
+            }
+        }
+        "tool_result" => {
+            let Some(provider) = provider else {
+                emit_error("Codex is not running.");
+                return true;
+            };
+            let Some(request_id) = message.get("requestId").cloned() else {
+                emit_error("FreeCAD tool result did not include a request id.");
+                return true;
+            };
+            let result = message.get("result").and_then(Value::as_str).unwrap_or("");
+            let success = message
+                .get("success")
+                .and_then(Value::as_bool)
+                .unwrap_or(false);
+            if let Err(error) = provider.send(&json!({
+                "id": request_id,
+                "result": {
+                    "contentItems": [{"type": "inputText", "text": result}],
+                    "success": success
+                }
+            })) {
+                emit_error(error);
+            }
+        }
+        "interrupt" => {
+            if let Some(provider) = provider
+                && let (Some(thread_id), Some(turn_id)) =
+                    (provider.thread_id.clone(), provider.turn_id.clone())
+                && let Err(error) = provider.request(
+                    "turn/interrupt",
+                    json!({"threadId": thread_id, "turnId": turn_id}),
+                )
+            {
+                emit_error(error);
+            }
+        }
+        "shutdown" => return false,
+        _ => emit_error(format!("Unknown runtime command: {command}")),
+    }
+    true
+}
+
+fn response_id(message: &Value) -> Option<u64> {
+    message.get("id").and_then(Value::as_u64)
+}
+
+fn handle_server_request(message: &Value, provider: &Provider) {
+    let method = message.get("method").and_then(Value::as_str).unwrap_or("");
+    let request_id = message.get("id").cloned().unwrap_or(Value::Null);
+    if method != "item/tool/call" {
+        let _ = provider.send(&json!({
+            "id": request_id,
+            "error": {
+                "code": -32601,
+                "message": format!("Anthracite does not handle server request {method}.")
+            }
+        }));
+        emit_error(format!("Codex requested unsupported interaction: {method}"));
+        return;
+    }
+
+    let params = message.get("params").cloned().unwrap_or_else(|| json!({}));
+    let tool = params.get("tool").and_then(Value::as_str).unwrap_or("");
+    let code = params
+        .pointer("/arguments/code")
+        .and_then(Value::as_str)
+        .unwrap_or("");
+    if tool != "freecad" || code.is_empty() {
+        let _ = provider.send(&json!({
+            "id": request_id,
+            "result": {
+                "contentItems": [{
+                    "type": "inputText",
+                    "text": "The FreeCAD tool requires a non-empty code string."
+                }],
+                "success": false
+            }
+        }));
+        return;
+    }
+
+    emit(json!({
+        "type": "tool_call",
+        "requestId": request_id,
+        "code": code
+    }));
+}
+
+fn handle_notification(message: &Value, provider: &mut Provider) {
+    let method = message.get("method").and_then(Value::as_str).unwrap_or("");
+    let params = message.get("params").unwrap_or(&Value::Null);
+    match method {
+        "turn/started" => {
+            provider.turn_id = params
+                .pointer("/turn/id")
+                .and_then(Value::as_str)
+                .map(str::to_owned);
+        }
+        "item/agentMessage/delta" => {
+            if let Some(delta) = params.get("delta").and_then(Value::as_str) {
+                emit(json!({"type": "assistant_delta", "text": delta}));
+            }
+        }
+        "item/started" => {
+            let item = params.get("item").unwrap_or(&Value::Null);
+            match item.get("type").and_then(Value::as_str) {
+                Some("dynamicToolCall") => {
+                    emit(json!({"type": "activity", "text": "Codex called freecad"}));
+                }
+                Some("commandExecution") => {
+                    emit(json!({"type": "activity", "text": "Codex is running a command"}));
+                }
+                _ => {}
+            }
+        }
+        "turn/completed" => {
+            let status = params
+                .pointer("/turn/status")
+                .and_then(Value::as_str)
+                .unwrap_or("completed");
+            provider.turn_id = None;
+            emit(json!({"type": "turn_completed", "status": status}));
+        }
+        "error" => {
+            let text = params
+                .pointer("/error/message")
+                .or_else(|| params.get("message"))
+                .and_then(Value::as_str)
+                .unwrap_or("Codex reported an unknown error.");
+            emit_error(text);
+        }
+        _ => {}
+    }
+}
+
+fn handle_server_message(message: Value, provider: &mut Provider, cwd: &str) {
+    if message.get("method").is_some() && message.get("id").is_some() {
+        handle_server_request(&message, provider);
+        return;
+    }
+    if message.get("method").is_some() {
+        handle_notification(&message, provider);
+        return;
+    }
+    if let Some(error) = message.pointer("/error/message").and_then(Value::as_str) {
+        emit_error(format!("Codex protocol error: {error}"));
+        return;
+    }
+
+    match response_id(&message) {
+        Some(INITIALIZE_ID) => {
+            if let Err(error) = provider.send(&json!({"method": "initialized"})) {
+                emit_error(error);
+                return;
+            }
+            if let Err(error) = thread_start(provider, cwd) {
+                emit_error(error);
+            }
+        }
+        Some(THREAD_START_ID) => {
+            provider.thread_id = message
+                .pointer("/result/thread/id")
+                .and_then(Value::as_str)
+                .map(str::to_owned);
+            if let Some(thread_id) = &provider.thread_id {
+                emit(json!({"type": "ready", "threadId": thread_id}));
+            } else {
+                emit_error("Codex thread/start response did not include a thread id.");
+            }
+        }
+        Some(_) => {
+            if let Some(turn_id) = message
+                .pointer("/result/turn/id")
+                .and_then(Value::as_str)
+                .map(str::to_owned)
+            {
+                provider.turn_id = Some(turn_id);
+            }
+        }
+        None => emit_error("Codex returned an unrecognized protocol message."),
+    }
+}
+
+fn main() {
+    let (sender, receiver) = mpsc::channel();
+    let input_sender = sender.clone();
+    thread::spawn(move || {
+        for line in io::stdin().lock().lines() {
+            match line {
+                Ok(line) => {
+                    if input_sender.send(Event::HostLine(line)).is_err() {
+                        return;
+                    }
+                }
+                Err(error) => {
+                    let _ = input_sender.send(Event::ServerError(error.to_string()));
+                    return;
+                }
+            }
+        }
+        let _ = input_sender.send(Event::HostClosed);
+    });
+
+    let mut provider: Option<Provider> = None;
+    let mut cwd = String::from(".");
+    while let Ok(event) = receiver.recv() {
+        match event {
+            Event::HostLine(line) => match serde_json::from_str::<Value>(&line) {
+                Ok(message) => {
+                    if message.get("type").and_then(Value::as_str) == Some("start") {
+                        cwd = message
+                            .get("cwd")
+                            .and_then(Value::as_str)
+                            .unwrap_or(".")
+                            .to_owned();
+                    }
+                    if !handle_host_message(message, &mut provider, &sender) {
+                        break;
+                    }
+                }
+                Err(error) => emit_error(format!("Invalid host JSON: {error}")),
+            },
+            Event::HostClosed => break,
+            Event::ServerLine(line) => match serde_json::from_str::<Value>(&line) {
+                Ok(message) => {
+                    if let Some(provider) = &mut provider {
+                        handle_server_message(message, provider, &cwd);
+                    }
+                }
+                Err(error) => emit_error(format!("Invalid Codex JSON: {error}")),
+            },
+            Event::ServerError(line) => eprintln!("codex: {line}"),
+            Event::ServerClosed => {
+                emit_error("Codex app-server closed its output.");
+                provider = None;
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn response_ids_accept_integer_ids() {
+        assert_eq!(response_id(&json!({"id": 42, "result": {}})), Some(42));
+        assert_eq!(response_id(&json!({"id": "call", "result": {}})), None);
+    }
+
+    #[test]
+    fn dynamic_tool_code_has_the_expected_shape() {
+        let message = json!({
+            "method": "item/tool/call",
+            "id": 60,
+            "params": {
+                "tool": "freecad",
+                "arguments": {"code": "doc.recompute()"}
+            }
+        });
+        assert_eq!(
+            message
+                .pointer("/params/arguments/code")
+                .and_then(Value::as_str),
+            Some("doc.recompute()")
+        );
+    }
+}
