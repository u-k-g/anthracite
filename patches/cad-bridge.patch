+#!/usr/bin/env python3
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Stdio MCP server for the Anthracite FreeCAD bridge.
+
+Exposes one tool, ``freecad``, that runs ordinary FreeCAD Python inside a running
+FreeCAD GUI through the Anthracite bridge. This process is spawned by an MCP client
+and speaks the Model Context Protocol on stdin/stdout; it only forwards one command
+per call over a loopback socket to the FreeCAD process.
+
+The bridge must already be running. Connection details are read from the discovery
+file written by Anthracite ($XDG_STATE_HOME/anthracite/bridge.json by default), which
+can be overridden with ANTHRACITE_BRIDGE, --bridge, or ANTHRACITE_HOST/PORT/TOKEN.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import socket
+import sys
+import threading
+import time
+from pathlib import Path
+
+SERVER_NAME = "anthracite"
+SERVER_VERSION = "0.1.0"
+DEFAULT_PROTOCOL_VERSION = "2024-11-05"
+
+TOOL = {
+    "name": "freecad",
+    "description": (
+        "Run a complete FreeCAD Python program inside the running FreeCAD GUI through "
+        "Anthracite. App, FreeCAD, Gui, doc (the active document), and cad (an inspection "
+        "helper) are prebound. The whole program runs as one native transaction that "
+        "recomputes and validates before committing, or rolls back on failure, and returns "
+        "a structured observation. Discover APIs with cad.guide() and cad.api(); inspect "
+        "before editing; never guess face or edge indices after an edit."
+    ),
+    "inputSchema": {
+        "type": "object",
+        "properties": {
+            "code": {
+                "type": "string",
+                "description": "Complete ordinary FreeCAD Python source.",
+            }
+        },
+        "required": ["code"],
+        "additionalProperties": False,
+    },
+}
+
+INSTRUCTIONS = (
+    "Anthracite drives a running FreeCAD GUI through one checked tool. Send ordinary "
+    "FreeCAD Python; it runs as a single native transaction that recomputes, validates, "
+    "and then commits or rolls back. Inspect before editing with cad.tree(), "
+    "cad.inspect(), cad.diagnostics(), and cad.guide(). Read the observation: ok, revision, "
+    "editReceipt, verification, diagnostics, images, and nextActions. A successful recompute "
+    "is not proof of design correctness; schedule checks with cad.verify([...]) and report "
+    "only what you checked. Topology references expire whenever the revision changes, so "
+    "never reuse a guessed face or edge index after an edit. If a call's outcome is unknown, "
+    "inspect before retrying."
+)
+
+
+def state_directory() -> Path:
+    override = os.environ.get("XDG_STATE_HOME")
+    if override:
+        return Path(override) / "anthracite"
+    return Path.home() / ".local" / "state" / "anthracite"
+
+
+def default_discovery_path() -> Path:
+    return state_directory() / "bridge.json"
+
+
+class BridgeError(RuntimeError):
+    """Raised for connection and transport failures against the bridge."""
+
+
+class Bridge:
+    """Line-delimited JSON client to the Anthracite bridge, connected lazily."""
+
+    def __init__(self, host: str, port: int, token: str):
+        self._host = host
+        self._port = port
+        self._token = token
+        self._socket: socket.socket | None = None
+        self._reader = None
+        self._writer = None
+        self._lock = threading.Lock()
+        self._request_id = 0
+
+    def _connect(self) -> None:
+        try:
+            connection = socket.create_connection((self._host, self._port), timeout=30.0)
+        except OSError as error:
+            raise BridgeError(
+                "Anthracite bridge is not running. Open FreeCAD with Anthracite, "
+                f"then retry. ({error})"
+            ) from error
+        # CAD operations can legitimately run longer than the connect timeout; the
+        # session must block until the bridge answers rather than time out mid-call.
+        connection.settimeout(None)
+        connection.sendall(f"{self._token}\n".encode("utf-8"))
+        self._socket = connection
+        self._reader = connection.makefile("rb")
+        self._writer = connection.makefile("wb")
+
+    def close(self) -> None:
+        for stream in (self._reader, self._writer):
+            try:
+                stream is not None and stream.close()
+            except OSError:
+                pass
+        if self._socket is not None:
+            try:
+                self._socket.close()
+            except OSError:
+                pass
+        self._socket = None
+        self._reader = None
+        self._writer = None
+
+    def send(self, request_type: str, params: dict | None = None) -> dict:
+        with self._lock:
+            if self._socket is None:
+                self._connect()
+            self._request_id += 1
+            request = {"id": self._request_id, "type": request_type, "params": params or {}}
+            try:
+                assert self._writer is not None and self._reader is not None
+                self._writer.write(
+                    (json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8")
+                )
+                self._writer.flush()
+                line = self._reader.readline()
+            except OSError as error:
+                self.close()
+                raise BridgeError(
+                    f"Lost the connection to the Anthracite bridge: {error}"
+                ) from error
+            if not line:
+                self.close()
+                raise BridgeError(
+                    "The Anthracite bridge closed the connection. Is FreeCAD still running?"
+                )
+            try:
+                response = json.loads(line.decode("utf-8"))
+            except (ValueError, UnicodeDecodeError) as error:
+                self.close()
+                raise BridgeError(f"The Anthracite bridge returned invalid data: {error}") from error
+            if response.get("status") != "ok":
+                raise BridgeError(response.get("message") or "The Anthracite bridge rejected the call.")
+            return response
+
+
+def resolve_connection(args) -> tuple[str, int, str]:
+    path = Path(args.bridge).expanduser() if args.bridge else default_discovery_path()
+    host = args.host
+    port = args.port
+    token = args.token
+    if host is None or port is None or token is None:
+        try:
+            discovery = json.loads(path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            raise BridgeError(
+                f"No Anthracite bridge discovery file at {path}. Open FreeCAD with Anthracite running."
+            )
+        except (OSError, ValueError) as error:
+            raise BridgeError(f"Could not read the Anthracite bridge discovery file {path}: {error}")
+        host = host or discovery.get("host")
+        port = port if port is not None else discovery.get("port")
+        token = token or discovery.get("token")
+    if not host or not port or not token:
+        raise BridgeError(f"The Anthracite bridge discovery file {path} is incomplete.")
+    return host, int(port), token
+
+
+def image_content(data_url: str) -> dict | None:
+    if not isinstance(data_url, str) or not data_url.startswith("data:"):
+        return None
+    header, _, encoded = data_url.partition(",")
+    if not encoded:
+        return None
+    mime = header[len("data:") :].split(";", 1)[0] or "image/png"
+    if ";base64" not in header:
+        return None
+    return {"type": "image", "data": encoded, "mimeType": mime}
+
+
+def call_tool(bridge: Bridge, client: str, arguments: dict) -> dict:
+    code = arguments.get("code")
+    if not isinstance(code, str) or not code.strip():
+        return {
+            "content": [{"type": "text", "text": "The freecad tool needs a non-empty 'code' string."}],
+            "isError": True,
+        }
+    try:
+        response = bridge.send("execute", {"code": code, "client": client})
+    except BridgeError as error:
+        return {"content": [{"type": "text", "text": str(error)}], "isError": True}
+    result = response.get("result", {})
+    content: list[dict] = [
+        {"type": "text", "text": json.dumps(result, ensure_ascii=False, indent=2)}
+    ]
+    for data_url in response.get("images", []):
+        image = image_content(data_url)
+        if image is not None:
+            content.append(image)
+    return {"content": content, "isError": False}
+
+
+def error_response(request_id, code: int, message: str) -> dict:
+    return {"jsonrpc": "2.0", "id": request_id, "error": {"code": code, "message": message}}
+
+
+def handle_message(message: dict, bridge: Bridge, client: str) -> dict | None:
+    method = message.get("method")
+    request_id = message.get("id")
+    is_notification = "id" not in message or request_id is None
+
+    if method == "initialize":
+        requested = message.get("params", {}).get("protocolVersion")
+        return {
+            "jsonrpc": "2.0",
+            "id": request_id,
+            "result": {
+                "protocolVersion": requested if isinstance(requested, str) else DEFAULT_PROTOCOL_VERSION,
+                "capabilities": {"tools": {}},
+                "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
+                "instructions": INSTRUCTIONS,
+            },
+        }
+    if method in ("notifications/initialized", "initialized"):
+        return None
+    if method == "ping":
+        return {"jsonrpc": "2.0", "id": request_id, "result": {}}
+    if method == "tools/list":
+        return {"jsonrpc": "2.0", "id": request_id, "result": {"tools": [TOOL]}}
+    if method == "tools/call":
+        params = message.get("params", {})
+        if params.get("name") != TOOL["name"]:
+            if is_notification:
+                return None
+            return error_response(request_id, -32602, f"Unknown tool: {params.get('name')!r}")
+        result = call_tool(bridge, client, params.get("arguments") or {})
+        return {"jsonrpc": "2.0", "id": request_id, "result": result}
+    if is_notification:
+        return None
+    return error_response(request_id, -32601, f"Method not found: {method}")
+
+
+def write_message(message: dict) -> None:
+    sys.stdout.write(json.dumps(message, ensure_ascii=False) + "\n")
+    sys.stdout.flush()
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument("--bridge", default=None)
+    parser.add_argument("--host", default=None)
+    parser.add_argument("--port", type=int, default=None)
+    parser.add_argument("--token", default=None)
+    parser.add_argument("--client", default=os.environ.get("ANTHRACITE_CLIENT", "agent"))
+    args, unknown = parser.parse_known_args(argv)
+    if unknown:
+        print(f"anthracite-mcp: ignoring unrecognized arguments: {unknown}", file=sys.stderr)
+
+    try:
+        host, port, token = resolve_connection(args)
+    except BridgeError as error:
+        print(f"anthracite-mcp: {error}", file=sys.stderr)
+        # Serve an explicit error on the MCP stream so the client can surface it.
+        for line in sys.stdin:
+            try:
+                message = json.loads(line)
+            except ValueError:
+                continue
+            if message.get("method") == "initialize":
+                write_message(
+                    {
+                        "jsonrpc": "2.0",
+                        "id": message.get("id"),
+                        "result": {
+                            "protocolVersion": DEFAULT_PROTOCOL_VERSION,
+                            "capabilities": {"tools": {}},
+                            "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
+                            "instructions": str(error),
+                        },
+                    }
+                )
+            elif message.get("method") == "tools/list":
+                write_message({"jsonrpc": "2.0", "id": message.get("id"), "result": {"tools": [TOOL]}})
+            elif message.get("method") == "tools/call" and "id" in message:
+                write_message(
+                    {
+                        "jsonrpc": "2.0",
+                        "id": message.get("id"),
+                        "result": {
+                            "content": [{"type": "text", "text": str(error)}],
+                            "isError": True,
+                        },
+                    }
+                )
+            elif message.get("method") == "ping":
+                write_message({"jsonrpc": "2.0", "id": message.get("id"), "result": {}})
+        return 1
+
+    bridge = Bridge(host, port, token)
+    try:
+        for line in sys.stdin:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                message = json.loads(line)
+            except ValueError:
+                write_message(error_response(None, -32700, "Parse error"))
+                continue
+            response = handle_message(message, bridge, args.client)
+            if response is not None:
+                write_message(response)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        bridge.close()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
