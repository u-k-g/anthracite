QToolBar { spacing: 2px; padding: 1px; }
QToolBar::separator { width: 6px; height: 6px; }
QToolBar QToolButton { padding: 3px; margin: 0px; }
QStatusBar { padding: 0px 4px; min-height: 24px; border-top: 1px solid palette(mid); }
QStatusBar::item { border: none; }
QStatusBar QPushButton { padding: 2px 6px; border: none; }
QPushButton#AnthraciteConsolePreview { text-align: left; color: palette(text); }
QPushButton#AnthraciteConsolePreview:hover,
QPushButton#AnthraciteConsolePreview[consoleOpen="true"] { background: palette(alternate-base); }
QTabBar#AnthraciteWorkbenchTabs::tab { min-width: 18px; padding: 4px 6px; margin: 0px; border: none; }
QTabBar#AnthraciteWorkbenchTabs::tab:selected { background: palette(alternate-base); border-bottom: 2px solid #A06666; }
QTabBar#AnthraciteWorkbenchTabs::tab:hover { background: palette(mid); }
QWidget#AnthraciteConsoleNavigation QToolButton:checked { border-bottom: 2px solid #A06666; }
QTreeWidget#AnthraciteNotifications { border: none; }
