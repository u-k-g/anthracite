QMainWindow, QMenuBar, QMenu, QToolBar, QDockWidget { background: palette(window); color: palette(window-text); }
QToolBar { border: none; spacing: 4px; padding: 1px; }
QToolBar::separator { width: 6px; height: 6px; }
QToolBar QToolButton { padding: 3px; margin: 0px; }
QStatusBar { background: palette(window); padding: 0px 4px; min-height: 30px; border-top: 1px solid palette(mid); }
QStatusBar::item { border: none; border-right: 1px solid palette(mid); }
QStatusBar QPushButton { padding: 2px 6px; border: none; }
QToolButton#AnthraciteConsolePreview { text-align: left; padding: 4px 8px; background: transparent; border: none; border-radius: 4px; }
QToolButton#AnthraciteConsolePreview:hover,
QToolButton#AnthraciteConsolePreview[consoleOpen="true"] { background: palette(mid); }
QToolBar#AnthraciteTools { padding: 1px; }
QTabBar#AnthraciteWorkbenchTabs::tab:selected { color: palette(window-text); border-bottom: 2px solid palette(highlight); }
QTabBar#AnthraciteWorkbenchTabs::tab:!selected { border-bottom: 2px solid transparent; }
QWidget#AnthraciteConsoleNavigation { border-right: 1px solid palette(mid); }
QWidget#AnthraciteConsoleNavigation QPushButton { text-align: left; padding: 6px; background: transparent; border: none; border-radius: 4px; }
QWidget#AnthraciteConsoleNavigation QPushButton:hover { background: palette(alternate-base); }
QWidget#AnthraciteConsoleNavigation QPushButton:checked { background: palette(highlight); color: palette(window-text); }
QPlainTextEdit#AnthraciteNotifications { background: palette(window); color: palette(window-text); border: none; padding: 8px; }
